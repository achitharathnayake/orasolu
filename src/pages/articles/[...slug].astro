---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const articles = await getCollection("articles", ({ data }) => {
    return !data.draft;
  });

  return articles.map((article) => ({
    params: {
      slug: article.id,
    },
    props: {
      article,
    },
  }));
}

const { article } = Astro.props;

const { Content } = await render(article);

const formattedDate = article.data.publishedDate.toLocaleDateString(
  "en-US",
  {
    year: "numeric",
    month: "long",
    day: "numeric",
  }
);
---

<BaseLayout>
  <section class="article-hero">
    <div class="container article-hero__inner">
      <div class="eyebrow">{article.data.category}</div>

      <h1>{article.data.title}</h1>

      <p class="article-hero__description">
        {article.data.description}
      </p>

      <div class="article-meta">
        <span class="article-meta__author">
          {article.data.author}
        </span>

        <span class="article-meta__separator">·</span>

        <span class="article-meta__date">
          {formattedDate}
        </span>
      </div>
    </div>
  </section>

  <article class="article-content">
    <div class="container article-content__layout">
      <main class="article-body">
        <Content />
      </main>

      <aside class="article-sidebar">
        <div class="article-sidebar__card">
          <div class="eyebrow">ORASOLU</div>

          <h3>Technical knowledge for real-world work.</h3>

          <p>
            Articles, tools, experiments and lessons learned across
            databases, cloud, infrastructure, automation and enterprise
            technology.
          </p>

          <a href="/articles/" class="button button--secondary">
            ← All Articles
          </a>
        </div>
      </aside>
    </div>
  </article>
</BaseLayout>

<style>
  .article-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.55rem;
  }

  .article-meta__separator {
    opacity: 0.45;
  }

  .article-content {
    padding: 2rem 0 5rem;
  }

  .article-content__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 280px;
    gap: 4rem;
    align-items: start;
  }

  .article-body {
    min-width: 0;
    max-width: 820px;
  }

  .article-body :global(h2) {
    margin-top: 3rem;
    margin-bottom: 1rem;
  }

  .article-body :global(h3) {
    margin-top: 2rem;
    margin-bottom: 0.8rem;
  }

  .article-body :global(p) {
    line-height: 1.85;
  }

  .article-body :global(ul),
  .article-body :global(ol) {
    line-height: 1.8;
  }

  .article-body :global(pre) {
    margin: 1.75rem 0;
    padding: 1.25rem;
    overflow-x: auto;
    border-radius: 10px;
  }

  .article-body :global(code) {
    font-family:
      "Cascadia Code",
      "SFMono-Regular",
      Consolas,
      "Liberation Mono",
      monospace;
  }

  .article-sidebar {
    position: sticky;
    top: 7rem;
  }

  .article-sidebar__card {
    padding: 1.5rem;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--soft);
  }

  .article-sidebar__card h3 {
    margin: 0.5rem 0 0.75rem;
  }

  .article-sidebar__card p {
    margin-bottom: 1.25rem;
    line-height: 1.7;
  }

  @media (max-width: 900px) {
    .article-content__layout {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .article-sidebar {
      position: static;
    }
  }

  @media (max-width: 640px) {
    .article-content {
      padding: 1.5rem 0 4rem;
    }

    .article-meta {
      gap: 0.4rem;
      font-size: 0.92rem;
    }
  }
</style>