---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const articles = await getCollection("articles", ({ data }) => {
    return !data.draft;
  });

  return articles.map((article) => ({
    params: {
      slug: article.id,
    },
    props: {
      article,
    },
  }));
}

const { article } = Astro.props;

const { Content, headings } = await render(article);
const allArticles = await getCollection("articles", ({ data }) => {
  return !data.draft;
});

const currentTags = article.data.tags || [];

const sortedArticles = [...allArticles].sort(
  (a, b) =>
    b.data.publishedDate.getTime() - a.data.publishedDate.getTime()
);

const currentIndex = sortedArticles.findIndex(
  (item) => item.id === article.id
);

const previousArticle =
  currentIndex >= 0 && currentIndex < sortedArticles.length - 1
    ? sortedArticles[currentIndex + 1]
    : null;

const nextArticle =
  currentIndex > 0
    ? sortedArticles[currentIndex - 1]
    : null;
const relatedArticles = allArticles
  .filter((item) => item.id !== article.id)
  .map((item) => {
    const sharedTags = (item.data.tags || []).filter((tag) =>
      currentTags.includes(tag)
    );

    const sameCategory = item.data.category === article.data.category;

    return {
      article: item,
      score: sharedTags.length + (sameCategory ? 2 : 0),
    };
  })
  .filter((item) => item.score > 0)
  .sort((a, b) => b.score - a.score)
  .slice(0, 3);


const articleText = JSON.stringify(article.body || "")
  .replace(/\s+/g, " ")
  .trim();

const wordCount = articleText
  ? articleText.split(/\s+/).length
  : 0;

const readingTime = Math.max(1, Math.ceil(wordCount / 200));
const formattedDate = article.data.publishedDate.toLocaleDateString(
  "en-US",
  {
    year: "numeric",
    month: "long",
    day: "numeric",
  }
);
---

<BaseLayout>
  <section class="article-hero">
    <div class="container article-hero__inner">
      <div class="eyebrow">{article.data.category}</div>

      <h1>{article.data.title}</h1>

      <p class="article-hero__description">
        {article.data.description}
      </p>

      <div class="article-meta">
        <span class="article-meta__author">
          {article.data.author}
        </span>

        <span class="article-meta__separator">&middot;</span>

        <span class="article-meta__date">
          {formattedDate}
        </span>
        <span class="article-meta__separator">&middot;</span>

        <span class="article-meta__reading-time">
          {readingTime} min read
        </span>
      </div>
    </div>
  </section>

  <article class="article-content">
    <div class="container article-content__layout">
      <main class="article-body">
        <Content />
      </main>

      {(previousArticle || nextArticle) && (
        <nav class="article-navigation" aria-label="Article navigation">
          {previousArticle ? (
            <a
              class="article-navigation__link article-navigation__link--previous"
              href={`/articles/${previousArticle.id.replace(/\.md$/, "")}/`}
            >
              <span class="article-navigation__label">Previous Article</span>
              <strong>{previousArticle.data.title}</strong>
            </a>
          ) : (
            <div></div>
          )}

          {nextArticle ? (
            <a
              class="article-navigation__link article-navigation__link--next"
              href={`/articles/${nextArticle.id.replace(/\.md$/, "")}/`}
            >
              <span class="article-navigation__label">Next Article</span>
              <strong>{nextArticle.data.title}</strong>
            </a>
          ) : (
            <div></div>
          )}
        </nav>
      )}
      <aside class="article-sidebar">
        {headings.length > 0 && (
          <nav class="article-toc" aria-label="Table of contents">
            <div class="article-toc__eyebrow">ON THIS PAGE</div>

            <ul class="article-toc__list">
              {headings.map((heading) => (
                <li class:list={{ "article-toc__item--sub": heading.depth > 2 }}>
                  <a href={`#${heading.slug}`}>
                    {heading.text}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )}
        <div class="article-sidebar__card">
          <div class="eyebrow">ORASOLU</div>

          <h3>Technical knowledge for real-world work.</h3>

          <p>
            Articles, tools, experiments and lessons learned across
            databases, cloud, infrastructure, automation and enterprise
            technology.
          </p>

          <a href="/articles/" class="button button--secondary">
            &larr; All Articles
          </a>
        </div>
      </aside>
    </div>
  </article>
<script>
  document.querySelectorAll(".article-body pre").forEach((pre) => {
    const button = document.createElement("button");

    button.type = "button";
    button.className = "code-copy-button";
    button.textContent = "Copy";

    pre.style.position = "relative";

    button.style.position = "absolute";
    button.style.top = "10px";
    button.style.right = "10px";
    button.style.padding = "5px 9px";
    button.style.border = "1px solid #d1d5db";
    button.style.borderRadius = "5px";
    button.style.background = "#ffffff";
    button.style.color = "#374151";
    button.style.fontFamily = "inherit";
    button.style.fontSize = "0.75rem";
    button.style.cursor = "pointer";
    button.style.zIndex = "2";
    button.setAttribute("aria-label", "Copy code");

    button.addEventListener("click", async () => {
      const code = pre.querySelector("code");

      if (!code) {
        return;
      }

      try {
        await navigator.clipboard.writeText(code.textContent || "");

        button.textContent = "Copied";

        window.setTimeout(() => {
          button.textContent = "Copy";
        }, 1500);
      } catch {
        button.textContent = "Copy failed";

        window.setTimeout(() => {
          button.textContent = "Copy";
        }, 1500);
      }
    });

    pre.appendChild(button);
  });
</script>
</BaseLayout>

<style>
  .article-hero {
    padding-top: 4.5rem;
  }

  .article-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.55rem;
  }

  .article-meta__separator {
    opacity: 0.45;
  }

  .article-content {
    padding: 2rem 0 5rem;
  }

  .article-content__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 280px;
    gap: 4rem;
    align-items: start;
  }

  .article-body {
    grid-column: 1;
    grid-row: 1;
    min-width: 0;
    max-width: 820px;
  }

  .article-body :global(h2) {
    margin-top: 3rem;
    margin-bottom: 1rem;
  }

  .article-body :global(h3) {
    margin-top: 2rem;
    margin-bottom: 0.8rem;
  }

  .article-body :global(p) {
    line-height: 1.85;
  }

  .article-body :global(ul),
  .article-body :global(ol) {
    line-height: 1.8;
  }

  .article-body :global(pre) {
    position: relative;
    margin: 1.75rem 0;
    padding: 1.25rem;
    overflow-x: auto;
    border-radius: 10px;
  }

  :global(.article-body pre) .code-copy-button {
    position: absolute;
    top: 10px;
    right: 10px;
    padding: 5px 9px;
    border: 1px solid #d1d5db;
    border-radius: 5px;
    background: #ffffff;
    color: #374151;
    font-family: inherit;
    font-size: 0.75rem;
    cursor: pointer;
    opacity: 0.9;
  }

  :global(.article-body pre) .code-copy-button:hover {
    opacity: 1;
    color: #e85d04;
  }

  .article-body :global(code) {
    font-family:
      "Cascadia Code",
      "SFMono-Regular",
      Consolas,
      "Liberation Mono",
      monospace;
  }

  .related-articles {
    margin-top: 4rem;
    padding-top: 3rem;
    border-top: 1px solid #e5e7eb;
  }

  .related-articles__header {
    margin-bottom: 1.5rem;
  }

  .related-articles__header .eyebrow {
    margin-bottom: 0.5rem;
  }

  .related-articles__header h2 {
    margin: 0;
    font-size: clamp(34px, 4vw, 48px);
    line-height: 1.2;
  }

  .related-articles__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .related-article {
    display: block;
    padding: 1.25rem;
    border: 1px solid #e5e7eb;
    border-radius: 0.75rem;
    background: #ffffff;
    color: inherit;
    text-decoration: none;
    transition:
      border-color 0.2s ease,
      transform 0.2s ease;
  }

  .related-article:hover {
    border-color: #f56a00;
    transform: translateY(-2px);
  }

  .related-article__category {
    display: block;
    margin-bottom: 0.65rem;
    color: #f56a00;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .related-article h3 {
    margin: 0 0 0.65rem;
    font-size: 21px;
    line-height: 1.4;
  }

  .related-article p {
    margin: 0;
    color: #6b7280;
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .article-navigation {
    grid-column: 1;
    grid-row: 2;
  }

  .article-sidebar {
    grid-column: 2;
    grid-row: 1 / span 2;
    position: sticky;
    top: 7rem;
  }

  .article-toc {
    margin-bottom: 1.5rem;
    padding: 1.25rem;
    border: 1px solid #e5e7eb;
    border-radius: 0.75rem;
    background: #ffffff;
  }

  .article-toc__eyebrow {
    margin-bottom: 0.85rem;
    color: #6b7280;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .article-toc__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .article-toc__list li {
    margin: 0;
  }

  .article-toc__list a {
    display: block;
    padding: 0.35rem 0;
    color: #374151;
    font-size: 0.9rem;
    line-height: 1.45;
    text-decoration: none;
  }

  .article-toc__list a:hover {
    color: #e85d04;
  }

  .article-toc__item--sub {
    padding-left: 0.85rem;
  }

  .article-sidebar__card {
    padding: 1.5rem;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--soft);
  }

  .article-sidebar__card .button--secondary {
    color: var(--orange);
    background: #fff3ed;
    border-color: #ffd5c2;
  }

  .article-sidebar__card .button--secondary:hover {
    color: #fff;
    background: var(--orange);
    border-color: var(--orange);
  }

  .article-sidebar__card h3 {
    margin: 0.5rem 0 0.75rem;
  }

  .article-sidebar__card p {
    margin-bottom: 1.25rem;
    line-height: 1.7;
  }

  @media (max-width: 900px) {
    .related-articles__grid {
      grid-template-columns: 1fr;
    }

    .article-content__layout {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .related-articles {
    margin-top: 4rem;
    padding-top: 3rem;
    border-top: 1px solid #e5e7eb;
  }

  .related-articles__header {
    margin-bottom: 1.5rem;
  }

  .related-articles__header .eyebrow {
    margin-bottom: 0.5rem;
  }

  .related-articles__header h2 {
    margin: 0;
    font-size: clamp(34px, 4vw, 48px);
    line-height: 1.2;
  }

  .related-articles__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .related-article {
    display: block;
    padding: 1.25rem;
    border: 1px solid #e5e7eb;
    border-radius: 0.75rem;
    background: #ffffff;
    color: inherit;
    text-decoration: none;
    transition:
      border-color 0.2s ease,
      transform 0.2s ease;
  }

  .related-article:hover {
    border-color: #f56a00;
    transform: translateY(-2px);
  }

  .related-article__category {
    display: block;
    margin-bottom: 0.65rem;
    color: #f56a00;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .related-article h3 {
    margin: 0 0 0.65rem;
    font-size: 21px;
    line-height: 1.4;
  }

  .related-article p {
    margin: 0;
    color: #6b7280;
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .article-sidebar {
      position: static;
    }
  }

  @media (max-width: 640px) {
    .article-content {
      padding: 1.5rem 0 4rem;
    }

    .article-meta {
      gap: 0.4rem;
      font-size: 0.92rem;
    }
  }
</style>
