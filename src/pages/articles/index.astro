---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const allArticles = await getCollection("articles", ({ data }) => {
 return !data.draft;
});

const articles = allArticles.sort(
 (a, b) =>
 b.data.publishedDate.valueOf() - a.data.publishedDate.valueOf()
);

const categories = [
 "All",
 ...Array.from(
 new Set(
 articles.map((article) => article.data.category)
 )
 ),
];
---

<BaseLayout>
 <section class="page-hero">
 <div class="container">
 <div class="eyebrow">ORASOLU ARTICLES</div>

 <h1>
 Oracle Database
 <span>Knowledge</span>
 </h1>

 <p>
 Practical knowledge, technical solutions and lessons learned across
 Oracle Database, cloud, infrastructure, automation and related
 technologies.
 </p>
 </div>
 </section>

 <section class="section articles-section">
 <div class="container">

 <div class="section-heading">
 <div>
 <div class="eyebrow">LATEST</div>

 <h2>From the ORASOLU knowledge base</h2>

 <p>
 Articles based on real-world experience, technical investigations,
 migrations, troubleshooting and practical solutions.
 </p>
 </div>
 </div>

 {
 categories.length > 1 && (
 <div class="article-filters">
 {categories.map((category, index) => (
 <button
 type="button"
 class:list={[
 "article-filter",
 {
 "article-filter--active": index === 0,
 },
 ]}
 data-category={category}
 >
 {category}
 </button>
 ))}
 </div>
 )
 }

 <div class="articles-grid">
 {
 articles.map((article) => {
 const image =
 article.data.image ||
 "/images/orasolu-hero.png";

 return (
 <article
 class="article-card"
 data-article-category={article.data.category}
 >
 <a
 href={`/articles/${article.id}/`}
 class="article-card__image-link"
 >
 <img
 src={image}
 alt={article.data.title}
 class="article-card__image"
 loading="lazy"
 />
 </a>

 <div class="article-card__body">

 <div class="article-card__meta">
 <span class="article-card__category">
 {article.data.category}
 </span>

 {article.data.tags.length > 0 && (
 <>
 <span class="article-card__dot">·</span>

 <span>
 {article.data.tags[0]}
 </span>
 </>
 )}
 </div>

 <h3>
 <a href={`/articles/${article.id}/`}>
 {article.data.title}
 </a>
 </h3>

 <p>
 {article.data.description}
 </p>

 <div class="article-card__footer">
 <span>
 {article.data.publishedDate.toLocaleDateString(
 "en-US",
 {
 year: "numeric",
 month: "short",
 day: "numeric",
 }
 )}
 </span>

 <a
 href={`/articles/${article.id}/`}
 class="article-card__read"
 >
 Read Article
 </a>
 </div>

 </div>
 </article>
 );
 })
 }
 </div>

 {
 articles.length === 0 && (
 <div class="empty-state">
 <h3>No articles yet.</h3>

 <p>
 Articles will appear here once they are published.
 </p>
 </div>
 )
 }

 </div>
 </section>

 <section class="section section--soft">
 <div class="container">
 <div class="article-future">
 <div class="eyebrow">MORE TO COME</div>

 <h2>Building the knowledge base.</h2>

 <p>
 ORASOLU will gradually grow with articles covering database
 administration, architecture, performance, migrations, high
 availability, cloud, automation, infrastructure and other areas of
 practical technology work.
 </p>
 </div>
 </div>
 </section>
</BaseLayout>

<script>
 const filters =
 document.querySelectorAll<HTMLButtonElement>(
 ".article-filter"
 );

 const cards =
 document.querySelectorAll<HTMLElement>(
 "[data-article-category]"
 );

 filters.forEach((filter) => {
 filter.addEventListener("click", () => {
 const selectedCategory =
 filter.dataset.category || "All";

 filters.forEach((item) => {
 item.classList.remove(
 "article-filter--active"
 );
 });

 filter.classList.add(
 "article-filter--active"
 );

 cards.forEach((card) => {
 const category =
 card.dataset.articleCategory;

 if (
 selectedCategory === "All" ||
 category === selectedCategory
 ) {
 card.style.display = "";
 } else {
 card.style.display = "none";
 }
 });
 });
 });
</script>

<style>
 /* --------------------------------
 Articles section
 -------------------------------- */

 .articles-section {
 padding-top: 5.5rem;
 padding-bottom: 6rem;
 }

 .articles-section .section-heading {
 margin-bottom: 1.75rem;
 }

 /* --------------------------------
 Category filters
 -------------------------------- */

 .article-filters {
 display: flex;
 align-items: center;
 flex-wrap: wrap;
 gap: 0.6rem;
 margin-bottom: 2rem;
 }

 .article-filter {
 appearance: none;
 border: 1px solid var(--line);
 background: #ffffff;
 color: var(--ink);
 padding: 0.55rem 1rem;
 border-radius: 999px;
 font-family: inherit;
 font-size: 0.88rem;
 font-weight: 600;
 cursor: pointer;
 transition:
 background 0.2s ease,
 color 0.2s ease,
 border-color 0.2s ease,
 transform 0.2s ease;
 }

 .article-filter:hover {
 border-color: var(--orange);
 color: var(--orange);
 transform: translateY(-1px);
 }

 .article-filter--active {
 background: var(--orange);
 border-color: var(--orange);
 color: #ffffff;
 }

 .article-filter--active:hover {
 background: var(--orange);
 border-color: var(--orange);
 color: #ffffff;
 }

 /* --------------------------------
 Article grid
 -------------------------------- */

 .articles-grid {
 display: grid;
 grid-template-columns:
 repeat(3, minmax(0, 1fr));
 gap: 1.75rem;
 }

 /* --------------------------------
 Article card
 -------------------------------- */

 .article-card {
 display: flex;
 flex-direction: column;
 min-width: 0;
 overflow: hidden;
 background: #ffffff;
 border: 1px solid var(--line);
 border-radius: 16px;
 transition:
 transform 0.25s ease,
 box-shadow 0.25s ease,
 border-color 0.25s ease;
 }

 .article-card:hover {
 transform: translateY(-4px);
 border-color: #d9dde5;
 box-shadow:
 0 12px 30px rgba(17, 29, 44, 0.08);
 }

 .article-card__image-link {
 display: block;
 overflow: hidden;
 aspect-ratio: 16 / 9;
 background: var(--soft);
 }

 .article-card__image {
 display: block;
 width: 100%;
 height: 100%;
 object-fit: cover;
 transition: transform 0.35s ease;
 }

 .article-card:hover .article-card__image {
 transform: scale(1.03);
 }

 .article-card__body {
 display: flex;
 flex: 1;
 flex-direction: column;
 padding: 1.4rem 1.45rem 1.35rem;
 }

 /* --------------------------------
 Card metadata
 -------------------------------- */

 .article-card__meta {
 display: flex;
 align-items: center;
 flex-wrap: wrap;
 gap: 0.45rem;
 margin-bottom: 0.65rem;
 color: var(--muted);
 font-size: 0.78rem;
 font-weight: 600;
 }

 .article-card__category {
 color: var(--orange);
 text-transform: uppercase;
 letter-spacing: 0.04em;
 }

 .article-card__dot {
 opacity: 0.45;
 }

 /* --------------------------------
 Card title
 -------------------------------- */

 .article-card h3 {
 margin: 0 0 0.7rem;
 font-size: 1.25rem;
 line-height: 1.3;
 }

 .article-card h3 a {
 color: var(--ink);
 text-decoration: none;
 }

 .article-card h3 a:hover {
 color: var(--orange);
 }

 /* --------------------------------
 Card description
 -------------------------------- */

 .article-card p {
 margin: 0;
 color: var(--muted);
 font-size: 0.95rem;
 line-height: 1.7;
 }

 /* --------------------------------
 Card footer
 -------------------------------- */

 .article-card__footer {
 display: flex;
 align-items: center;
 justify-content: space-between;
 gap: 1rem;
 margin-top: auto;
 padding-top: 1.35rem;
 color: var(--muted);
 font-size: 0.8rem;
 }

 .article-card__read {
 display: inline-flex;
 align-items: center;
 gap: 0.35rem;
 color: var(--ink);
 font-weight: 700;
 text-decoration: none;
 white-space: nowrap;
 }

 .article-card__read:hover {
 color: var(--orange);
 }

 .article-card__read span {
 font-size: 1rem;
 transition: transform 0.2s ease;
 }

 .article-card__read:hover span {
 transform: translateX(3px);
 }

 /* --------------------------------
 Empty state
 -------------------------------- */

 .empty-state {
 padding: 4rem 2rem;
 text-align: center;
 border: 1px dashed var(--line);
 border-radius: 16px;
 background: var(--soft);
 }

 .empty-state h3 {
 margin-bottom: 0.5rem;
 }

 .empty-state p {
 margin: 0;
 color: var(--muted);
 }

 /* --------------------------------
 Future content section
 -------------------------------- */

 .article-future {
 max-width: 760px;
 }

 .article-future h2 {
 margin: 0.4rem 0 0.8rem;
 }

 .article-future p {
 margin: 0;
 color: var(--muted);
 line-height: 1.8;
 }

 /* --------------------------------
 Tablet
 -------------------------------- */

 @media (max-width: 1000px) {
 .articles-grid {
 grid-template-columns:
 repeat(2, minmax(0, 1fr));
 }
 }

 /* --------------------------------
 Mobile
 -------------------------------- */

 @media (max-width: 640px) {
 .articles-section {
 padding-top: 3.5rem;
 padding-bottom: 4rem;
 }

 .articles-grid {
 grid-template-columns: 1fr;
 gap: 1.25rem;
 }

 .article-card__body {
 padding: 1.25rem;
 }

 .article-card h3 {
 font-size: 1.15rem;
 }

 .article-card__footer {
 align-items: flex-start;
 flex-direction: column;
 gap: 0.6rem;
 }

 .article-filters {
 margin-bottom: 1.5rem;
 }
 }
</style>