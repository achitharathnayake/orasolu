---
import BaseLayout from "../../../../layouts/BaseLayout.astro";

const sqlBlocks = [
  {
    label: "01 · PLATFORMS",
    title: "Review database platform",
    description: "Identify the source database platform and endian format before planning a cross-platform move.",
    sql: `SELECT
    platform_name,
    endian_format
FROM v$database
ORDER BY platform_name;`,
  },
  {
    label: "02 · SUPPORTED PLATFORMS",
    title: "Review transport platforms",
    description: "Review platforms supported for cross-platform tablespace transport.",
    sql: `SELECT
    platform_id,
    platform_name,
    endian_format
FROM v$transportable_platform
ORDER BY platform_id;`,
  },
  {
    label: "03 · DATAFILES",
    title: "Review source datafiles",
    description: "Measure datafiles that will participate in the cross-platform migration.",
    sql: `SELECT
    tablespace_name,
    file_name,
    ROUND(bytes / 1024 / 1024, 2) AS size_mb,
    autoextensible,
    status
FROM dba_data_files
ORDER BY tablespace_name, file_name;`,
  },
  {
    label: "04 · TABLESPACES",
    title: "Review transport candidates",
    description: "Review tablespace status and contents before selecting the transport set.",
    sql: `SELECT
    tablespace_name,
    status,
    contents,
    logging
FROM dba_tablespaces
WHERE contents = 'PERMANENT'
ORDER BY tablespace_name;`,
  },
  {
    label: "05 · FILE CONVERSION",
    title: "Review file conversion settings",
    description: "Review initialization parameters that may affect cross-platform file conversion.",
    sql: `SELECT
    name,
    value
FROM v$parameter
WHERE name IN (
    'db_file_name_convert',
    'log_file_name_convert'
)
ORDER BY name;`,
  },
  {
    label: "06 · READINESS",
    title: "Review invalid objects",
    description: "Identify invalid objects before migration so post-migration validation has a clear baseline.",
    sql: `SELECT
    owner,
    object_type,
    COUNT(*) AS invalid_count
FROM dba_objects
WHERE status = 'INVALID'
GROUP BY owner, object_type
ORDER BY owner, object_type;`,
  },
];
---

<BaseLayout
  title="Cross-Platform Migration | ORASOLU"
  description="Practical Oracle SQL for cross-platform migration planning, platform compatibility, datafiles, transport candidates and migration readiness."
>
  <main>
    <section class="resource-hero">
      <div class="container">
        <p class="eyebrow">ORASOLU TOOLBOX · MIGRATION</p>
        <h1>Cross-Platform <span class="hero-accent">Migration</span></h1>
        <p>
          Practical Oracle SQL for cross-platform migration planning, platform compatibility,
          datafiles, transport candidates and migration readiness.
        </p>
      </div>
    </section>

    <section class="resource-section">
      <div class="container">
        <div class="resource-intro">
          <p class="eyebrow">ORASOLU TOOLBOX · MIGRATION</p>
          <h2>Check the platform before you move the database</h2>
          <p>
            Transportable tablespaces can simplify large database migrations, but the source
            environment should be understood before the transport operation begins. These
            queries help review candidate tablespaces, read-only status, datafiles,
            self-contained checks, transport-set violations and platform compatibility.
          </p>
        </div>

        <div class="resource-grid">
          {sqlBlocks.map((block) => (
            <article class="resource-block">
              <div class="resource-block__header">
                <div class="resource-block__label">{block.label}</div>
                <h2>{block.title}</h2>
              </div>

              <p class="resource-block__description">{block.description}</p>

              <pre><code>{block.sql}</code></pre>
            </article>
          ))}
        </div>

        <aside class="resource-note">
          <p class="eyebrow">ORASOLU TOOLBOX · MIGRATION</p>
          <h2>A transport set should be self-contained before export.</h2>
          <p>
            A transportable tablespace operation should begin with evidence about the
            candidate tablespaces, their datafiles, the transport set and the target platform.
          </p>
          <p>
            Run the transport set check before export and review the reported violations
            before moving the datafiles.
          </p>
        </aside>

        <div class="resource-actions">
          <a class="button button--primary" href="/tools/migration/">Back to Migration</a>
          <a class="resource-actions__link" href="/tools/migration/migration-validation/">Read Migration Validation</a>
        </div>
      </div>
    </section>
  </main>

  <script>
    document.querySelectorAll(".resource-block pre").forEach((pre) => {
      const button = document.createElement("button");
      button.type = "button";
      button.className = "resource-copy-button";
      button.textContent = "Copy";
      button.setAttribute("aria-label", "Copy SQL");
      pre.style.position = "relative";
      button.style.position = "absolute";
      button.style.top = "10px";
      button.style.right = "10px";
      button.style.padding = "5px 9px";
      button.style.border = "1px solid #d1d5db";
      button.style.borderRadius = "5px";
      button.style.background = "#ffffff";
      button.style.color = "#374151";
      button.style.fontFamily = "inherit";
      button.style.fontSize = "0.75rem";
      button.style.cursor = "pointer";
      button.style.zIndex = "2";

      button.addEventListener("click", async () => {
        const code = pre.querySelector("code");
        if (!code) return;

        try {
          await navigator.clipboard.writeText(code.textContent || "");
          button.textContent = "Copied";
          window.setTimeout(() => {
            button.textContent = "Copy";
          }, 1500);
        } catch {
          button.textContent = "Copy failed";
          window.setTimeout(() => {
            button.textContent = "Copy";
          }, 1500);
        }
      });

      pre.appendChild(button);
    });
  </script>

  <style>
    .resource-hero {
      padding-top: 72px;
      padding-bottom: 72px;
      border-bottom: 1px solid var(--line);
    }

    .resource-hero h1 {
      margin: 0 0 14px;
      color: var(--ink);
      font-size: clamp(42px, 6vw, 72px);
      line-height: 1.05;
      letter-spacing: -0.04em;
    }

    .resource-hero .hero-accent {
      color: var(--orange);
    }

    .resource-hero > .container > p:last-child {
      max-width: 900px;
      margin: 0;
      color: var(--muted);
      font-size: 17px;
      line-height: 1.75;
    }

    .resource-section {
      padding-top: 56px;
      padding-bottom: 72px;
    }

    .resource-intro {
      max-width: 820px;
      margin-bottom: 32px;
    }

    .resource-intro .eyebrow {
      margin: 0 0 14px;
      color: var(--orange);
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 0.14em;
      line-height: 1.2;
    }

    .resource-intro h2 {
      margin: 0 0 14px;
      color: var(--ink);
      font-size: clamp(28px, 3vw, 38px);
      line-height: 1.15;
    }

    .resource-intro p:not(.eyebrow) {
      margin: 0;
      color: var(--muted);
      font-size: 16px;
      line-height: 1.75;
    }

    .resource-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 22px;
      align-items: start;
    }

    .resource-block {
      display: flex;
      flex-direction: column;
      min-width: 0;
      height: 560px;
      box-sizing: border-box;
      margin: 0;
      padding: 30px;
      background: #ffffff;
      border: 1px solid var(--line);
      border-radius: 18px;
      overflow: hidden;
      transition:
        border-color 0.22s ease,
        box-shadow 0.22s ease,
        transform 0.22s ease;
    }

    .resource-block:hover {
      border-color: #d8dce1;
      box-shadow: 0 12px 30px rgba(17, 29, 44, 0.06);
      transform: translateY(-3px);
    }

    .resource-block__header {
      margin-bottom: 10px;
    }

    .resource-block__label {
      margin-bottom: 9px;
      color: var(--orange);
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 0.14em;
      line-height: 1.2;
    }

    .resource-block h2 {
      margin: 0;
      color: var(--ink);
      font-size: 22px;
      line-height: 1.3;
    }

    .resource-block__description {
      min-height: 48px;
      margin: 0 0 22px;
      color: var(--muted);
      font-size: 14px;
      line-height: 1.7;
    }

    .resource-block pre {
      position: relative;
      flex: 1 1 auto;
      min-height: 0;
      margin: 0;
      padding: 22px;
      overflow-x: auto;
      overflow-y: auto;
      white-space: pre;
      background: #2f353d;
      border-radius: 10px;
      color: #f3f4f6;
      font-family: "Cascadia Code", "Consolas", "Courier New", monospace;
      font-size: 13px;
      line-height: 1.7;
    }

    .resource-block code {
      font-family: inherit;
      white-space: pre;
    }

    .resource-note {
      max-width: 820px;
      margin-top: 32px;
      padding: 30px;
      box-sizing: border-box;
      background: #f7f8fa;
      border: 1px solid var(--line);
      border-radius: 18px;
      color: var(--muted);
      font-size: 14px;
      line-height: 1.75;
    }

    .resource-note .eyebrow {
      margin: 0 0 14px;
    }

    .resource-note h2 {
      margin: 0 0 14px;
      color: var(--ink);
      font-size: clamp(28px, 3vw, 38px);
      line-height: 1.15;
    }

    .resource-note p:not(.eyebrow) {
      margin: 0 0 14px;
    }

    .resource-note p:last-child {
      margin-bottom: 0;
    }

    .resource-actions {
      display: flex;
      align-items: center;
      gap: 24px;
      justify-content: flex-start;
      margin-top: 24px;
    }

    .resource-actions__link {
      color: var(--orange);
      font-size: 14px;
      font-weight: 700;
      text-decoration: none;
    }

    .resource-actions__link:hover {
      text-decoration: underline;
    }

    @media (max-width: 820px) {
      .resource-grid {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 680px) {
      .resource-hero {
        padding-top: 58px;
        padding-bottom: 54px;
      }

      .resource-hero h1 {
        font-size: clamp(38px, 12vw, 54px);
      }

      .resource-section {
        padding-top: 42px;
        padding-bottom: 64px;
      }

      .resource-block {
        height: 520px;
        padding: 22px;
        border-radius: 16px;
      }

      .resource-block__description {
        min-height: 0;
      }

      .resource-block pre {
        padding: 18px;
        font-size: 12px;
      }

      .resource-note {
        padding: 22px;
        border-radius: 16px;
      }

      .resource-actions {
        flex-wrap: wrap;
        gap: 16px;
      }
    }
  </style>
</BaseLayout>
