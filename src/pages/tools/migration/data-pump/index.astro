---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Data Pump"
  description="Practical Oracle SQL for monitoring Data Pump jobs, sessions, transfer progress and operational activity during export and import."
>
  <main>
    <section class="resource-hero">
      <div class="container">
        <p class="eyebrow">ORASOLU TOOLBOX · MIGRATION</p>
        <h1>Data <span class="hero-accent">Pump</span></h1>
        <p>
          Practical Oracle SQL for reviewing Data Pump jobs, sessions, transfer
          progress and operational activity during export and import.
        </p>
      </div>
    </section>

    <section class="resource-section">
      <div class="container">
        <div class="resource-intro">
          <p class="eyebrow">ORASOLU TOOLBOX · MIGRATION</p>
          <h2>Monitor Data Pump from the database</h2>
          <p>
            Data Pump investigations are easier when job state, attached sessions
            and transfer progress are reviewed together. These queries provide a
            practical starting point for monitoring export and import activity.
          </p>
        </div>

        <div class="resource-grid">
          <article class="resource-block">
            <div class="resource-block__header">
              <div class="resource-block__label">01 · JOBS</div>
              <h2>Review Data Pump jobs</h2>
            </div>
            <p class="resource-block__description">
              Review active Data Pump jobs, their operation, state and parallel degree.
            </p>
            <pre><code>SELECT
  owner_name,
  job_name,
  operation,
  job_mode,
  state,
  degree,
  attached_sessions,
  datapump_sessions
FROM dba_datapump_jobs
ORDER BY owner_name, job_name;</code></pre>
          </article>

          <article class="resource-block">
            <div class="resource-block__header">
              <div class="resource-block__label">02 · EXPORT</div>
              <h2>Find Data Pump exports</h2>
            </div>
            <p class="resource-block__description">
              Focus on export jobs when investigating source-side Data Pump activity.
            </p>
            <pre><code>SELECT
  owner_name,
  job_name,
  job_mode,
  state,
  degree,
  attached_sessions
FROM dba_datapump_jobs
WHERE operation = 'EXPORT'
ORDER BY owner_name, job_name;</code></pre>
          </article>

          <article class="resource-block">
            <div class="resource-block__header">
              <div class="resource-block__label">03 · IMPORT</div>
              <h2>Find Data Pump imports</h2>
            </div>
            <p class="resource-block__description">
              Focus on import jobs when investigating target-side Data Pump activity.
            </p>
            <pre><code>SELECT
  owner_name,
  job_name,
  job_mode,
  state,
  degree,
  attached_sessions
FROM dba_datapump_jobs
WHERE operation = 'IMPORT'
ORDER BY owner_name, job_name;</code></pre>
          </article>

          <article class="resource-block">
            <div class="resource-block__header">
              <div class="resource-block__label">04 · SESSIONS</div>
              <h2>Inspect Data Pump sessions</h2>
            </div>
            <p class="resource-block__description">
              Identify the sessions attached to a Data Pump job and the role each session plays.
            </p>
            <pre><code>SELECT
  owner_name,
  job_name,
  instance_id,
  saddr,
  session_type
FROM dba_datapump_sessions
ORDER BY owner_name, job_name, session_type;</code></pre>
          </article>

          <article class="resource-block">
            <div class="resource-block__header">
              <div class="resource-block__label">05 · SESSION DETAILS</div>
              <h2>Correlate Data Pump sessions</h2>
            </div>
            <p class="resource-block__description">
              Correlate Data Pump session addresses with V$SESSION to review session state and activity.
            </p>
            <pre><code>SELECT
  d.owner_name,
  d.job_name,
  d.session_type,
  s.sid,
  s.serial#,
  s.status,
  s.event,
  s.wait_class
FROM dba_datapump_sessions d
JOIN v$session s
  ON s.saddr = d.saddr
ORDER BY d.owner_name, d.job_name, d.session_type, s.sid;</code></pre>
          </article>

          <article class="resource-block">
            <div class="resource-block__header">
              <div class="resource-block__label">06 · PROGRESS</div>
              <h2>Monitor transfer progress</h2>
            </div>
            <p class="resource-block__description">
              Review Data Pump table-transfer progress reported through V$SESSION_LONGOPS.
            </p>
            <pre><code>SELECT
  username,
  opname,
  target_desc,
  sofar,
  totalwork,
  units,
  message
FROM v$session_longops
WHERE opname LIKE 'SYS_EXPORT%'
   OR opname LIKE 'SYS_IMPORT%'
ORDER BY start_time DESC;</code></pre>
          </article>
        </div>

        <div class="resource-note">
          <p class="eyebrow">ORASOLU TOOLBOX · MIGRATION</p>
          <h2>Data Pump status is more than a job name.</h2>
          <p>
            Job state, attached sessions and transfer progress provide different
            views of the same migration activity. Correlating them helps distinguish
            an active operation from a job that has stopped or is waiting on database work.
          </p>
          <p>
            Use these queries as an operational starting point and correlate the results
            with the Data Pump log, export or import parameters and the migration procedure.
          </p>
        </div>

        <div class="resource-actions">
          <a class="button button--primary" href="/tools/migration/">Back to Migration</a>
          <a class="resource-actions__link" href="/tools/migration/transportable-tablespaces/">Read Transportable Tablespaces</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .resource-hero {
    padding-top: 72px;
    padding-bottom: 72px;
    border-bottom: 1px solid var(--line);
  }

  .resource-hero h1 {
    margin: 0 0 14px;
    color: var(--ink);
    font-size: clamp(42px, 6vw, 72px);
    line-height: 1.05;
    letter-spacing: -0.04em;
  }

  .resource-hero .hero-accent {
    color: var(--orange);
  }

  .resource-hero > .container > p:last-child {
    max-width: 900px;
    margin: 0;
    color: var(--muted);
    font-size: 17px;
    line-height: 1.75;
  }

  .resource-section {
    padding-top: 56px;
    padding-bottom: 72px;
  }

  .resource-intro {
    max-width: 820px;
    margin-bottom: 32px;
  }

  .resource-intro .eyebrow {
    margin: 0 0 14px;
    color: var(--orange);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.14em;
    line-height: 1.2;
  }

  .resource-intro h2 {
    margin: 0 0 14px;
    color: var(--ink);
    font-size: clamp(28px, 3vw, 38px);
    line-height: 1.15;
  }

  .resource-intro p:not(.eyebrow) {
    margin: 0;
    color: var(--muted);
    font-size: 16px;
    line-height: 1.75;
  }

  .resource-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 22px;
    align-items: start;
  }

  .resource-block {
    display: flex;
    flex-direction: column;
    min-width: 0;
    height: 560px;
    box-sizing: border-box;
    margin: 0;
    padding: 30px;
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: 18px;
    overflow: hidden;
    transition:
      border-color 0.22s ease,
      box-shadow 0.22s ease,
      transform 0.22s ease;
  }

  .resource-block:hover {
    border-color: #d8dce1;
    box-shadow: 0 12px 30px rgba(17, 29, 44, 0.06);
    transform: translateY(-3px);
  }

  .resource-block__header {
    margin-bottom: 10px;
  }

  .resource-block__label {
    margin-bottom: 9px;
    color: var(--orange);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.14em;
    line-height: 1.2;
  }

  .resource-block h2 {
    margin: 0;
    color: var(--ink);
    font-size: 22px;
    line-height: 1.3;
  }

  .resource-block__description {
    min-height: 48px;
    margin: 0 0 22px;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.7;
  }

  .resource-block pre {
    position: relative;
    flex: 1 1 auto;
    min-height: 0;
    margin: 0;
    padding: 22px;
    overflow-x: auto;
    overflow-y: auto;
    white-space: pre;
    background: #2f353d;
    border-radius: 10px;
    color: #f3f4f6;
    font-family: "Cascadia Code", "Consolas", "Courier New", monospace;
    font-size: 13px;
    line-height: 1.7;
  }

  .resource-block code {
    font-family: inherit;
    white-space: pre;
  }

  .resource-note {
    max-width: 820px;
    margin-top: 32px;
    padding: 30px;
    box-sizing: border-box;
    background: #f7f8fa;
    border: 1px solid var(--line);
    border-radius: 18px;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.75;
  }

  .resource-note .eyebrow {
    margin: 0 0 14px;
  }

  .resource-note h2 {
    margin: 0 0 14px;
    color: var(--ink);
    font-size: clamp(28px, 3vw, 38px);
    line-height: 1.15;
  }

  .resource-note p:not(.eyebrow) {
    margin: 0 0 14px;
  }

  .resource-note p:last-child {
    margin-bottom: 0;
  }

  .resource-actions {
    display: flex;
    align-items: center;
    gap: 24px;
    justify-content: flex-start;
    margin-top: 24px;
  }

  .resource-actions__link {
    color: var(--orange);
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
  }

  .resource-actions__link:hover {
    text-decoration: underline;
  }

  @media (max-width: 820px) {
    .resource-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 680px) {
    .resource-hero {
      padding-top: 58px;
      padding-bottom: 54px;
    }

    .resource-hero h1 {
      font-size: clamp(38px, 12vw, 54px);
    }

    .resource-section {
      padding-top: 42px;
      padding-bottom: 64px;
    }

    .resource-block {
      height: 520px;
      padding: 22px;
      border-radius: 16px;
    }

    .resource-block__description {
      min-height: 0;
    }

    .resource-block pre {
      padding: 18px;
      font-size: 12px;
    }

    .resource-note {
      padding: 22px;
      border-radius: 16px;
    }

    .resource-actions {
      flex-wrap: wrap;
      gap: 16px;
    }
  }
</style>

<script>
  document.querySelectorAll(".resource-block pre").forEach((pre) => {
    const button = document.createElement("button");
    button.type = "button";
    button.className = "resource-copy-button";
    button.textContent = "Copy";
    button.setAttribute("aria-label", "Copy SQL");

    pre.style.position = "relative";
    button.style.position = "absolute";
    button.style.top = "10px";
    button.style.right = "10px";
    button.style.padding = "5px 9px";
    button.style.border = "1px solid #d1d5db";
    button.style.borderRadius = "5px";
    button.style.background = "#ffffff";
    button.style.color = "#374151";
    button.style.fontFamily = "inherit";
    button.style.fontSize = "0.75rem";
    button.style.cursor = "pointer";
    button.style.zIndex = "2";

    button.addEventListener("click", async () => {
      const code = pre.querySelector("code");
      if (!code) return;

      try {
        await navigator.clipboard.writeText(code.textContent || "");
        button.textContent = "Copied";
        window.setTimeout(() => {
          button.textContent = "Copy";
        }, 1500);
      } catch {
        button.textContent = "Copy failed";
        window.setTimeout(() => {
          button.textContent = "Copy";
        }, 1500);
      }
    });

    pre.appendChild(button);
  });
</script>
