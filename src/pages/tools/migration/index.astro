---
import BaseLayout from "../../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Migration"
  description="Practical Oracle resources for migration planning, Data Pump, transportable tablespaces, cross-platform moves and migration readiness."
>
  <main>
    <section class="page-hero">
      <div class="container">
        <div class="eyebrow">ORASOLU TOOLBOX &middot; MIGRATION</div>

        <h1>
          Database <span>Migration</span>
        </h1>

        <p>
          Practical Oracle resources for migration planning, Data Pump,
          transportable tablespaces, cross-platform moves and migration readiness.
        </p>
      </div>
    </section>

    <section class="section sql-tools-section">
      <div class="container">
        <div class="section-intro">
          <div>
            <div class="eyebrow">ORASOLU TOOLBOX &middot; MIGRATION</div>

            <h2>
              Practical database migration investigation
            </h2>

            <p>
              A successful Oracle migration depends on understanding the source
              environment, choosing the right migration method and validating the
              target after the move. These resources provide practical starting
              points for planning and investigation.
            </p>
          </div>
        </div>

        <div class="sql-resource-grid">
          <a href="/tools/migration/migration-assessment/" class="sql-resource-card">
            <div class="sql-resource-card__label">PLANNING</div>
            <h3>Migration Assessment</h3>
            <p>
              Review database size, objects, users, features and dependencies
              before selecting a migration approach.
            </p>
            <span class="sql-resource-card__action">Explore</span>
          </a>

          <a href="/tools/migration/data-pump/" class="sql-resource-card">
            <div class="sql-resource-card__label">DATA PUMP</div>
            <h3>Data Pump</h3>
            <p>
              Practical SQL and operational checks for Oracle Data Pump export,
              import, jobs and object-level migration activity.
            </p>
            <span class="sql-resource-card__action">Explore</span>
          </a>

          <a href="/tools/migration/transportable-tablespaces/" class="sql-resource-card">
            <div class="sql-resource-card__label">TRANSPORTABLE</div>
            <h3>Transportable Tablespaces</h3>
            <p>
              Review tablespace readiness, read-only requirements and metadata
              needed for transportable database moves.
            </p>
            <span class="sql-resource-card__action">Explore</span>
          </a>

          <a href="/tools/migration/cross-platform/" class="sql-resource-card">
            <div class="sql-resource-card__label">CROSS-PLATFORM</div>
            <h3>Cross-Platform Migration</h3>
            <p>
              Investigate platform characteristics, endian format, data files
              and prerequisites for cross-platform database moves.
            </p>
            <span class="sql-resource-card__action">Explore</span>
          </a>

          <a href="/tools/migration/migration-validation/" class="sql-resource-card">
            <div class="sql-resource-card__label">VALIDATION</div>
            <h3>Migration Validation</h3>
            <p>
              Validate database objects, invalid objects, data files and core
              database properties after a migration.
            </p>
            <span class="sql-resource-card__action">Explore</span>
          </a>

          <a href="/tools/migration/migration-diagnostics/" class="sql-resource-card">
            <div class="sql-resource-card__label">DIAGNOSTICS</div>
            <h3>Migration Diagnostics</h3>
            <p>
              Investigate migration-related errors, object differences and
              operational issues during or after a database move.
            </p>
            <span class="sql-resource-card__action">Explore</span>
          </a>
        </div>
      </div>
    </section>

    <section class="section section--soft">
      <div class="container">
        <div class="sql-tools-note">
          <div class="eyebrow">ORASOLU TOOLBOX &middot; MIGRATION</div>

          <h2>Migration starts with understanding the source.</h2>

          <p>
            Database size, object dependencies, platform characteristics,
            application requirements and recovery considerations should be
            understood before choosing the migration method.
          </p>

          <a class="button button--primary" href="/tools/">
            Back to Tools
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .sql-tools-section {
    padding-top: 72px;
    padding-bottom: 88px;
  }

  .section-intro {
    margin-bottom: 42px;
  }

  .section-intro h2 {
    margin: 0 0 14px;
    font-size: clamp(28px, 3vw, 38px);
    line-height: 1.15;
    color: var(--ink);
  }

  .section-intro p {
    max-width: 760px;
    margin: 0;
    color: var(--muted);
    font-size: 16px;
    line-height: 1.7;
  }

  .sql-resource-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
  }

  .sql-resource-card {
    display: block;
    min-height: 220px;
    padding: 28px;
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: 18px;
    color: inherit;
    text-decoration: none;
    cursor: pointer;
    transition:
      border-color 0.22s ease,
      box-shadow 0.22s ease,
      transform 0.22s ease,
      background-color 0.22s ease;
  }

  .sql-resource-card:hover {
    border-color: var(--orange);
    box-shadow: 0 10px 24px rgba(17, 29, 44, 0.08);
    transform: translateY(-2px);
  }

  .sql-resource-card h3 {
    transition:
      color 0.22s ease,
      transform 0.22s ease;
  }

  .sql-resource-card:hover h3 {
    color: var(--orange);
  }

  .sql-resource-card__action {
    transition:
      color 0.22s ease,
      transform 0.22s ease;
  }

  .sql-resource-card:hover .sql-resource-card__action {
    color: var(--orange);
  }

  .sql-resource-card__label {
    margin-bottom: 12px;
    color: var(--orange);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.14em;
    line-height: 1.2;
  }

  .sql-resource-card h3 {
    margin: 0 0 12px;
    color: var(--ink);
    font-size: 20px;
    font-weight: 750;
    line-height: 1.25;
  }

  .sql-resource-card p {
    margin: 0 0 22px;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.65;
  }

  .sql-resource-card__action {
    display: inline-block;
    color: var(--orange);
    font-size: 14px;
    font-weight: 700;
  }

  .sql-tools-note {
    max-width: 820px;
  }

  .sql-tools-note h2 {
    margin: 0 0 14px;
    color: var(--ink);
    font-size: clamp(28px, 3vw, 38px);
    line-height: 1.15;
  }

  .sql-tools-note p {
    max-width: 760px;
    margin: 0 0 28px;
    color: var(--muted);
    font-size: 16px;
    line-height: 1.75;
  }

  @media (max-width: 980px) {
    .sql-resource-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 680px) {
    .sql-tools-section {
      padding-top: 52px;
      padding-bottom: 64px;
    }

    .sql-resource-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .sql-resource-card {
      min-height: auto;
      padding: 22px;
      border-radius: 16px;
    }
  }
</style>
