---
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import "../../../styles/global.css";

const resources = [
  {
    label: "RMAN",
    title: "RMAN Database Backup",
    description:
      "RMAN commands for reviewing database backup activity, backup pieces and recent backup jobs.",
    href: "/tools/backup-recovery/rman-database-backup/",
  },
  {
    label: "BACKUPS",
    title: "Backup Status",
    description:
      "Review recent RMAN backup status, completion times, sizes and backup types.",
    href: "/tools/backup-recovery/backup-status/",
  },
  {
    label: "REDO",
    title: "Archived Redo",
    description:
      "Inspect archived redo generation, destination status and archive history during backup and recovery investigations.",
    href: "/tools/backup-recovery/archived-redo/",
  },
  {
    label: "RECOVERY",
    title: "RMAN Recovery",
    description:
      "Practical SQL and RMAN checks for validating recovery readiness, restore points and recovery metadata.",
    href: "/tools/backup-recovery/rman-recovery/",
  },
  {
    label: "STORAGE",
    title: "Backup Space",
    description:
      "Review backup storage usage and identify large or aging backup pieces that require attention.",
    href: "/tools/backup-recovery/backup-space/",
  },
  {
    label: "DIAGNOSTICS",
    title: "Recovery Diagnostics",
    description:
      "Investigate backup and recovery problems by correlating RMAN activity, archived redo and database status.",
    href: "/tools/backup-recovery/recovery-diagnostics/",
  },
];
---

<head>
  <title>Backup &amp; Recovery | ORASOLU</title>
  <meta name="description" content="Practical Oracle resources for backup, archived redo, recovery readiness and operational diagnostics." />
</head>

<Header />

<main>
  <section class="tool-hero backup-recovery-page">
    <div class="container">
      <p class="eyebrow">ORASOLU TOOLBOX &middot; BACKUP &amp; RECOVERY</p>
      <h1>Backup <span>&amp; Recovery</span></h1>
      <p>
        Practical Oracle resources for backup, archived redo, recovery
        readiness and operational diagnostics.
      </p>
    </div>
  </section>

  <section class="tool-section backup-recovery-page">
    <div class="container">
      <div class="tool-intro">
        <p class="eyebrow">ORASOLU TOOLBOX &middot; BACKUP &amp; RECOVERY</p>
        <h2>Practical backup and recovery investigation</h2>
        <p>
          A focused collection of queries and operational resources for
          understanding backup activity, archived redo and recovery readiness.
        </p>
      </div>

      <div class="tool-grid">
        {
          resources.map((resource) => (
            <a class="tool-card" href={resource.href}>
              <div class="tool-card__label">{resource.label}</div>
              <h2>{resource.title}</h2>
              <p>{resource.description}</p>
              <span class="tool-card__action">Explore</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="tool-note backup-recovery-page">
    <div class="container">
      <div class="tool-note__content">
        <p class="eyebrow">ORASOLU TOOLBOX &middot; BACKUP &amp; RECOVERY</p>
        <h2>Recovery readiness starts with evidence.</h2>
        <p>
          Use backup history, archived redo, RMAN metadata and database state
          together. A successful backup job is only one part of understanding
          whether an Oracle database can be recovered when needed.
        </p>
        <a class="button button--primary" href="/tools/">Back to Tools</a>
      </div>
    </div>
  </section>
</main>

<Footer />

<style>
  .tool-hero {
    background: #fff;
    padding-top: 82px;
    padding-bottom: 72px;
    border-bottom: 1px solid var(--line);
  }

  .tool-hero h1 {
    margin: 0 0 14px;
    color: var(--ink);
    font-size: clamp(42px, 6vw, 72px);
    line-height: 1.05;
    letter-spacing: -0.04em;
  }

  .tool-hero h1 span {
    color: var(--orange);
  }

  .tool-hero > .container > p:last-child {
    max-width: 900px;
    margin: 0;
    color: var(--muted);
    font-size: 17px;
    line-height: 1.75;
  }

  .tool-section {
    background: #fff;
    padding-top: 56px;
    padding-bottom: 64px;
  }

  .tool-intro {
    max-width: 820px;
    margin-bottom: 32px;
  }

  .tool-intro h2 {
    margin: 0 0 14px;
    color: var(--ink);
    font-size: clamp(28px, 3vw, 38px);
    line-height: 1.15;
  }

  .tool-intro > p:last-child {
    margin: 0;
    color: var(--muted);
    font-size: 16px;
    line-height: 1.75;
  }

  .tool-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
    align-items: stretch;
  }

  .backup-recovery-page .tool-card {
    align-items: flex-start !important;
    text-align: left !important;
  }

  .backup-recovery-page .tool-card .tool-card__label,
  .backup-recovery-page .tool-card h2,
  .backup-recovery-page .tool-card p,
  .backup-recovery-page .tool-card .tool-card__action {
    text-align: left !important;
  }

  .tool-card {
    display: flex;
    min-height: 238px;
    flex-direction: column;
    align-items: flex-start !important;
    box-sizing: border-box;
    padding: 28px;
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: 18px;
    color: inherit;
    text-decoration: none;
    text-align: left !important;
    transition:
      border-color 0.22s ease,
      box-shadow 0.22s ease,
      transform 0.22s ease;
  }

  .tool-card:hover {
    border-color: var(--orange);
    box-shadow: 0 10px 24px rgba(17, 29, 44, 0.08);
    transform: translateY(-2px);
  }

  .tool-card__label {
    margin-bottom: 14px;
    color: var(--orange);
    text-align: left !important;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.14em;
    line-height: 1.2;
  }

  .tool-card h2 {
    margin: 0 0 12px;
    color: var(--ink);
    text-align: left !important;
    font-size: 22px;
    line-height: 1.3;
  }

  .tool-card p {
    margin: 0;
    color: var(--muted);
    text-align: left !important;
    font-size: 14px;
    line-height: 1.7;
  }

  .tool-card__action {
    margin-top: auto;
    padding-top: 24px;
    color: var(--orange);
    text-align: left !important;
    font-size: 14px;
    font-weight: 700;
  }

  .tool-note {
    padding: 64px 0 72px;
    background: #f7f8fa;
  }

  .tool-note__content {
    max-width: 900px;
  }

  .tool-note__content .eyebrow {
    margin: 0 0 14px;
  }

  .tool-note h2 {
    margin: 0 0 14px;
    color: var(--ink);
    font-size: clamp(28px, 3vw, 38px);
    line-height: 1.15;
  }

  .tool-note p:not(.eyebrow) {
    max-width: 820px;
    margin: 0 0 24px;
    color: var(--muted);
    font-size: 16px;
    line-height: 1.75;
  }

  @media (max-width: 980px) {
    .tool-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 680px) {
    .tool-hero {
    background: #fff;
      padding-top: 58px;
      padding-bottom: 54px;
    }

    .tool-hero h1 {
      font-size: clamp(38px, 12vw, 54px);
    }

    .tool-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .tool-card {
      min-height: 0;
      padding: 22px;
      border-radius: 16px;
    }

    .tool-note {
      padding: 48px 0 54px;
    }
  }
</style>

