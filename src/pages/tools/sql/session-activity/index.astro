    background: #f7f8fa;
    border: 1px solid var(--line);
    border-radius: 18px;
  }


  .resource-note h2 {
    margin: 0 0 14px;

    color: var(--ink);

    font-size: clamp(24px, 3vw, 32px);
    line-height: 1.2;
  }


  .resource-note p {
    margin: 0;

    color: var(--muted);

    font-size: 15px;
