---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
---

<BaseLayout>

  <section class="page-hero">
    <div class="container">

      <div class="eyebrow">ORASOLU TOOLBOX &middot; SQL &amp; DATABASE</div>

      <h1>
        Database <span>Objects</span>
      </h1>

      <p>
        Practical Oracle SQL for reviewing users, tables, indexes,
        invalid objects and database object status.
      </p>

    </div>
  </section>


  <section class="section resource-section">
    <div class="container">

      <div class="resource-intro">

        <div class="eyebrow">ORASOLU TOOLBOX &middot; SQL &amp; DATABASE</div>

        <h2>
          Understand what exists in the database
        </h2>

        <p>
          These queries provide a practical starting point for
          investigating schemas, database objects and object status
          across an Oracle environment.
        </p>

      </div>


      <div class="resource-grid">


      <div class="resource-block">

        <div class="resource-block__header">
          <div>
            <div class="resource-block__label">01 &middot; USERS & SCHEMAS</div>

            <h2>
              Review database users
            </h2>
          </div>
        </div>

        <p class="resource-block__description">
          Review database users and their current account status.
          This is useful when establishing which schemas exist and
          whether accounts are currently available.
        </p>

        <pre><code>SELECT
    username,
    account_status,
    created,
    default_tablespace,
    temporary_tablespace
FROM dba_users
ORDER BY username;</code></pre>

      </div>


      <div class="resource-block">

        <div class="resource-block__header">
          <div>
            <div class="resource-block__label">02 &middot; TABLES</div>

            <h2>
              Find tables by schema
            </h2>
          </div>
        </div>

        <p class="resource-block__description">
          Use this query to review tables owned by a particular
          schema. Replace the schema name with the owner you want
          to investigate.
        </p>

        <pre><code>SELECT
    owner,
    table_name,
    tablespace_name,
    num_rows,
    last_analyzed
FROM dba_tables
WHERE owner = UPPER('&amp;OWNER')
ORDER BY table_name;</code></pre>

      </div>


      <div class="resource-block">

        <div class="resource-block__header">
          <div>
            <div class="resource-block__label">03 &middot; INDEXES</div>

            <h2>
              Review indexes for a schema
            </h2>
          </div>
        </div>

        <p class="resource-block__description">
          Review index names, associated tables, status and index
          type for objects belonging to a particular schema.
        </p>

        <pre><code>SELECT
    owner,
    index_name,
    table_name,
    index_type,
    status,
    visibility
FROM dba_indexes
WHERE owner = UPPER('&amp;OWNER')
ORDER BY table_name, index_name;</code></pre>

      </div>


      <div class="resource-block">

        <div class="resource-block__header">
          <div>
            <div class="resource-block__label">04 &middot; INVALID OBJECTS</div>

            <h2>
              Find invalid database objects
            </h2>
          </div>
        </div>

        <p class="resource-block__description">
          Invalid objects can be an important operational clue after
          deployments, upgrades, migrations or other database changes.
        </p>

        <pre><code>SELECT
    owner,
    object_type,
    object_name,
    status
FROM dba_objects
WHERE status &lt;&gt; 'VALID'
ORDER BY owner, object_type, object_name;</code></pre>

      </div>


      <div class="resource-block">

        <div class="resource-block__header">
          <div>
            <div class="resource-block__label">05 &middot; OBJECT COUNTS</div>

            <h2>
              Summarize objects by schema and type
            </h2>
          </div>
        </div>

        <p class="resource-block__description">
          A quick inventory of object counts can help establish the
          size and composition of a schema before deeper investigation.
        </p>

        <pre><code>SELECT
    owner,
    object_type,
    COUNT(*) AS object_count
FROM dba_objects
GROUP BY owner, object_type
ORDER BY owner, object_type;</code></pre>

      </div>


      <div class="resource-block">

        <div class="resource-block__header">
          <div>
            <div class="resource-block__label">06 &middot; OBJECT STATUS</div>

            <h2>
              Review objects for one schema
            </h2>
          </div>
        </div>

        <p class="resource-block__description">
          Use this query when you need a focused view of all objects
          and their status within a particular schema.
        </p>

        <pre><code>SELECT
    owner,
    object_type,
    object_name,
    status,
    last_ddl_time
FROM dba_objects
WHERE owner = UPPER('&amp;OWNER')
ORDER BY object_type, object_name;</code></pre>

      </div></div>


      <div class="resource-note">

        <div class="eyebrow">ORASOLU TOOLBOX &middot; SQL &amp; DATABASE</div>

        <h2>
          Object status is a starting point, not the diagnosis.
        </h2>

        <p>
          An invalid object should normally be investigated in the
          context of the object type, recent DDL or deployment activity,
          dependencies and any associated compilation errors.
        </p>

      </div>


      <div class="resource-actions">

        <a class="button button--primary" href="/tools/sql/">
          Back to SQL & Database
        </a>

        <a class="resource-actions__link" href="/tools/sql/tablespace-information/">
          Tablespace Information
        </a>

      </div>

    </div>
  </section>

</BaseLayout>


<style>

  .resource-section {
  padding-top: 56px;
  padding-bottom: 72px;
}

  .resource-intro {
    max-width: 820px;
    margin-bottom: 36px;
  }

  .resource-intro h2 {
    margin: 0 0 14px;
    color: var(--ink);
    font-size: clamp(28px, 3vw, 38px);
    line-height: 1.15;
  }

  .resource-intro p {
    margin: 0;
    color: var(--muted);
    font-size: 16px;
    line-height: 1.75;
  }

  .resource-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 22px;
}

.resource-block {
        margin-bottom: 0;
    padding: 30px;
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: 18px;
  }

  .resource-block__header {
    margin-bottom: 12px;
  }

  .resource-block__label {
    margin-bottom: 9px;
    color: var(--orange);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.14em;
    line-height: 1.2;
  }

  .resource-block h2 {
    margin: 0;
    color: var(--ink);
    font-size: 22px;
    line-height: 1.3;
  }

  .resource-block__description {
    max-width: 820px;
    margin: 0 0 22px;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.7;
  }

  .resource-block pre {
    position: relative;
    margin: 0;
    padding: 22px;
    overflow-x: auto;
    background: #2f353d;
    border-radius: 10px;
    color: #f3f4f6;
    font-family:
      "Cascadia Code",
      "Consolas",
      "Courier New",
      monospace;
    font-size: 13px;
    line-height: 1.7;
  }

  .resource-block code {
    font-family: inherit;
  }

  .resource-note {
    max-width: 820px;
    margin-top: 56px;
    padding: 30px;
    background: #f7f8fa;
    border: 1px solid var(--line);
    border-radius: 18px;
  }

  .resource-note h2 {
    margin: 0 0 14px;
    color: var(--ink);
    font-size: clamp(24px, 3vw, 32px);
    line-height: 1.2;
  }

  .resource-note p {
    margin: 0;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.75;
  }

  .resource-actions {
    display: flex;
    align-items: center;
    gap: 24px;
    margin-top: 32px;
  }

  .resource-actions__link {
    color: var(--orange);
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
  }

  .resource-actions__link:hover {
    text-decoration: underline;
  }

  @media (max-width: 820px) {
  .resource-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 680px) {

    .resource-section {
  padding-top: 56px;
  padding-bottom: 72px;
}

    .resource-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 22px;
}

.resource-block {
          padding: 22px;
      border-radius: 16px;
    }

    .resource-block pre {
      padding: 18px;
      font-size: 12px;
    }

    .resource-actions {
      align-items: flex-start;
      flex-direction: column;
      gap: 18px;
    }

  }


  /* ORASOLU TOOLBOX - STANDARD RESOURCE SYSTEM */

  .resource-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 22px;
    align-items: start;
  }

  .resource-block {
    display: flex;
    flex-direction: column;
    min-width: 0;
    margin: 0;
    padding: 30px;
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: 18px;
    transition:
      border-color 0.22s ease,
      box-shadow 0.22s ease,
      transform 0.22s ease;
  }

  .resource-block:hover {
    border-color: #d8dce1;
    box-shadow: 0 12px 30px rgba(17, 29, 44, 0.06);
    transform: translateY(-3px);
  }

  .resource-block__header {
    margin-bottom: 10px;
  }

  .resource-block__label {
    margin-bottom: 9px;
    color: var(--orange);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.14em;
    line-height: 1.2;
  }

  .resource-block h2 {
    margin: 0;
    color: var(--ink);
    font-size: 22px;
    line-height: 1.3;
  }

  .resource-block__description {
    min-height: 48px;
    margin: 0 0 22px;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.7;
  }

  .resource-block pre {
    position: relative;
    margin: 0;
    padding: 22px;
    overflow-x: auto;
    background: #2f353d;
    border-radius: 10px;
    color: #f3f4f6;
    font-family:
      "Cascadia Code",
      "Consolas",
      "Courier New",
      monospace;
    font-size: 13px;
    line-height: 1.7;
  }

  .resource-block code {
    font-family: inherit;
  }

  .resource-copy-button {
    position: absolute;
    top: 10px;
    right: 10px;
    padding: 5px 9px;
    border: 1px solid #d1d5db;
    border-radius: 5px;
    background: #ffffff;
    color: #374151;
    font-family: inherit;
    font-size: 0.75rem;
    cursor: pointer;
    z-index: 2;
  }

  .resource-copy-button:hover {
    background: #f3f4f6;
  }

  @media (max-width: 820px) {
    .resource-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 680px) {
    .resource-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .resource-block {
      padding: 22px;
      border-radius: 16px;
    }

    .resource-block__description {
      min-height: 0;
    }

    .resource-block pre {
      padding: 18px;
      font-size: 12px;
    }
  }

  /* ORASOLU TOOLBOX - STANDARD RESOURCE CARD SIZE */

  .resource-block {
    height: 560px;
    box-sizing: border-box;
    overflow: hidden;
  }

  .resource-block pre {
    flex: 1 1 auto;
    min-height: 0;
    overflow-x: auto;
    overflow-y: auto;
    white-space: pre;
  }

  .resource-block code {
    white-space: pre;
  }

  @media (max-width: 680px) {
    .resource-block {
      height: 520px;
    }
  }
</style>


<script>
  document.querySelectorAll(".resource-block pre").forEach((pre) => {
    const button = document.createElement("button");

    button.type = "button";
    button.className = "resource-copy-button";
    button.textContent = "Copy";
    button.setAttribute("aria-label", "Copy SQL");

    pre.style.position = "relative";

    button.style.position = "absolute";
    button.style.top = "10px";
    button.style.right = "10px";
    button.style.padding = "5px 9px";
    button.style.border = "1px solid #d1d5db";
    button.style.borderRadius = "5px";
    button.style.background = "#ffffff";
    button.style.color = "#374151";
    button.style.fontFamily = "inherit";
    button.style.fontSize = "0.75rem";
    button.style.cursor = "pointer";
    button.style.zIndex = "2";

    button.addEventListener("click", async () => {
      const code = pre.querySelector("code");

      if (!code) {
        return;
      }

      try {
        await navigator.clipboard.writeText(code.textContent || "");

        button.textContent = "Copied";

        window.setTimeout(() => {
          button.textContent = "Copy";
        }, 1500);
      } catch {
        button.textContent = "Copy failed";

        window.setTimeout(() => {
          button.textContent = "Copy";
        }, 1500);
      }
    });

    pre.appendChild(button);
  });
</script>
