---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
---

<BaseLayout>

  <section class="page-hero toolbox-hero">
    <div class="container">

      <div class="eyebrow">ORASOLU TOOLBOX &middot; SQL &amp; DATABASE</div>

      <h1>
        Database <span>Diagnostics</span>
      </h1>

      <p>
        Practical Oracle SQL for identifying wait activity, long-running
        operations and diagnostic clues during database investigation.
      </p>

    </div>
  </section>


  <section class="section resource-section">
    <div class="container">

      <div class="resource-intro">

        <div class="eyebrow">ORASOLU TOOLBOX &middot; SQL &amp; DATABASE</div>

        <h2>
          Establish what the database is doing
        </h2>

        <p>
          These queries help establish current database activity and
          provide diagnostic clues that can guide deeper investigation.
          Use them together with workload, SQL and application context.
        </p>

      </div>


      <div class="resource-grid">


      <div class="resource-block">

        <div class="resource-block__header">
          <div>
            <div class="resource-block__label">01 &middot; SYSTEM WAITS</div>

            <h2>
              Review system wait events
            </h2>
          </div>
        </div>

        <p class="resource-block__description">
          Review accumulated wait information for the instance. This
          provides a broad view of where database time has been spent
          and can help identify areas for further investigation.
        </p>

        <pre><code>SELECT
    event,
    wait_class,
    total_waits,
    ROUND(time_waited / 100, 2) AS time_waited_seconds,
    ROUND(
        CASE
            WHEN total_waits &gt; 0
            THEN time_waited / total_waits / 100
        END,
        4
    ) AS avg_wait_seconds
FROM v$system_event
ORDER BY time_waited DESC
FETCH FIRST 30 ROWS ONLY;</code></pre>

      </div>


      <div class="resource-block">

        <div class="resource-block__header">
          <div>
            <div class="resource-block__label">02 &middot; CURRENT WAITS</div>

            <h2>
              Find sessions currently waiting
            </h2>
          </div>
        </div>

        <p class="resource-block__description">
          Identify active sessions currently waiting and review the
          associated event, wait class and SQL ID.
        </p>

        <pre><code>SELECT
    sid,
    serial#,
    username,
    sql_id,
    event,
    wait_class,
    state,
    seconds_in_wait
FROM v$session
WHERE status = 'ACTIVE'
  AND state = 'WAITING'
ORDER BY seconds_in_wait DESC;</code></pre>

      </div>


      <div class="resource-block">

        <div class="resource-block__header">
          <div>
            <div class="resource-block__label">03 &middot; BLOCKING</div>

            <h2>
              Investigate blocking relationships
            </h2>
          </div>
        </div>

        <p class="resource-block__description">
          Review sessions that have identified blocking sessions.
          Correlate the blocker and waiter with SQL and application
          information before taking operational action.
        </p>

        <pre><code>SELECT
    sid,
    serial#,
    username,
    sql_id,
    blocking_session,
    final_blocking_session,
    event,
    wait_class,
    seconds_in_wait
FROM v$session
WHERE blocking_session IS NOT NULL
ORDER BY seconds_in_wait DESC;</code></pre>

      </div>


      <div class="resource-block">

        <div class="resource-block__header">
          <div>
            <div class="resource-block__label">04 &middot; LONG OPERATIONS</div>

            <h2>
              Review long-running operations
            </h2>
          </div>
        </div>

        <p class="resource-block__description">
          V$SESSION_LONGOPS can expose operations that have reported
          measurable progress. Review elapsed time and remaining work
          when investigating long-running database activity.
        </p>

        <pre><code>SELECT
    sid,
    serial#,
    opname,
    target,
    sofar,
    totalwork,
    units,
    elapsed_seconds,
    time_remaining,
    sql_id
FROM v$session_longops
WHERE totalwork &gt; 0
  AND sofar &lt; totalwork
ORDER BY elapsed_seconds DESC;</code></pre>

      </div>


      <div class="resource-block">

        <div class="resource-block__header">
          <div>
            <div class="resource-block__label">05 &middot; SESSION WAITS</div>

            <h2>
              Review wait activity by wait class
            </h2>
          </div>
        </div>

        <p class="resource-block__description">
          Summarize currently waiting sessions by wait class to get a
          quick indication of the types of activity represented in the
          current workload.
        </p>

        <pre><code>SELECT
    wait_class,
    COUNT(*) AS waiting_sessions
FROM v$session
WHERE status = 'ACTIVE'
  AND state = 'WAITING'
GROUP BY wait_class
ORDER BY waiting_sessions DESC;</code></pre>

      </div>


      <div class="resource-block">

        <div class="resource-block__header">
          <div>
            <div class="resource-block__label">06 &middot; INVESTIGATION START</div>

            <h2>
              Establish a diagnostic starting point
            </h2>
          </div>
        </div>

        <p class="resource-block__description">
          Combine session activity, SQL identifiers and wait information
          to establish which sessions and SQL statements deserve deeper
          investigation.
        </p>

        <pre><code>SELECT
    s.sid,
    s.serial#,
    s.username,
    s.status,
    s.sql_id,
    s.event,
    s.wait_class,
    s.state,
    s.seconds_in_wait,
    s.blocking_session
FROM v$session s
WHERE s.status = 'ACTIVE'
  AND s.username IS NOT NULL
ORDER BY
    s.wait_class,
    s.seconds_in_wait DESC;</code></pre>

      </div></div>


      <div class="resource-note">

        <div class="eyebrow">ORASOLU TOOLBOX &middot; SQL &amp; DATABASE</div>

        <h2>
          Diagnose the workload, not just the symptom.
        </h2>

        <p>
          Wait events, blocking sessions and long-running operations
          are diagnostic clues. Correlate them with SQL, sessions,
          workload, historical behaviour and application activity
          before deciding what the underlying problem is.
        </p>

      </div>


      <div class="resource-actions">

        <a class="button button--primary" href="/tools/sql/">
          Back to SQL & Database
        </a>

        <a class="resource-actions__link" href="/articles/oracle-wait-events/">
          Read Understanding Oracle Wait Events
        </a>

      </div>

    </div>
  </section>

</BaseLayout>


<style>

  .resource-section {
  padding-top: 56px;
  padding-bottom: 72px;
}

  .resource-intro {
    max-width: 820px;
    margin-bottom: 36px;
  }

  .resource-intro h2 {
    margin: 0 0 14px;
    color: var(--ink);
    font-size: clamp(28px, 3vw, 38px);
    line-height: 1.15;
  }

  .resource-intro p {
    margin: 0;
    color: var(--muted);
    font-size: 16px;
    line-height: 1.75;
  }

  .resource-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 22px;
}

.resource-block {
        margin-bottom: 0;
    padding: 30px;
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: 18px;
  }

  .resource-block__header {
    margin-bottom: 12px;
  }

  .resource-block__label {
    margin-bottom: 9px;
    color: var(--orange);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.14em;
    line-height: 1.2;
  }

  .resource-block h2 {
    margin: 0;
    color: var(--ink);
    font-size: 22px;
    line-height: 1.3;
  }

  .resource-block__description {
    max-width: 820px;
    margin: 0 0 22px;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.7;
  }

  .resource-block pre {
    position: relative;
    margin: 0;
    padding: 22px;
    overflow-x: auto;
    background: #2f353d;
    border-radius: 10px;
    color: #f3f4f6;
    font-family:
      "Cascadia Code",
      "Consolas",
      "Courier New",
      monospace;
    font-size: 13px;
    line-height: 1.7;
  }

  .resource-block code {
    font-family: inherit;
  }

  .resource-note {
    max-width: 820px;
    margin-top: 56px;
    padding: 30px;
    background: #f7f8fa;
    border: 1px solid var(--line);
    border-radius: 18px;
  }

  .resource-note h2 {
    margin: 0 0 14px;
    color: var(--ink);
    font-size: clamp(24px, 3vw, 32px);
    line-height: 1.2;
  }

  .resource-note p {
    margin: 0;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.75;
  }

  .resource-actions {
    display: flex;
    align-items: center;
    gap: 24px;
    margin-top: 32px;
  }

  .resource-actions__link {
    color: var(--orange);
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
  }

  .resource-actions__link:hover {
    text-decoration: underline;
  }

  @media (max-width: 820px) {
  .resource-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 680px) {

    .resource-section {
  padding-top: 56px;
  padding-bottom: 72px;
}

    .resource-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 22px;
}

.resource-block {
          padding: 22px;
      border-radius: 16px;
    }

    .resource-block pre {
      padding: 18px;
      font-size: 12px;
    }

    .resource-actions {
      align-items: flex-start;
      flex-direction: column;
      gap: 18px;
    }

  }


  /* ORASOLU TOOLBOX - STANDARD RESOURCE SYSTEM */

  .resource-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 22px;
    align-items: start;
  }

  .resource-block {
    display: flex;
    flex-direction: column;
    min-width: 0;
    margin: 0;
    padding: 30px;
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: 18px;
    transition:
      border-color 0.22s ease,
      box-shadow 0.22s ease,
      transform 0.22s ease;
  }

  .resource-block:hover {
    border-color: #d8dce1;
    box-shadow: 0 12px 30px rgba(17, 29, 44, 0.06);
    transform: translateY(-3px);
  }

  .resource-block__header {
    margin-bottom: 10px;
  }

  .resource-block__label {
    margin-bottom: 9px;
    color: var(--orange);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.14em;
    line-height: 1.2;
  }

  .resource-block h2 {
    margin: 0;
    color: var(--ink);
    font-size: 22px;
    line-height: 1.3;
  }

  .resource-block__description {
    min-height: 48px;
    margin: 0 0 22px;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.7;
  }

  .resource-block pre {
    position: relative;
    margin: 0;
    padding: 22px;
    overflow-x: auto;
    background: #2f353d;
    border-radius: 10px;
    color: #f3f4f6;
    font-family:
      "Cascadia Code",
      "Consolas",
      "Courier New",
      monospace;
    font-size: 13px;
    line-height: 1.7;
  }

  .resource-block code {
    font-family: inherit;
  }

  .resource-copy-button {
    position: absolute;
    top: 10px;
    right: 10px;
    padding: 5px 9px;
    border: 1px solid #d1d5db;
    border-radius: 5px;
    background: #ffffff;
    color: #374151;
    font-family: inherit;
    font-size: 0.75rem;
    cursor: pointer;
    z-index: 2;
  }

  .resource-copy-button:hover {
    background: #f3f4f6;
  }

  @media (max-width: 820px) {
    .resource-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 680px) {
    .resource-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .resource-block {
      padding: 22px;
      border-radius: 16px;
    }

    .resource-block__description {
      min-height: 0;
    }

    .resource-block pre {
      padding: 18px;
      font-size: 12px;
    }
  }

  /* ORASOLU TOOLBOX - STANDARD RESOURCE CARD SIZE */

  .resource-block {
    height: 560px;
    box-sizing: border-box;
    overflow: hidden;
  }

  .resource-block pre {
    flex: 1 1 auto;
    min-height: 0;
    overflow-x: auto;
    overflow-y: auto;
    white-space: pre;
  }

  .resource-block code {
    white-space: pre;
  }

  @media (max-width: 680px) {
    .resource-block {
      height: 520px;
    }
  }
</style>


<script>
  document.querySelectorAll(".resource-block pre").forEach((pre) => {
    const button = document.createElement("button");

    button.type = "button";
    button.className = "resource-copy-button";
    button.textContent = "Copy";
    button.setAttribute("aria-label", "Copy SQL");

    pre.style.position = "relative";

    button.style.position = "absolute";
    button.style.top = "10px";
    button.style.right = "10px";
    button.style.padding = "5px 9px";
    button.style.border = "1px solid #d1d5db";
    button.style.borderRadius = "5px";
    button.style.background = "#ffffff";
    button.style.color = "#374151";
    button.style.fontFamily = "inherit";
    button.style.fontSize = "0.75rem";
    button.style.cursor = "pointer";
    button.style.zIndex = "2";

    button.addEventListener("click", async () => {
      const code = pre.querySelector("code");

      if (!code) {
        return;
      }

      try {
        await navigator.clipboard.writeText(code.textContent || "");

        button.textContent = "Copied";

        window.setTimeout(() => {
          button.textContent = "Copy";
        }, 1500);
      } catch {
        button.textContent = "Copy failed";

        window.setTimeout(() => {
          button.textContent = "Copy";
        }, 1500);
      }
    });

    pre.appendChild(button);
  });
</script>
