---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
---

<BaseLayout>

  <section class="page-hero">
    <div class="container">

      <div class="eyebrow">ORASOLU TOOLBOX &middot; SQL &amp; DATABASE</div>

      <h1>
        Tablespace <span>Information</span>
      </h1>

      <p>
        Practical Oracle SQL for reviewing tablespace usage, datafiles,
        free space and storage capacity.
      </p>

    </div>
  </section>


  <section class="section resource-section">
    <div class="container">

      <div class="resource-intro">

        <div class="eyebrow">ORASOLU TOOLBOX &middot; SQL &amp; DATABASE</div>

        <h2>
          Understand database storage at a glance
        </h2>

        <p>
          These queries provide a practical starting point for
          reviewing tablespace capacity, datafile configuration and
          available space in an Oracle database.
        </p>

      </div>


      <div class="resource-grid">


      <div class="resource-block">

        <div class="resource-block__header">
          <div>
            <div class="resource-block__label">01 &middot; TABLESPACE USAGE</div>

            <h2>
              Review tablespace usage
            </h2>
          </div>
        </div>

        <p class="resource-block__description">
          Use this query to review allocated space, free space and
          percentage used for permanent tablespaces.
        </p>

        <pre><code>SELECT
    tablespace_name,
    ROUND(SUM(bytes) / 1024 / 1024 / 1024, 2) AS allocated_gb,
    ROUND(SUM(maxbytes) / 1024 / 1024 / 1024, 2) AS max_gb,
    ROUND(
        (SUM(bytes) - SUM(free_bytes))
        / NULLIF(SUM(bytes), 0) * 100,
        2
    ) AS used_pct
FROM (
    SELECT
        df.tablespace_name,
        df.bytes,
        df.maxbytes,
        NVL(fs.free_bytes, 0) AS free_bytes
    FROM dba_data_files df
    LEFT JOIN (
        SELECT
            tablespace_name,
            SUM(bytes) AS free_bytes
        FROM dba_free_space
        GROUP BY tablespace_name
    ) fs
        ON fs.tablespace_name = df.tablespace_name
)
GROUP BY tablespace_name
ORDER BY used_pct DESC;</code></pre>

      </div>


      <div class="resource-block">

        <div class="resource-block__header">
          <div>
            <div class="resource-block__label">02 &middot; DATAFILES</div>

            <h2>
              Review datafile configuration
            </h2>
          </div>
        </div>

        <p class="resource-block__description">
          Review datafile size, maximum size and autoextend configuration
          to understand how individual files are configured.
        </p>

        <pre><code>SELECT
    file_id,
    file_name,
    tablespace_name,
    ROUND(bytes / 1024 / 1024 / 1024, 2) AS size_gb,
    autoextensible,
    ROUND(maxbytes / 1024 / 1024 / 1024, 2) AS max_size_gb
FROM dba_data_files
ORDER BY tablespace_name, file_id;</code></pre>

      </div>


      <div class="resource-block">

        <div class="resource-block__header">
          <div>
            <div class="resource-block__label">03 &middot; FREE SPACE</div>

            <h2>
              Review free space by tablespace
            </h2>
          </div>
        </div>

        <p class="resource-block__description">
          This query summarizes free extents recorded in
          DBA_FREE_SPACE and helps identify where free space is
          currently available.
        </p>

        <pre><code>SELECT
    tablespace_name,
    ROUND(SUM(bytes) / 1024 / 1024 / 1024, 2) AS free_gb,
    COUNT(*) AS free_extents
FROM dba_free_space
GROUP BY tablespace_name
ORDER BY free_gb DESC;</code></pre>

      </div>


      <div class="resource-block">

        <div class="resource-block__header">
          <div>
            <div class="resource-block__label">04 &middot; AUTOEXTEND</div>

            <h2>
              Find datafiles with autoextend enabled
            </h2>
          </div>
        </div>

        <p class="resource-block__description">
          Autoextend can provide additional capacity automatically.
          Review the maximum configured size as part of capacity
          planning and operational checks.
        </p>

        <pre><code>SELECT
    file_id,
    file_name,
    tablespace_name,
    ROUND(bytes / 1024 / 1024 / 1024, 2) AS size_gb,
    ROUND(maxbytes / 1024 / 1024 / 1024, 2) AS max_size_gb,
    autoextensible
FROM dba_data_files
WHERE autoextensible = 'YES'
ORDER BY tablespace_name, file_id;</code></pre>

      </div>


      <div class="resource-block">

        <div class="resource-block__header">
          <div>
            <div class="resource-block__label">05 &middot; CAPACITY</div>

            <h2>
              Identify datafiles approaching their maximum size
            </h2>
          </div>
        </div>

        <p class="resource-block__description">
          Compare the current datafile size with its configured
          maximum size to identify files with limited remaining
          autoextend capacity.
        </p>

        <pre><code>SELECT
    file_id,
    file_name,
    tablespace_name,
    ROUND(bytes / 1024 / 1024 / 1024, 2) AS size_gb,
    ROUND(maxbytes / 1024 / 1024 / 1024, 2) AS max_size_gb,
    ROUND(
        CASE
            WHEN maxbytes &gt; 0
            THEN bytes / maxbytes * 100
        END,
        2
    ) AS max_size_pct
FROM dba_data_files
WHERE maxbytes &gt; 0
ORDER BY max_size_pct DESC;</code></pre>

      </div></div>


      <div class="resource-note">

        <div class="eyebrow">ORASOLU TOOLBOX &middot; SQL &amp; DATABASE</div>

        <h2>
          Capacity is more than percentage used.
        </h2>

        <p>
          A tablespace percentage alone does not describe the complete
          storage situation. Datafile limits, autoextend configuration,
          underlying filesystem or ASM capacity and expected growth
          should also be considered during capacity investigation.
        </p>

      </div>


      <div class="resource-actions">

        <a class="button button--primary" href="/tools/sql/">
          Back to SQL & Database
        </a>

        <a class="resource-actions__link" href="/tools/sql/session-activity/">
          Session Activity
        </a>

      </div>

    </div>
  </section>

</BaseLayout>


<style>

  .resource-section {
  padding-top: 56px;
  padding-bottom: 72px;
}


  .resource-intro {
    max-width: 820px;
    margin-bottom: 36px;
  }


  .resource-intro h2 {
    margin: 0 0 14px;

    color: var(--ink);

    font-size: clamp(28px, 3vw, 38px);
    line-height: 1.15;
  }


  .resource-intro p {
    margin: 0;

    color: var(--muted);

    font-size: 16px;
    line-height: 1.75;
  }


  .resource-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 22px;
}

.resource-block {
        margin-bottom: 0;
    padding: 30px;

    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: 18px;
  }


  .resource-block__header {
    margin-bottom: 12px;
  }


  .resource-block__label {
    margin-bottom: 9px;

    color: var(--orange);

    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.14em;
    line-height: 1.2;
  }


  .resource-block h2 {
    margin: 0;

    color: var(--ink);

    font-size: 22px;
    line-height: 1.3;
  }


  .resource-block__description {
    max-width: 820px;
    margin: 0 0 22px;

    color: var(--muted);

    font-size: 14px;
    line-height: 1.7;
  }


  .resource-block pre {
    position: relative;

    margin: 0;
    padding: 22px;

    overflow-x: auto;

    background: #2f353d;
    border-radius: 10px;

    color: #f3f4f6;

    font-family:
      "Cascadia Code",
      "Consolas",
      "Courier New",
      monospace;

    font-size: 13px;
    line-height: 1.7;
  }


  .resource-block code {
    font-family: inherit;
  }


  .resource-note {
    max-width: 820px;
    margin-top: 56px;
    padding: 30px;

    background: #f7f8fa;
    border: 1px solid var(--line);
    border-radius: 18px;
  }


  .resource-note h2 {
    margin: 0 0 14px;

    color: var(--ink);

    font-size: clamp(24px, 3vw, 32px);
    line-height: 1.2;
  }


  .resource-note p {
    margin: 0;

    color: var(--muted);

    font-size: 15px;
    line-height: 1.75;
  }


  .resource-actions {
    display: flex;
    align-items: center;
    gap: 24px;

    margin-top: 32px;
  }


  .resource-actions__link {
    color: var(--orange);

    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
  }


  .resource-actions__link:hover {
    text-decoration: underline;
  }


  @media (max-width: 820px) {
  .resource-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 680px) {

    .resource-section {
  padding-top: 56px;
  padding-bottom: 72px;
}

    .resource-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 22px;
}

.resource-block {
          padding: 22px;
      border-radius: 16px;
    }

    .resource-block pre {
      padding: 18px;

      font-size: 12px;
    }

    .resource-actions {
      align-items: flex-start;
      flex-direction: column;
      gap: 18px;
    }

  }


  /* ORASOLU TOOLBOX - STANDARD RESOURCE SYSTEM */

  .resource-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 22px;
    align-items: start;
  }

  .resource-block {
    display: flex;
    flex-direction: column;
    min-width: 0;
    margin: 0;
    padding: 30px;
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: 18px;
    transition:
      border-color 0.22s ease,
      box-shadow 0.22s ease,
      transform 0.22s ease;
  }

  .resource-block:hover {
    border-color: #d8dce1;
    box-shadow: 0 12px 30px rgba(17, 29, 44, 0.06);
    transform: translateY(-3px);
  }

  .resource-block__header {
    margin-bottom: 10px;
  }

  .resource-block__label {
    margin-bottom: 9px;
    color: var(--orange);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.14em;
    line-height: 1.2;
  }

  .resource-block h2 {
    margin: 0;
    color: var(--ink);
    font-size: 22px;
    line-height: 1.3;
  }

  .resource-block__description {
    min-height: 48px;
    margin: 0 0 22px;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.7;
  }

  .resource-block pre {
    position: relative;
    margin: 0;
    padding: 22px;
    overflow-x: auto;
    background: #2f353d;
    border-radius: 10px;
    color: #f3f4f6;
    font-family:
      "Cascadia Code",
      "Consolas",
      "Courier New",
      monospace;
    font-size: 13px;
    line-height: 1.7;
  }

  .resource-block code {
    font-family: inherit;
  }

  .resource-copy-button {
    position: absolute;
    top: 10px;
    right: 10px;
    padding: 5px 9px;
    border: 1px solid #d1d5db;
    border-radius: 5px;
    background: #ffffff;
    color: #374151;
    font-family: inherit;
    font-size: 0.75rem;
    cursor: pointer;
    z-index: 2;
  }

  .resource-copy-button:hover {
    background: #f3f4f6;
  }

  @media (max-width: 820px) {
    .resource-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 680px) {
    .resource-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .resource-block {
      padding: 22px;
      border-radius: 16px;
    }

    .resource-block__description {
      min-height: 0;
    }

    .resource-block pre {
      padding: 18px;
      font-size: 12px;
    }
  }

  /* ORASOLU TOOLBOX - STANDARD RESOURCE CARD SIZE */

  .resource-block {
    height: 560px;
    box-sizing: border-box;
    overflow: hidden;
  }

  .resource-block pre {
    flex: 1 1 auto;
    min-height: 0;
    overflow-x: auto;
    overflow-y: auto;
    white-space: pre;
  }

  .resource-block code {
    white-space: pre;
  }

  @media (max-width: 680px) {
    .resource-block {
      height: 520px;
    }
  }
</style>


<script>
  document.querySelectorAll(".resource-block pre").forEach((pre) => {
    const button = document.createElement("button");

    button.type = "button";
    button.className = "resource-copy-button";
    button.textContent = "Copy";
    button.setAttribute("aria-label", "Copy SQL");

    pre.style.position = "relative";

    button.style.position = "absolute";
    button.style.top = "10px";
    button.style.right = "10px";
    button.style.padding = "5px 9px";
    button.style.border = "1px solid #d1d5db";
    button.style.borderRadius = "5px";
    button.style.background = "#ffffff";
    button.style.color = "#374151";
    button.style.fontFamily = "inherit";
    button.style.fontSize = "0.75rem";
    button.style.cursor = "pointer";
    button.style.zIndex = "2";

    button.addEventListener("click", async () => {
      const code = pre.querySelector("code");

      if (!code) {
        return;
      }

      try {
        await navigator.clipboard.writeText(code.textContent || "");

        button.textContent = "Copied";

        window.setTimeout(() => {
          button.textContent = "Copy";
        }, 1500);
      } catch {
        button.textContent = "Copy failed";

        window.setTimeout(() => {
          button.textContent = "Copy";
        }, 1500);
      }
    });

    pre.appendChild(button);
  });
</script>
