---
import BaseLayout from "../../../layouts/BaseLayout.astro";
---

<BaseLayout>

  <section class="page-hero">
    <div class="container">

      <div class="eyebrow">ORASOLU TOOLBOX &middot; DATABASE</div>

      <h1>
        SQL & <span>Database</span>
      </h1>

      <p>
        Practical Oracle SQL scripts, metadata queries and everyday
        database administration resources.
      </p>

    </div>
  </section>


  <section class="section sql-tools-section">
    <div class="container">

      <div class="section-intro">
        <div>
          <div class="eyebrow">ORASOLU TOOLBOX &middot; DATABASE</div>

          <h2>
            Practical SQL for everyday database work
          </h2>

          <p>
            A collection of reusable queries and database utilities
            for investigation, administration and troubleshooting.
          </p>
        </div>
      </div>


      <div class="sql-resource-grid">

        <a href="/tools/sql/session-activity/" class="sql-resource-card">

          <div class="sql-resource-card__label">
            SESSION
          </div>

          <h3>
            Session Activity
          </h3>

          <p>
            Queries for reviewing active sessions, users, status,
            wait information and current database activity.
          </p>

          <span class="sql-resource-card__action">
            Explore
          </span>

        </a>


        <a href="/tools/sql/tablespace-information/" class="sql-resource-card">

          <div class="sql-resource-card__label">
            STORAGE
          </div>

          <h3>
            Tablespace Information
          </h3>

          <p>
            Useful queries for reviewing tablespaces, datafiles,
            allocated space and database storage.
          </p>

          <span class="sql-resource-card__action">
            Explore
          </span>

        </a>


        <a href="/tools/sql/database-objects/" class="sql-resource-card">

          <div class="sql-resource-card__label">
            OBJECTS
          </div>

          <h3>
            Database Objects
          </h3>

          <p>
            Metadata queries for schemas, tables, indexes,
            invalid objects and other database structures.
          </p>

          <span class="sql-resource-card__action">
            Explore
          </span>

        </a>


        <a href="/tools/sql/sql-investigation/" class="sql-resource-card">

          <div class="sql-resource-card__label">
            SQL
          </div>

          <h3>
            SQL Investigation
          </h3>

          <p>
            Practical queries for investigating SQL activity,
            execution information and database workload.
          </p>

          <span class="sql-resource-card__action">
            Explore
          </span>

        </a>


        <a href="/tools/sql/dba-utilities/" class="sql-resource-card">

          <div class="sql-resource-card__label">
            ADMINISTRATION
          </div>

          <h3>
            DBA Utilities
          </h3>

          <p>
            Everyday database administration queries and
            operational checks for Oracle environments.
          </p>

          <span class="sql-resource-card__action">
            Explore
          </span>

        </a>


        <a href="/tools/sql/database-diagnostics/" class="sql-resource-card">

          <div class="sql-resource-card__label">
            DIAGNOSTICS
          </div>

          <h3>
            Database Diagnostics
          </h3>

          <p>
            Queries that help establish what is happening inside
            an Oracle database before deeper investigation.
          </p>

          <span class="sql-resource-card__action">
            Explore
          </span>

        </a>

      </div>

    </div>
  </section>


  <section class="section section--soft">
    <div class="container">

      <div class="sql-tools-note">

        <div class="eyebrow">ORASOLU TOOLBOX &middot; DATABASE</div>

        <h2>
          More database resources will be added over time.
        </h2>

        <p>
          The SQL toolbox will grow with reusable Oracle queries,
          scripts, troubleshooting utilities and operational
          resources developed from real-world database work.
        </p>

        <a class="button button--primary" href="/tools/">
          Back to Tools
        </a>

      </div>

    </div>
  </section>

</BaseLayout>


<style>

  .sql-tools-section {
    padding-top: 72px;
    padding-bottom: 88px;
  }


  .section-intro {
    margin-bottom: 42px;
  }


  .section-intro h2 {
    margin: 0 0 14px;
    font-size: clamp(28px, 3vw, 38px);
    line-height: 1.15;
    color: var(--ink);
  }


  .section-intro p {
    max-width: 760px;
    margin: 0;
    color: var(--muted);
    font-size: 16px;
    line-height: 1.7;
  }


  .sql-resource-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
  }


  .sql-resource-card {
    display: block;

    min-height: 220px;
    padding: 28px;

    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: 18px;

    color: inherit;
    text-decoration: none;

    cursor: pointer;

    transition:
      border-color 0.22s ease,
      box-shadow 0.22s ease,
      transform 0.22s ease,
      background-color 0.22s ease;
  }


  .sql-resource-card:hover {
  border-color: var(--orange);
  box-shadow: 0 10px 24px rgba(17, 29, 44, 0.08);
  transform: translateY(-2px);
}


  .sql-resource-card h3 {
    transition:
      color 0.22s ease,
      transform 0.22s ease;
  }


  .sql-resource-card:hover h3 {
  color: var(--orange);
}


  .sql-resource-card__action {
    transition:
      color 0.22s ease,
      transform 0.22s ease;
  }


  .sql-resource-card:hover .sql-resource-card__action {
  color: var(--orange);
}


  .sql-resource-card__label {
    margin-bottom: 12px;

    color: var(--orange);

    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.14em;
    line-height: 1.2;
  }


  .sql-resource-card h3 {
    margin: 0 0 12px;

    color: var(--ink);

    font-size: 20px;
    font-weight: 750;
    line-height: 1.25;
  }


  .sql-resource-card p {
    margin: 0 0 22px;

    color: var(--muted);

    font-size: 14px;
    line-height: 1.65;
  }


  .sql-resource-card__action {
    display: inline-block;

    color: var(--orange);

    font-size: 14px;
    font-weight: 700;
  }


  .sql-tools-note {
    max-width: 820px;
  }


  .sql-tools-note h2 {
    margin: 0 0 14px;

    color: var(--ink);

    font-size: clamp(28px, 3vw, 38px);
    line-height: 1.15;
  }


  .sql-tools-note p {
    max-width: 760px;
    margin: 0 0 28px;

    color: var(--muted);

    font-size: 16px;
    line-height: 1.75;
  }


  @media (max-width: 980px) {

    .sql-resource-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

  }


  @media (max-width: 680px) {

    .sql-tools-section {
      padding-top: 52px;
      padding-bottom: 64px;
    }

    .sql-resource-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .sql-resource-card {
      min-height: auto;
      padding: 22px;
      border-radius: 16px;
    }

  }

</style>