---
import BaseLayout from "../../../layouts/BaseLayout.astro";
---

<BaseLayout>

  <section class="page-hero">
    <div class="container">

      <div class="eyebrow">ORASOLU TOOLBOX &middot; AUTOMATION & DEVOPS</div>

      <h1>
        Automation <span>& DevOps</span>
      </h1>

      <p>
        Practical Oracle resources for automation, shell and CLI workflows, scheduled jobs, monitoring and DevOps operations.
      </p>

    </div>
  </section>


  <section class="section performance-section">
    <div class="container">

      <div class="section-intro performance-intro">
        <div>
          <div class="eyebrow">ORASOLU TOOLBOX &middot; AUTOMATION & DEVOPS</div>

          <h2>
            Practical automation & DevOps workflows
          </h2>

          <p>
            A growing collection of practical resources for automating recurring database tasks,
            operational checks, monitoring workflows and repeatable delivery processes.
          </p>
        </div>
      </div>


      <div class="performance-resource-grid">

        <a href="/tools/automation/shell-cli/" class="performance-resource-card">

          <div class="performance-resource-card__label">
            SHELL & CLI
          </div>

          <h3>
            Shell & CLI
          </h3>

          <p>
            Practical command-line workflows for Oracle administration, Linux operations and repeatable troubleshooting.
          </p>

          <span class="performance-resource-card__action">
            Explore
          </span>

        </a>


        <a href="/tools/automation/oracle-automation/" class="performance-resource-card">

          <div class="performance-resource-card__label">
            ORACLE AUTOMATION
          </div>

          <h3>
            Oracle Automation
          </h3>

          <p>
            Automate recurring Oracle administration tasks and operational workflows.
          </p>

          <span class="performance-resource-card__action">
            Explore
          </span>

        </a>


        <a href="/tools/automation/scheduled-jobs/" class="performance-resource-card">

          <div class="performance-resource-card__label">
            SCHEDULED JOBS
          </div>

          <h3>
            Scheduled Jobs
          </h3>

          <p>
            Review and manage scheduled database jobs and their operational activity.
          </p>

          <span class="performance-resource-card__action">
            Explore
          </span>

        </a>


        <a href="/tools/automation/monitoring-automation/" class="performance-resource-card">

          <div class="performance-resource-card__label">
            MONITORING
          </div>

          <h3>
            Monitoring Automation
          </h3>

          <p>
            Turn repeatable database checks into practical monitoring and operational workflows.
          </p>

          <span class="performance-resource-card__action">
            Explore
          </span>

        </a>


        <a href="/tools/automation/devops-workflows/" class="performance-resource-card">

          <div class="performance-resource-card__label">
            DEVOPS
          </div>

          <h3>
            DevOps Workflows
          </h3>

          <p>
            Integrate database changes, validation and operational tasks into repeatable DevOps workflows.
          </p>

          <span class="performance-resource-card__action">
            Explore
          </span>

        </a>


        <a href="/tools/automation/automation-diagnostics/" class="performance-resource-card">

          <div class="performance-resource-card__label">
            DIAGNOSTICS
          </div>

          <h3>
            Automation Diagnostics
          </h3>

          <p>
            A structured starting point for investigating failed jobs, scripts and automation workflows.
          </p>

          <span class="performance-resource-card__action">
            Explore
          </span>

        </a>

      </div>

    </div>
  </section>


  <section class="section section--soft">
    <div class="container">

      <div class="performance-note">

        <div class="eyebrow">ORASOLU TOOLBOX &middot; AUTOMATION & DEVOPS</div>

        <h2>
          Automation should make operations repeatable.
        </h2>

        <p>
          Start with a clear operational task, make the steps repeatable and add validation
          so the automation can be trusted in day-to-day operations.
        </p>

        <a class="button button--primary" href="/tools/">
          Back to Tools
        </a>

      </div>

    </div>
  </section>

<style>

  .performance-section {
    padding-top: 56px;
    padding-bottom: 64px;
  }


  .performance-intro {
    margin-bottom: 32px;
  }


  .performance-intro h2 {
    margin: 0 0 14px;
    font-size: clamp(28px, 3vw, 38px);
    line-height: 1.15;
    color: var(--ink);
  }


  .performance-intro p {
    max-width: 760px;
    margin: 0;
    color: var(--muted);
    font-size: 16px;
    line-height: 1.7;
  }


  .performance-resource-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
  }


  .performance-resource-card {
    display: block;

    min-height: 220px;
    padding: 28px;

    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: 18px;

    color: inherit;
    text-decoration: none;

    cursor: pointer;

    transition:
      border-color 0.22s ease,
      box-shadow 0.22s ease,
      transform 0.22s ease,
      background-color 0.22s ease;
  }


  .performance-resource-card:hover {
  border-color: var(--orange);
  box-shadow: 0 10px 24px rgba(17, 29, 44, 0.08);
  transform: translateY(-2px);
}


  .performance-resource-card__label {
    margin-bottom: 12px;

    color: var(--orange);

    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.14em;
    line-height: 1.2;
  }


  .performance-resource-card h3 {
    margin: 0 0 12px;

    color: var(--ink);

    font-size: 20px;
    font-weight: 750;
    line-height: 1.25;

    transition:
      color 0.22s ease,
      transform 0.22s ease;
  }


  .performance-resource-card:hover h3 {
    color: var(--orange);
    transform: none;
  }


  .performance-resource-card p {
    margin: 0 0 22px;

    color: var(--muted);

    font-size: 14px;
    line-height: 1.65;
  }


  .performance-resource-card__action {
    display: inline-block;

    color: var(--orange);

    font-size: 14px;
    font-weight: 700;

    transition:
      color 0.22s ease,
      transform 0.22s ease;
  }


  .performance-resource-card:hover .performance-resource-card__action {
    color: var(--orange);
    transform: none;
  }


  .performance-note {
    max-width: 820px;
  }


  .performance-note h2 {
    margin: 0 0 14px;

    color: var(--ink);

    font-size: clamp(28px, 3vw, 38px);
    line-height: 1.15;
  }


  .performance-note p {
    max-width: 760px;
    margin: 0 0 28px;

    color: var(--muted);

    font-size: 16px;
    line-height: 1.75;
  }


  @media (max-width: 980px) {

    .performance-resource-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

  }


  @media (max-width: 680px) {

    .performance-section {
      padding-top: 52px;
      padding-bottom: 64px;
    }

    .performance-intro {
      margin-bottom: 30px;
    }

    .performance-resource-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .performance-resource-card {
      min-height: auto;
      padding: 22px;
      border-radius: 16px;
    }

  }

</style>
</BaseLayout>
