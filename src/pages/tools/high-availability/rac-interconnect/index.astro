---
import BaseLayout from "../../../../layouts/BaseLayout.astro";

const resources = [
  {
    label: "01 · INTERCONNECT SETTINGS",
    title: "Review RAC interconnects",
    description:
      "Inspect the network interfaces Oracle is using for cluster communication on each RAC instance.",
    sql: `SELECT
    inst_id,
    name,
    ip_address,
    is_public,
    source,
    transport
FROM gv$cluster_interconnects
ORDER BY
    inst_id,
    name;`,
  },
  {
    label: "02 · CONFIGURED INTERCONNECTS",
    title: "Review configured interfaces",
    description:
      "Compare the interconnect interfaces Oracle is aware of and where their configuration information came from.",
    sql: `SELECT
    inst_id,
    name,
    ip_address,
    is_public,
    source
FROM gv$configured_interconnects
ORDER BY
    inst_id,
    name;`,
  },
  {
    label: "03 · GES MESSAGING",
    title: "Review global enqueue messaging",
    description:
      "Inspect GES message statistics that provide context for inter-instance messaging activity.",
    sql: `SELECT
    inst_id,
    name,
    value
FROM gv$ges_statistics
WHERE name IN (
    'messages sent directly',
    'messages flow controlled',
    'messages sent indirectly',
    'messages received',
    'flow control messages sent',
    'flow control messages received'
)
ORDER BY
    inst_id,
    name;`,
  },
  {
    label: "04 · CR BLOCK SERVICE",
    title: "Review CR block service activity",
    description:
      "Inspect Global Cache Service statistics for remote consistent-read and current block requests handled by LMS processes.",
    sql: `SELECT
    inst_id,
    cr_requests,
    current_requests,
    data_requests,
    undo_requests,
    tx_requests,
    other_requests
FROM gv$cr_block_server
ORDER BY inst_id;`,
  },
  {
    label: "05 · CURRENT BLOCK SERVICE",
    title: "Review current block processing",
    description:
      "Review LMS pin and flush timing buckets to understand current-block processing activity by instance.",
    sql: `SELECT
    inst_id,
    pin0,
    pin1,
    pin10,
    pin100,
    pin1000,
    pin10000,
    flush0,
    flush1,
    flush10,
    flush100,
    flush1000,
    flush10000
FROM gv$current_block_server
ORDER BY inst_id;`,
  },
  {
    label: "06 · GLOBAL CACHE WAITS",
    title: "Review global cache wait events",
    description:
      "Compare RAC global cache wait events across instances and identify where time is being spent waiting for Cache Fusion activity.",
    sql: `SELECT
    inst_id,
    event,
    total_waits,
    ROUND(time_waited / 100, 2) AS wait_seconds
FROM gv$system_event
WHERE event LIKE 'gc %'
ORDER BY
    time_waited DESC
FETCH FIRST 20 ROWS ONLY;`,
  },
];
---

<BaseLayout
  title="RAC Interconnect"
  description="Practical Oracle RAC SQL for reviewing interconnect configuration, GES messaging, Cache Fusion block service and global cache waits."
>
  <section class="resource-hero">
    <div class="container">
      <p class="eyebrow">ORASOLU TOOLBOX · HIGH AVAILABILITY</p>
      <h1>RAC Interconnect</h1>
      <p>
        Practical Oracle RAC SQL for reviewing interconnect configuration, GES
        messaging, Cache Fusion block service and global cache waits.
      </p>
    </div>
  </section>

  <section class="resource-section">
    <div class="container">
      <div class="resource-intro">
        <p class="eyebrow">ORASOLU TOOLBOX · HIGH AVAILABILITY</p>
        <h2>Understand inter-instance communication and Cache Fusion</h2>
        <p>
          Review the RAC interconnect configuration, messaging activity,
          Global Cache Service processing and global cache wait events to
          understand inter-instance communication behavior.
        </p>
      </div>

      <div class="resource-grid">
        {
          resources.map((resource) => (
            <article class="resource-block">
              <div class="resource-block__header">
                <div class="resource-block__label">{resource.label}</div>
                <h2>{resource.title}</h2>
              </div>

              <p class="resource-block__description">{resource.description}</p>

              <pre><code>{resource.sql}</code></pre>
            </article>
          ))
        }
      </div>

      <div class="resource-note">
        <p class="eyebrow">ORASOLU TOOLBOX · HIGH AVAILABILITY</p>
        <h2>Interconnect health is part of RAC performance.</h2>
        <p>
          Cache Fusion relies on inter-instance communication over the RAC
          interconnect. Review interface configuration together with GES, GCS
          and global cache wait statistics when investigating inter-instance
          performance behavior.
        </p>
        <p>
          Oracle documents <code>GV$CLUSTER_INTERCONNECTS</code> as the global
          view for displaying interconnect entries across RAC instances.
          <code>INST_ID</code> identifies the instance that supplied each row.
        </p>
      </div>

      <div class="resource-actions">
        <a class="button button--primary" href="/tools/high-availability/">
          Back to High Availability
        </a>
        <a
          class="resource-actions__link"
          href="/tools/high-availability/data-guard-status/"
        >
          Data Guard Status
        </a>
      </div>
    </div>
  </section>

  <script>
    document.querySelectorAll(".resource-block pre").forEach((pre) => {
      const button = document.createElement("button");
      button.type = "button";
      button.className = "resource-copy-button";
      button.textContent = "Copy";
      button.setAttribute("aria-label", "Copy SQL");

      pre.style.position = "relative";
      button.style.position = "absolute";
      button.style.top = "10px";
      button.style.right = "10px";
      button.style.padding = "5px 9px";
      button.style.border = "1px solid #d1d5db";
      button.style.borderRadius = "5px";
      button.style.background = "#ffffff";
      button.style.color = "#374151";
      button.style.fontFamily = "inherit";
      button.style.fontSize = "0.75rem";
      button.style.cursor = "pointer";
      button.style.zIndex = "2";

      button.addEventListener("click", async () => {
        const code = pre.querySelector("code");
        if (!code) return;

        try {
          await navigator.clipboard.writeText(code.textContent || "");
          button.textContent = "Copied";
          window.setTimeout(() => {
            button.textContent = "Copy";
          }, 1500);
        } catch {
          button.textContent = "Copy failed";
          window.setTimeout(() => {
            button.textContent = "Copy";
          }, 1500);
        }
      });

      pre.appendChild(button);
    });
  </script>

  <style>
    .resource-hero {
      padding-top: 82px;
      padding-bottom: 72px;
      border-bottom: 1px solid var(--line);
    }

    .resource-hero h1 {
      margin: 0 0 14px;
      color: var(--ink);
      font-size: clamp(42px, 6vw, 72px);
      line-height: 1.05;
      letter-spacing: -0.04em;
    }

    .resource-hero > .container > p:last-child {
      max-width: 900px;
      margin: 0;
      color: var(--muted);
      font-size: 17px;
      line-height: 1.75;
    }

    .resource-section {
      padding-top: 56px;
      padding-bottom: 72px;
    }

    .resource-intro {
      max-width: 820px;
      margin-bottom: 32px;
    }

    .resource-intro h2 {
      margin: 0 0 14px;
      color: var(--ink);
      font-size: clamp(28px, 3vw, 38px);
      line-height: 1.15;
    }

    .resource-intro > p:last-child {
      margin: 0;
      color: var(--muted);
      font-size: 16px;
      line-height: 1.75;
    }

    .resource-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 22px;
      align-items: start;
    }

    .resource-block {
      display: flex;
      flex-direction: column;
      min-width: 0;
      height: 560px;
      box-sizing: border-box;
      margin: 0;
      padding: 30px;
      background: #ffffff;
      border: 1px solid var(--line);
      border-radius: 18px;
      overflow: hidden;
      transition:
        border-color 0.22s ease,
        box-shadow 0.22s ease,
        transform 0.22s ease;
    }

    .resource-block:hover {
      border-color: #d8dce1;
      box-shadow: 0 12px 30px rgba(17, 29, 44, 0.06);
      transform: translateY(-3px);
    }

    .resource-block__header {
      margin-bottom: 10px;
    }

    .resource-block__label {
      margin-bottom: 9px;
      color: var(--orange);
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 0.14em;
      line-height: 1.2;
    }

    .resource-block h2 {
      margin: 0;
      color: var(--ink);
      font-size: 22px;
      line-height: 1.3;
    }

    .resource-block__description {
      min-height: 48px;
      margin: 0 0 22px;
      color: var(--muted);
      font-size: 14px;
      line-height: 1.7;
    }

    .resource-block pre {
      position: relative;
      flex: 1 1 auto;
      min-height: 0;
      margin: 0;
      padding: 22px;
      overflow-x: auto;
      overflow-y: auto;
      white-space: pre;
      background: #2f353d;
      border-radius: 10px;
      color: #f3f4f6;
      font-family:
        "Cascadia Code",
        "Consolas",
        "Courier New",
        monospace;
      font-size: 13px;
      line-height: 1.7;
    }

    .resource-block code {
      font-family: inherit;
      white-space: pre;
    }

    .resource-copy-button {
      position: absolute;
      top: 10px;
      right: 10px;
      padding: 5px 9px;
      border: 1px solid #d1d5db;
      border-radius: 5px;
      background: #ffffff;
      color: #374151;
      font-family: inherit;
      font-size: 0.75rem;
      cursor: pointer;
      z-index: 2;
    }

    .resource-copy-button:hover {
      background: #f3f4f6;
    }

    .resource-note {
      max-width: 820px;
      margin-top: 32px;
      padding: 30px;
      box-sizing: border-box;
      background: #f7f8fa;
      border: 1px solid var(--line);
      border-radius: 18px;
      color: var(--muted);
      font-size: 14px;
      line-height: 1.75;
    }

    .resource-note .eyebrow {
      margin: 0 0 14px;
    }

    .resource-note h2 {
      margin: 0 0 14px;
      color: var(--ink);
      font-size: clamp(28px, 3vw, 38px);
      line-height: 1.15;
    }

    .resource-note p:not(.eyebrow) {
      margin: 0 0 14px;
    }

    .resource-note p:last-child {
      margin-bottom: 0;
    }

    .resource-note code {
      padding: 1px 4px;
      border-radius: 4px;
      background: #eef0f2;
      color: var(--ink);
      font-family:
        "Cascadia Code",
        "Consolas",
        "Courier New",
        monospace;
      font-size: 0.92em;
    }

    .resource-actions {
      display: flex;
      align-items: center;
      gap: 24px;
      justify-content: flex-start;
      margin-top: 24px;
    }

    .resource-actions__link {
      color: var(--orange);
      font-size: 14px;
      font-weight: 700;
      text-decoration: none;
    }

    .resource-actions__link:hover {
      text-decoration: underline;
    }

    @media (max-width: 820px) {
      .resource-grid {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 680px) {
      .resource-hero {
        padding-top: 58px;
        padding-bottom: 54px;
      }

      .resource-hero h1 {
        font-size: clamp(38px, 12vw, 54px);
      }

      .resource-grid {
        grid-template-columns: 1fr;
        gap: 16px;
      }

      .resource-block {
        height: 520px;
        padding: 22px;
        border-radius: 16px;
      }

      .resource-block__description {
        min-height: 0;
      }

      .resource-block pre {
        padding: 18px;
        font-size: 12px;
      }

      .resource-note {
        padding: 22px;
        border-radius: 16px;
      }

      .resource-actions {
        flex-wrap: wrap;
        gap: 16px;
      }
    }
  </style>
</BaseLayout>
