---
import BaseLayout from "../../../../layouts/BaseLayout.astro";

const resources = [
  {
    label: "01 · DATABASE CONFIGURATION",
    title: "Review Data Guard database configuration",
    description:
      "Review the database identity, role, protection mode and switchover state that define the current Data Guard member.",
    sql: `SELECT
    name,
    db_unique_name,
    database_role,
    open_mode,
    protection_mode,
    protection_level,
    switchover_status
FROM v$database;`,
  },
  {
    label: "02 · DATABASE MEMBERS",
    title: "Review Data Guard members",
    description:
      "List the unique database names known to the Data Guard configuration through DB_UNIQUE_NAME and LOG_ARCHIVE_CONFIG.",
    sql: `SELECT
    db_unique_name,
    parent_dbun,
    dest_role
FROM v$dataguard_config
ORDER BY db_unique_name;`,
  },
  {
    label: "03 · REDO DESTINATION CONFIGURATION",
    title: "Review redo transport configuration",
    description:
      "Inspect configured archive destinations, targets, transport mode, binding and destination status.",
    sql: `SELECT
    dest_id,
    status,
    target,
    db_unique_name,
    binding,
    transmit_mode,
    affirm,
    net_timeout,
    destination
FROM v$archive_dest
WHERE target = 'STANDBY'
ORDER BY dest_id;`,
  },
  {
    label: "04 · STANDBY REDO LOGS",
    title: "Review standby redo log configuration",
    description:
      "Inspect standby redo log groups, threads, sizes and current status on the database where the query is executed.",
    sql: `SELECT
    group#,
    thread#,
    sequence#,
    bytes,
    blocksize,
    used,
    archived,
    status
FROM v$standby_log
ORDER BY
    thread#,
    group#;`,
  },
  {
    label: "05 · ONLINE REDO THREADS",
    title: "Review online redo configuration",
    description:
      "Review online redo groups by thread to understand redo thread configuration before comparing standby redo capacity.",
    sql: `SELECT
    thread#,
    group#,
    sequence#,
    bytes,
    archived,
    status
FROM v$log
ORDER BY
    thread#,
    group#;`,
  },
  {
    label: "06 · DATA GUARD PARAMETERS",
    title: "Review Data Guard initialization parameters",
    description:
      "Inspect DB_UNIQUE_NAME, LOG_ARCHIVE_CONFIG and configured LOG_ARCHIVE_DEST parameters used by Data Guard.",
    sql: `SELECT
    name,
    value
FROM v$parameter
WHERE name = 'db_unique_name'
   OR name = 'log_archive_config'
   OR (
       name LIKE 'log_archive_dest_%'
       AND name NOT LIKE 'log_archive_dest_state_%'
   )
ORDER BY name;`,
  },
];
---

<BaseLayout
  title="Data Guard Configuration"
  description="Practical Oracle Data Guard SQL for reviewing database members, redo destinations, standby redo logs, redo threads and Data Guard initialization parameters."
>
  <section class="resource-hero">
    <div class="container">
      <p class="eyebrow">ORASOLU TOOLBOX · HIGH AVAILABILITY</p>
      <h1>Data Guard Configuration</h1>
      <p>
        Practical Oracle Data Guard SQL for reviewing database members, redo
        destinations, standby redo logs, redo threads and Data Guard
        initialization parameters.
      </p>
    </div>
  </section>

  <section class="resource-section">
    <div class="container">
      <div class="resource-intro">
        <p class="eyebrow">ORASOLU TOOLBOX · HIGH AVAILABILITY</p>
        <h2>Understand how Data Guard is configured</h2>
        <p>
          Review the databases participating in the configuration, redo
          transport destinations, standby redo logs, online redo threads and
          the initialization parameters that define Data Guard behavior.
        </p>
      </div>

      <div class="resource-grid">
        {
          resources.map((resource) => (
            <article class="resource-block">
              <div class="resource-block__header">
                <div class="resource-block__label">{resource.label}</div>
                <h2>{resource.title}</h2>
              </div>

              <p class="resource-block__description">{resource.description}</p>

              <pre><code>{resource.sql}</code></pre>
            </article>
          ))
        }
      </div>

      <div class="resource-note">
        <p class="eyebrow">ORASOLU TOOLBOX · HIGH AVAILABILITY</p>
        <h2>Configuration explains how redo moves between databases.</h2>
        <p>
          Start with the database identities and roles, then review the redo
          destinations and transport attributes. Compare online redo threads
          with standby redo logs when validating the redo configuration of a
          physical standby environment.
        </p>
        <p>
          Oracle documents <code>V$DATAGUARD_CONFIG</code> as the view that
          lists the unique database names defined with
          <code>DB_UNIQUE_NAME</code> and <code>LOG_ARCHIVE_CONFIG</code>.
        </p>
      </div>

      <div class="resource-actions">
        <a class="button button--primary" href="/tools/high-availability/">
          Back to High Availability
        </a>
        <a
          class="resource-actions__link"
          href="/tools/performance/"
        >
          Performance &amp; Diagnostics
        </a>
      </div>
    </div>
  </section>

  <script>
    document.querySelectorAll(".resource-block pre").forEach((pre) => {
      const button = document.createElement("button");
      button.type = "button";
      button.className = "resource-copy-button";
      button.textContent = "Copy";
      button.setAttribute("aria-label", "Copy SQL");

      pre.style.position = "relative";
      button.style.position = "absolute";
      button.style.top = "10px";
      button.style.right = "10px";
      button.style.padding = "5px 9px";
      button.style.border = "1px solid #d1d5db";
      button.style.borderRadius = "5px";
      button.style.background = "#ffffff";
      button.style.color = "#374151";
      button.style.fontFamily = "inherit";
      button.style.fontSize = "0.75rem";
      button.style.cursor = "pointer";
      button.style.zIndex = "2";

      button.addEventListener("click", async () => {
        const code = pre.querySelector("code");
        if (!code) return;

        try {
          await navigator.clipboard.writeText(code.textContent || "");
          button.textContent = "Copied";
          window.setTimeout(() => {
            button.textContent = "Copy";
          }, 1500);
        } catch {
          button.textContent = "Copy failed";
          window.setTimeout(() => {
            button.textContent = "Copy";
          }, 1500);
        }
      });

      pre.appendChild(button);
    });
  </script>

  <style>
    .resource-hero {
      padding-top: 82px;
      padding-bottom: 72px;
      border-bottom: 1px solid var(--line);
    }

    .resource-hero h1 {
      margin: 0 0 14px;
      color: var(--ink);
      font-size: clamp(42px, 6vw, 72px);
      line-height: 1.05;
      letter-spacing: -0.04em;
    }

    .resource-hero > .container > p:last-child {
      max-width: 900px;
      margin: 0;
      color: var(--muted);
      font-size: 17px;
      line-height: 1.75;
    }

    .resource-section {
      padding-top: 56px;
      padding-bottom: 72px;
    }

    .resource-intro {
      max-width: 820px;
      margin-bottom: 32px;
    }

    .resource-intro h2 {
      margin: 0 0 14px;
      color: var(--ink);
      font-size: clamp(28px, 3vw, 38px);
      line-height: 1.15;
    }

    .resource-intro > p:last-child {
      margin: 0;
      color: var(--muted);
      font-size: 16px;
      line-height: 1.75;
    }

    .resource-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 22px;
      align-items: start;
    }

    .resource-block {
      display: flex;
      flex-direction: column;
      min-width: 0;
      height: 560px;
      box-sizing: border-box;
      margin: 0;
      padding: 30px;
      background: #ffffff;
      border: 1px solid var(--line);
      border-radius: 18px;
      overflow: hidden;
      transition:
        border-color 0.22s ease,
        box-shadow 0.22s ease,
        transform 0.22s ease;
    }

    .resource-block:hover {
      border-color: #d8dce1;
      box-shadow: 0 12px 30px rgba(17, 29, 44, 0.06);
      transform: translateY(-3px);
    }

    .resource-block__header {
      margin-bottom: 10px;
    }

    .resource-block__label {
      margin-bottom: 9px;
      color: var(--orange);
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 0.14em;
      line-height: 1.2;
    }

    .resource-block h2 {
      margin: 0;
      color: var(--ink);
      font-size: 22px;
      line-height: 1.3;
    }

    .resource-block__description {
      min-height: 48px;
      margin: 0 0 22px;
      color: var(--muted);
      font-size: 14px;
      line-height: 1.7;
    }

    .resource-block pre {
      position: relative;
      flex: 1 1 auto;
      min-height: 0;
      margin: 0;
      padding: 22px;
      overflow-x: auto;
      overflow-y: auto;
      white-space: pre;
      background: #2f353d;
      border-radius: 10px;
      color: #f3f4f6;
      font-family:
        "Cascadia Code",
        "Consolas",
        "Courier New",
        monospace;
      font-size: 13px;
      line-height: 1.7;
    }

    .resource-block code {
      font-family: inherit;
      white-space: pre;
    }

    .resource-copy-button {
      position: absolute;
      top: 10px;
      right: 10px;
      padding: 5px 9px;
      border: 1px solid #d1d5db;
      border-radius: 5px;
      background: #ffffff;
      color: #374151;
      font-family: inherit;
      font-size: 0.75rem;
      cursor: pointer;
      z-index: 2;
    }

    .resource-copy-button:hover {
      background: #f3f4f6;
    }

    .resource-note {
      max-width: 820px;
      margin-top: 32px;
      padding: 30px;
      box-sizing: border-box;
      background: #f7f8fa;
      border: 1px solid var(--line);
      border-radius: 18px;
      color: var(--muted);
      font-size: 14px;
      line-height: 1.75;
    }

    .resource-note .eyebrow {
      margin: 0 0 14px;
    }

    .resource-note h2 {
      margin: 0 0 14px;
      color: var(--ink);
      font-size: clamp(28px, 3vw, 38px);
      line-height: 1.15;
    }

    .resource-note p:not(.eyebrow) {
      margin: 0 0 14px;
    }

    .resource-note p:last-child {
      margin-bottom: 0;
    }

    .resource-note code {
      padding: 1px 4px;
      border-radius: 4px;
      background: #eef0f2;
      color: var(--ink);
      font-family:
        "Cascadia Code",
        "Consolas",
        "Courier New",
        monospace;
      font-size: 0.92em;
    }

    .resource-actions {
      display: flex;
      align-items: center;
      gap: 24px;
      justify-content: flex-start;
      margin-top: 24px;
    }

    .resource-actions__link {
      color: var(--orange);
      font-size: 14px;
      font-weight: 700;
      text-decoration: none;
    }

    .resource-actions__link:hover {
      text-decoration: underline;
    }

    @media (max-width: 820px) {
      .resource-grid {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 680px) {
      .resource-hero {
        padding-top: 58px;
        padding-bottom: 54px;
      }

      .resource-hero h1 {
        font-size: clamp(38px, 12vw, 54px);
      }

      .resource-grid {
        grid-template-columns: 1fr;
        gap: 16px;
      }

      .resource-block {
        height: 520px;
        padding: 22px;
        border-radius: 16px;
      }

      .resource-block__description {
        min-height: 0;
      }

      .resource-block pre {
        padding: 18px;
        font-size: 12px;
      }

      .resource-note {
        padding: 22px;
        border-radius: 16px;
      }

      .resource-actions {
        flex-wrap: wrap;
        gap: 16px;
      }
    }
  </style>
</BaseLayout>
