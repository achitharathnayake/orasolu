---
import BaseLayout from "../../../../layouts/BaseLayout.astro";

const resources = [
  {
    label: "01 · CLUSTER INSTANCES",
    title: "Review all RAC instances",
    description: "View instance number, name, host, status and startup time across the cluster.",
    sql: `SELECT
    inst_id,
    instance_number,
    instance_name,
    host_name,
    status,
    startup_time,
    database_type
FROM gv$instance
ORDER BY inst_id;`,
  },
  {
    label: "02 · ACTIVE INSTANCES",
    title: "Check currently mounted instances",
    description: "Confirm which RAC instances are currently mounted and review their instance numbers and names.",
    sql: `SELECT
    inst_number,
    inst_name
FROM v$active_instances
ORDER BY inst_number;`,
  },
  {
    label: "03 · INSTANCE UPTIME",
    title: "Review RAC instance uptime",
    description: "Compare instance startup times to identify recent restarts or differences between RAC nodes.",
    sql: `SELECT
    inst_id,
    instance_name,
    host_name,
    startup_time,
    ROUND((SYSDATE - startup_time) * 24, 2) AS uptime_hours
FROM gv$instance
ORDER BY startup_time DESC;`,
  },
  {
    label: "04 · INSTANCE STATE",
    title: "Inspect instance state and role",
    description: "Review status, instance role, active state and service blocking state for each RAC instance.",
    sql: `SELECT
    inst_id,
    instance_name,
    host_name,
    status,
    instance_role,
    active_state,
    blocked
FROM gv$instance
ORDER BY inst_id;`,
  },
  {
    label: "05 · DATABASE TYPE",
    title: "Confirm RAC database type",
    description: "Check the database type reported by each instance and verify the cluster is running as RAC.",
    sql: `SELECT DISTINCT
    database_type
FROM gv$instance
ORDER BY database_type;`,
  },
  {
    label: "06 · INSTANCE SUMMARY",
    title: "Summarize instance status",
    description: "Quickly summarize the number of RAC instances by current instance status.",
    sql: `SELECT
    status,
    COUNT(*) AS instance_count
FROM gv$instance
GROUP BY status
ORDER BY status;`,
  },
];
---

<BaseLayout title="RAC Instance Status" description="Practical Oracle RAC SQL for reviewing instance status, uptime, state, role and cluster availability.">
  <section class="resource-hero">
    <div class="container">
      <p class="eyebrow">ORASOLU TOOLBOX · HIGH AVAILABILITY</p>
      <h1>RAC Instance Status</h1>
      <p>
        Practical Oracle RAC SQL for reviewing cluster instances, startup
        times, instance state, role and overall instance availability.
      </p>
    </div>
  </section>

  <section class="resource-section">
    <div class="container">
      <div class="resource-intro">
        <p class="eyebrow">ORASOLU TOOLBOX · HIGH AVAILABILITY</p>
        <h2>Understand the state of RAC instances</h2>
        <p>
          Review instance status, startup times, roles and cluster-level
          availability to establish the current state of the RAC environment.
        </p>
      </div>

      <div class="resource-grid">
        {resources.map((resource) => (
          <article class="resource-block">
            <div class="resource-block__header">
              <div class="resource-block__label">{resource.label}</div>
              <h2>{resource.title}</h2>
            </div>
            <p class="resource-block__description">{resource.description}</p>
            <pre><code>{resource.sql}</code></pre>
          </article>
        ))}
      </div>

      <div class="resource-note">
        <p class="eyebrow">ORASOLU TOOLBOX · HIGH AVAILABILITY</p>
        <h2>RAC instance status is only one part of cluster health.</h2>
        <p>
          Instance status should be considered together with services, session
          distribution, interconnect activity and application workload when
          investigating RAC availability and performance.
        </p>
        <p>
          <code>GV$</code> views provide information from qualified RAC
          instances and include <code>INST_ID</code>, which identifies the
          instance that supplied each row.
        </p>
      </div>

      <div class="resource-actions">
        <a class="button button--primary" href="/tools/high-availability/">Back to High Availability</a>
        <a class="resource-actions__link" href="/tools/high-availability/rac-services/">RAC Services</a>
      </div>
    </div>
  </section>

  <script>
    document.querySelectorAll(".resource-block pre").forEach((pre) => {
      const button = document.createElement("button");
      button.type = "button";
      button.className = "resource-copy-button";
      button.textContent = "Copy";
      button.setAttribute("aria-label", "Copy SQL");
      pre.style.position = "relative";
      button.style.position = "absolute";
      button.style.top = "10px";
      button.style.right = "10px";
      button.style.padding = "5px 9px";
      button.style.border = "1px solid #d1d5db";
      button.style.borderRadius = "5px";
      button.style.background = "#ffffff";
      button.style.color = "#374151";
      button.style.fontFamily = "inherit";
      button.style.fontSize = "0.75rem";
      button.style.cursor = "pointer";
      button.style.zIndex = "2";
      button.addEventListener("click", async () => {
        const code = pre.querySelector("code");
        if (!code) return;
        try {
          await navigator.clipboard.writeText(code.textContent || "");
          button.textContent = "Copied";
          window.setTimeout(() => { button.textContent = "Copy"; }, 1500);
        } catch {
          button.textContent = "Copy failed";
          window.setTimeout(() => { button.textContent = "Copy"; }, 1500);
        }
      });
      pre.appendChild(button);
    });
  </script>

  <style>
    .resource-hero {
      padding-top: 82px;
      padding-bottom: 72px;
      border-bottom: 1px solid var(--line);
    }

    .resource-hero h1 {
      margin: 0 0 14px;
      color: var(--ink);
      font-size: clamp(42px, 6vw, 72px);
      line-height: 1.05;
      letter-spacing: -0.04em;
    }

    .resource-hero > .container > p:last-child {
      max-width: 900px;
      margin: 0;
      color: var(--muted);
      font-size: 17px;
      line-height: 1.75;
    }

    .resource-section {
      padding-top: 56px;
      padding-bottom: 72px;
    }

    .resource-intro {
      max-width: 820px;
      margin-bottom: 32px;
    }

    .resource-intro h2 {
      margin: 0 0 14px;
      color: var(--ink);
      font-size: clamp(28px, 3vw, 38px);
      line-height: 1.15;
    }

    .resource-intro > p:last-child {
      margin: 0;
      color: var(--muted);
      font-size: 16px;
      line-height: 1.75;
    }
    .resource-grid {
      display: grid; grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 22px; align-items: start;
    }
    .resource-block {
      display: flex; flex-direction: column; min-width: 0;
      height: 560px; box-sizing: border-box; margin: 0; padding: 30px;
      background: #ffffff; border: 1px solid var(--line);
      border-radius: 18px; overflow: hidden;
      transition: border-color 0.22s ease, box-shadow 0.22s ease, transform 0.22s ease;
    }
    .resource-block:hover {
      border-color: #d8dce1; box-shadow: 0 12px 30px rgba(17, 29, 44, 0.06);
      transform: translateY(-3px);
    }
    .resource-block__header { margin-bottom: 10px; }
    .resource-block__label {
      margin-bottom: 9px; color: var(--orange); font-size: 11px;
      font-weight: 800; letter-spacing: 0.14em; line-height: 1.2;
    }
    .resource-block h2 { margin: 0; color: var(--ink); font-size: 22px; line-height: 1.3; }
    .resource-block__description {
      min-height: 48px; margin: 0 0 22px; color: var(--muted);
      font-size: 14px; line-height: 1.7;
    }
    .resource-block pre {
      position: relative; flex: 1 1 auto; min-height: 0; margin: 0;
      padding: 22px; overflow-x: auto; overflow-y: auto; white-space: pre;
      background: #2f353d; border-radius: 10px; color: #f3f4f6;
      font-family: "Cascadia Code", "Consolas", "Courier New", monospace;
      font-size: 13px; line-height: 1.7;
    }
    .resource-block code { font-family: inherit; white-space: pre; }
    .resource-copy-button {
      position: absolute; top: 10px; right: 10px; padding: 5px 9px;
      border: 1px solid #d1d5db; border-radius: 5px; background: #ffffff;
      color: #374151; font-family: inherit; font-size: 0.75rem; cursor: pointer; z-index: 2;
    }
    .resource-copy-button:hover { background: #f3f4f6; }
    .resource-note {
      max-width: 820px;
      margin-top: 32px;
      padding: 30px;
      box-sizing: border-box;
      background: #f7f8fa;
      border: 1px solid var(--line);
      border-radius: 18px;
      color: var(--muted);
      font-size: 14px;
      line-height: 1.75;
    }

    .resource-note .eyebrow {
      margin: 0 0 14px;
    }

    .resource-note h2 {
      margin: 0 0 14px;
      color: var(--ink);
      font-size: clamp(28px, 3vw, 38px);
      line-height: 1.15;
    }

    .resource-note p:not(.eyebrow) {
      margin: 0 0 14px;
    }

    .resource-note p:last-child {
      margin-bottom: 0;
    }

    .resource-note code {
      padding: 1px 4px;
      border-radius: 4px;
      background: #eef0f2;
      color: var(--ink);
      font-family: "Cascadia Code", "Consolas", "Courier New", monospace;
      font-size: 0.92em;
    }

    .resource-actions {
      display: flex;
      align-items: center;
      gap: 24px;
      justify-content: flex-start;
      margin-top: 24px;
    }

    .resource-actions__link {
      color: var(--orange);
      font-size: 14px;
      font-weight: 700;
      text-decoration: none;
    }

    .resource-actions__link:hover {
      text-decoration: underline;
    }
    @media (max-width: 820px) { .resource-grid { grid-template-columns: 1fr; } }
    @media (max-width: 680px) {
      .resource-hero {
        padding-top: 58px;
        padding-bottom: 54px;
      }

      .resource-hero h1 {
        font-size: clamp(38px, 12vw, 54px);
      }

      .resource-grid { grid-template-columns: 1fr; gap: 16px; }
      .resource-block { height: 520px; padding: 22px; border-radius: 16px; }
      .resource-block__description { min-height: 0; }
      .resource-block pre { padding: 18px; font-size: 12px; }

      .resource-note {
        padding: 22px;
        border-radius: 16px;
      }

      .resource-actions {
        flex-wrap: wrap;
        gap: 16px;
      }
    }
  </style>
</BaseLayout>
