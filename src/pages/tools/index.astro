---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout>

  <section class="page-hero toolbox-hero">
    <div class="container">
      <div class="eyebrow">ORASOLU TOOLBOX</div>

      <h1>
        Tools & <span>Resources</span>
      </h1>

      <p>
        Scripts, utilities, diagnostics and technical resources
        for database, cloud, infrastructure and automation work.
      </p>
    </div>
  </section>

  <section class="section tools-section">
    <div class="container">

      <div class="section-intro tools-intro">
        <div>
          <div class="eyebrow">ORASOLU TOOLBOX</div>

          <h2>
            Resources for real-world work
          </h2>

          <p>
            A growing collection of scripts, utilities, checklists and
            technical resources developed from hands-on experience.
          </p>
        </div>
      </div>

      <div class="tools-directory">

        <a href="/tools/sql/" class="tool-directory-card">
          <div class="tool-directory-icon"><svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="#f45a24" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M5 7h4"/><path d="M5 11h7"/><path d="M5 15h5"/><path d="M15 6l4 4-4 4"/><path d="M19 10h-7"/></svg></div>

          <div class="tool-directory-content">
            <div class="tool-directory-label">DATABASE</div>

            <h3>SQL & Database</h3>

            <p>
              SQL scripts, database administration utilities,
              metadata queries and everyday DBA resources.
            </p>

            <span>Explore resources</span>
          </div>
        </a>


        <a href="/tools/performance/" class="tool-directory-card">
          <div class="tool-directory-icon"><svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="#f45a24" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3.5 13h3l2-5 3.2 9 2.3-6 1.7 2h4.8"/><path d="M4 19.5h16"/></svg></div>

          <div class="tool-directory-content">
            <div class="tool-directory-label">DIAGNOSTICS</div>

            <h3>Performance & Diagnostics</h3>

            <p>
              Performance analysis, wait events, SQL diagnostics,
              AWR, ASH and troubleshooting resources.
            </p>

            <span>Explore resources</span>
          </div>
        </a>


        <a href="/tools/high-availability/" class="tool-directory-card">
          <div class="tool-directory-icon"><svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="#f45a24" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="12" r="2.2"/><circle cx="18" cy="6" r="2.2"/><circle cx="18" cy="18" r="2.2"/><path d="M8 10.9 15.8 7"/><path d="M8 13.1 15.8 17"/></svg></div>

          <div class="tool-directory-content">
            <div class="tool-directory-label">AVAILABILITY</div>

            <h3>High Availability</h3>

            <p>
              RAC, Data Guard, disaster recovery, MAA and
              business continuity resources.
            </p>

            <span>Explore resources</span>
          </div>
        </a>


        <a href="/tools/backup-recovery/" class="tool-directory-card">
          <div class="tool-directory-icon"><svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="#f45a24" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4.2 19 7v5.2c0 4-2.7 6.8-7 8.1-4.3-1.3-7-4.1-7-8.1V7l7-2.8Z"/><path d="M9 12a3 3 0 1 0 5.2-2"/><path d="M15.5 7.8v3.3h-3.3"/></svg></div>

          <div class="tool-directory-content">
            <div class="tool-directory-label">PROTECTION</div>

            <h3>Backup & Recovery</h3>

            <p>
              RMAN, recovery procedures, backup strategies and
              operational database protection resources.
            </p>

            <span>Explore resources</span>
          </div>
        </a>


        <a href="/tools/migration/" class="tool-directory-card">
          <div class="tool-directory-icon"><svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="#f45a24" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 8h11"/><path d="m12 5 3 3-3 3"/><path d="M20 16H9"/><path d="m12 13-3 3 3 3"/></svg></div>

          <div class="tool-directory-content">
            <div class="tool-directory-label">MODERNIZATION</div>

            <h3>Migration</h3>

            <p>
              Migration planning, Data Pump, ZDM, XTTS,
              platform migration and modernization resources.
            </p>

            <span>Explore resources</span>
          </div>
        </a>


        <a href="/tools/automation/" class="tool-directory-card">
          <div class="tool-directory-icon"><svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="#f45a24" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="5" width="16" height="14" rx="2"/><path d="m8 10 2 2-2 2"/><path d="M12.5 14h3"/><circle cx="18" cy="4" r="1.5"/><path d="M18 2.5V1.8M19.1 3.1l.5-.5M19.5 4h.7"/></svg></div>

          <div class="tool-directory-content">
            <div class="tool-directory-label">AUTOMATION</div>

            <h3>Automation & DevOps</h3>

            <p>
              Shell, Python, Ansible, Terraform, Jenkins,
              GitLab and infrastructure automation resources.
            </p>

            <span>Explore resources</span>
          </div>
        </a>

      </div>

    </div>
  </section>


  <section class="section toolbox-note-section">
    <div class="container">

      <div class="toolbox-note">

        <div class="toolbox-note-content">
          <div class="eyebrow">ORASOLU TOOLBOX</div>

          <h2>Tools for real database work.</h2>

          <p>
            Scripts, diagnostics and utilities built to support Oracle database administration,
            troubleshooting, automation and infrastructure work.
          </p>
        </div>

        <a class="button button--primary" href="/articles/">
          Explore Articles
        </a>

      </div>

    </div>
  </section>

</BaseLayout>


<style>
  /* ==========================================================
     TOOLS PAGE
     ========================================================== */

  .tools-section {
    padding-top: 72px;
    padding-bottom: 88px;
  }

  .tools-intro {
    margin-bottom: 42px;
  }

  .tools-intro h2 {
    margin: 0 0 14px;
    font-size: clamp(34px, 4vw, 48px);
    line-height: 1.15;
    color: var(--ink);
  }

  .tools-intro p {
    max-width: 760px;
    margin: 0;
    color: var(--muted);
    font-size: 16px;
    line-height: 1.7;
  }


  /* ==========================================================
     DIRECTORY
     ========================================================== */

  .tools-directory {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
  }


  /* ==========================================================
     CARD
     ========================================================== */

  .tool-directory-card {
    display: flex;
    align-items: flex-start;
    gap: 20px;

    min-height: 220px;

    padding: 28px;

    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: 18px;

    color: var(--ink);
    text-decoration: none;

    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease,
      transform 0.2s ease;
  }

  .tool-directory-card:hover {
  border-color: var(--orange);
  box-shadow: 0 10px 24px rgba(17, 29, 44, 0.08);
  transform: translateY(-2px);
}


  /* ==========================================================
     ICON
     ========================================================== */

  .tool-directory-icon svg {
    width: 26px;
    height: 26px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .tool-directory-icon {
    flex: 0 0 54px;

    width: 54px;
    height: 54px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 50%;

    background: rgba(244, 90, 36, 0.10);
    color: var(--orange);

    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-align: center;
  }


  /* ==========================================================
     CONTENT
     ========================================================== */

  .tool-directory-content {
    min-width: 0;
    flex: 1;
  }

  .tool-directory-label {
    margin-bottom: 9px;

    color: var(--orange);

    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.14em;
    line-height: 1.2;
  }

  .tool-directory-content h3 {
    margin: 0 0 12px;

    color: var(--ink);

    font-size: 21px;
    font-weight: 750;
    line-height: 1.25;
  }

  .tool-directory-content p {
    margin: 0 0 22px;

    color: var(--muted);

    font-size: 14px;
    line-height: 1.65;
  }

  .tool-directory-content span {
    display: inline-block;

    color: var(--orange);

    font-size: 14px;
    font-weight: 700;
  }


  /* ==========================================================
     NOTE
     ========================================================== */

  .toolbox-note-section {
    background: #fff;
  }

  .toolbox-note {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 32px;
    padding: 30px 34px;
    background: #f3f5f8;
    border: 1px solid var(--line);
    border-radius: 14px;
    box-shadow: 0 10px 28px rgba(17, 29, 44, .06);
  }

  .toolbox-note h2 {
    margin: 0.4rem 0 0.7rem;
  }

  .toolbox-note p {
    max-width: 720px;
    margin: 0;
    color: var(--muted);
    line-height: 1.7;
  }

  .toolbox-note .button {
    flex-shrink: 0;
    white-space: nowrap;
  }

  @media (max-width: 760px) {
    .toolbox-note {
      grid-template-columns: 1fr;
      gap: 20px;
      padding: 24px;
    }

    .toolbox-note .button {
      justify-self: start;
    }
  }

  /* ==========================================================
     TABLET
     ========================================================== */

  @media (max-width: 980px) {

    .tools-directory {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

  }


  /* ==========================================================
     MOBILE
     ========================================================== */

  @media (max-width: 680px) {

    .tools-section {
      padding-top: 52px;
      padding-bottom: 64px;
    }

    .tools-intro {
      margin-bottom: 30px;
    }

    .tools-directory {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .tool-directory-card {
      min-height: auto;
      padding: 22px;
      border-radius: 16px;
    }

    .tool-directory-icon svg {
    width: 26px;
    height: 26px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .tool-directory-icon {
      flex-basis: 48px;
      width: 48px;
      height: 48px;
    }

    .tool-directory-content h3 {
      font-size: 21px;
    }

  }


  /* ==========================================================
     SMALL MOBILE
     ========================================================== */

  @media (max-width: 430px) {

    .tool-directory-card {
      gap: 15px;
      padding: 19px;
    }

    .tool-directory-icon svg {
    width: 26px;
    height: 26px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .tool-directory-icon {
      flex-basis: 44px;
      width: 44px;
      height: 44px;
      font-size: 9px;
    }

    .tool-directory-content p {
      font-size: 13px;
    }

  }
</style>
