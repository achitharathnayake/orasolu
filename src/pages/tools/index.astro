---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout>

  <section class="page-hero">
    <div class="container">
      <div class="eyebrow">ORASOLU TOOLBOX</div>

      <h1>
        Tools & <span>Resources</span>
      </h1>

      <p>
        Practical scripts, utilities, diagnostics and technical resources
        for database, cloud, infrastructure and automation work.
      </p>
    </div>
  </section>

  <section class="section tools-section">
    <div class="container">

      <div class="section-intro tools-intro">
        <div>
          <div class="eyebrow">EXPLORE THE TOOLBOX</div>

          <h2>
            Practical resources for real-world work
          </h2>

          <p>
            A growing collection of scripts, utilities, checklists and
            technical resources developed from hands-on experience.
          </p>
        </div>
      </div>

      <div class="tools-directory">

        <a href="/tools/sql/" class="tool-directory-card">
          <div class="tool-directory-icon">SQL</div>

          <div class="tool-directory-content">
            <div class="tool-directory-label">DATABASE</div>

            <h3>SQL & Database</h3>

            <p>
              SQL scripts, database administration utilities,
              metadata queries and everyday DBA resources.
            </p>

            <span>Explore resources</span>
          </div>
        </a>


        <a href="/tools/performance/" class="tool-directory-card">
          <div class="tool-directory-icon">PERF</div>

          <div class="tool-directory-content">
            <div class="tool-directory-label">DIAGNOSTICS</div>

            <h3>Performance & Diagnostics</h3>

            <p>
              Performance analysis, wait events, SQL diagnostics,
              AWR, ASH and troubleshooting resources.
            </p>

            <span>Explore resources</span>
          </div>
        </a>


        <a href="/tools/high-availability/" class="tool-directory-card">
          <div class="tool-directory-icon">HA</div>

          <div class="tool-directory-content">
            <div class="tool-directory-label">AVAILABILITY</div>

            <h3>High Availability</h3>

            <p>
              RAC, Data Guard, disaster recovery, MAA and
              business continuity resources.
            </p>

            <span>Explore resources</span>
          </div>
        </a>


        <a href="/tools/backup-recovery/" class="tool-directory-card">
          <div class="tool-directory-icon">RMAN</div>

          <div class="tool-directory-content">
            <div class="tool-directory-label">PROTECTION</div>

            <h3>Backup & Recovery</h3>

            <p>
              RMAN, recovery procedures, backup strategies and
              operational database protection resources.
            </p>

            <span>Explore resources</span>
          </div>
        </a>


        <a href="/tools/migration/" class="tool-directory-card">
          <div class="tool-directory-icon">MIG</div>

          <div class="tool-directory-content">
            <div class="tool-directory-label">MODERNIZATION</div>

            <h3>Migration</h3>

            <p>
              Migration planning, Data Pump, ZDM, XTTS,
              platform migration and modernization resources.
            </p>

            <span>Explore resources</span>
          </div>
        </a>


        <a href="/tools/automation/" class="tool-directory-card">
          <div class="tool-directory-icon">AUTO</div>

          <div class="tool-directory-content">
            <div class="tool-directory-label">AUTOMATION</div>

            <h3>Automation & DevOps</h3>

            <p>
              Shell, Python, Ansible, Terraform, Jenkins,
              GitLab and infrastructure automation resources.
            </p>

            <span>Explore resources</span>
          </div>
        </a>

      </div>

    </div>
  </section>


  <section class="section section--soft">
    <div class="container">

      <div class="toolbox-note">

        <div class="eyebrow">
          ORASOLU IS GROWING
        </div>

        <h2>
          More practical resources are on the way.
        </h2>

        <p>
          The toolbox will continue to grow with SQL scripts,
          database utilities, automation examples, migration
          runbooks, diagnostics, labs and other resources built
          from real-world experience.
        </p>

        <a class="button button--primary" href="/articles/">
          Explore Articles
        </a>

      </div>

    </div>
  </section>

</BaseLayout>


<style>
  /* ==========================================================
     TOOLS PAGE
     ========================================================== */

  .tools-section {
    padding-top: 72px;
    padding-bottom: 88px;
  }

  .tools-intro {
    margin-bottom: 42px;
  }

  .tools-intro h2 {
    margin: 0 0 14px;
    font-size: clamp(28px, 3vw, 38px);
    line-height: 1.15;
    color: var(--ink);
  }

  .tools-intro p {
    max-width: 760px;
    margin: 0;
    color: var(--muted);
    font-size: 16px;
    line-height: 1.7;
  }


  /* ==========================================================
     DIRECTORY
     ========================================================== */

  .tools-directory {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
  }


  /* ==========================================================
     CARD
     ========================================================== */

  .tool-directory-card {
    display: flex;
    align-items: flex-start;
    gap: 20px;

    min-height: 220px;

    padding: 28px;

    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: 18px;

    color: var(--ink);
    text-decoration: none;

    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease,
      transform 0.2s ease;
  }

  .tool-directory-card:hover {
    border-color: rgba(244, 90, 36, 0.35);
    box-shadow: 0 14px 36px rgba(17, 29, 44, 0.08);
    transform: translateY(-3px);
  }


  /* ==========================================================
     ICON
     ========================================================== */

  .tool-directory-icon {
    flex: 0 0 54px;

    width: 54px;
    height: 54px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 50%;

    background: rgba(244, 90, 36, 0.10);
    color: var(--orange);

    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-align: center;
  }


  /* ==========================================================
     CONTENT
     ========================================================== */

  .tool-directory-content {
    min-width: 0;
    flex: 1;
  }

  .tool-directory-label {
    margin-bottom: 9px;

    color: var(--orange);

    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.14em;
    line-height: 1.2;
  }

  .tool-directory-content h3 {
    margin: 0 0 12px;

    color: var(--ink);

    font-size: 20px;
    font-weight: 750;
    line-height: 1.25;
  }

  .tool-directory-content p {
    margin: 0 0 22px;

    color: var(--muted);

    font-size: 14px;
    line-height: 1.65;
  }

  .tool-directory-content span {
    display: inline-block;

    color: var(--orange);

    font-size: 14px;
    font-weight: 700;
  }


  /* ==========================================================
     NOTE
     ========================================================== */

  .toolbox-note {
    max-width: 820px;
  }

  .toolbox-note h2 {
    margin: 0 0 14px;

    color: var(--ink);

    font-size: clamp(28px, 3vw, 38px);
    line-height: 1.15;
  }

  .toolbox-note p {
    max-width: 760px;
    margin: 0 0 28px;

    color: var(--muted);

    font-size: 16px;
    line-height: 1.75;
  }


  /* ==========================================================
     TABLET
     ========================================================== */

  @media (max-width: 980px) {

    .tools-directory {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

  }


  /* ==========================================================
     MOBILE
     ========================================================== */

  @media (max-width: 680px) {

    .tools-section {
      padding-top: 52px;
      padding-bottom: 64px;
    }

    .tools-intro {
      margin-bottom: 30px;
    }

    .tools-directory {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .tool-directory-card {
      min-height: auto;
      padding: 22px;
      border-radius: 16px;
    }

    .tool-directory-icon {
      flex-basis: 48px;
      width: 48px;
      height: 48px;
    }

    .tool-directory-content h3 {
      font-size: 18px;
    }

  }


  /* ==========================================================
     SMALL MOBILE
     ========================================================== */

  @media (max-width: 430px) {

    .tool-directory-card {
      gap: 15px;
      padding: 19px;
    }

    .tool-directory-icon {
      flex-basis: 44px;
      width: 44px;
      height: 44px;
      font-size: 9px;
    }

    .tool-directory-content p {
      font-size: 13px;
    }

  }
</style>