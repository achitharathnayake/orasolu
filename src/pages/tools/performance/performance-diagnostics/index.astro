---
import BaseLayout from "../../../../layouts/BaseLayout.astro";

const resources = [
  {
    label: "01 · SYSTEM WAITS",
    title: "Find the highest system wait events",
    description:
      "Start with instance-level wait time to identify where foreground activity is spending time.",
    sql: `SELECT
    event,
    wait_class,
    total_waits,
    ROUND(time_waited_micro / 1000000, 2) AS wait_seconds,
    ROUND(
        CASE
            WHEN total_waits > 0
            THEN time_waited_micro / total_waits / 1000
        END,
        2
    ) AS avg_wait_ms
FROM v$system_event
WHERE wait_class <> 'Idle'
ORDER BY time_waited_micro DESC
FETCH FIRST 20 ROWS ONLY;`,
  },
  {
    label: "02 · WAIT CLASSES",
    title: "Review wait activity by class",
    description:
      "Use wait classes to see whether the current pressure is concentrated in User I/O, Concurrency, Commit or another class.",
    sql: `SELECT
    wait_class,
    total_waits,
    ROUND(time_waited_micro / 1000000, 2) AS wait_seconds,
    ROUND(
        CASE
            WHEN total_waits > 0
            THEN time_waited_micro / total_waits / 1000
        END,
        2
    ) AS avg_wait_ms
FROM v$system_wait_class
WHERE wait_class <> 'Idle'
ORDER BY time_waited_micro DESC;`,
  },
  {
    label: "03 · ACTIVE SESSIONS",
    title: "See active sessions and current waits",
    description:
      "Combine session state, wait information and SQL identifiers to identify what is active right now.",
    sql: `SELECT
    sid,
    serial#,
    username,
    status,
    event,
    wait_class,
    state,
    seconds_in_wait,
    sql_id,
    blocking_session
FROM v$session
WHERE type = 'USER'
  AND status = 'ACTIVE'
ORDER BY seconds_in_wait DESC
FETCH FIRST 30 ROWS ONLY;`,
  },
  {
    label: "04 · LONG OPERATIONS",
    title: "Find long-running database operations",
    description:
      "Inspect operations with measurable progress to understand what is running for an extended period.",
    sql: `SELECT
    sid,
    serial#,
    opname,
    target,
    sofar,
    totalwork,
    units,
    start_time,
    elapsed_seconds,
    time_remaining
FROM v$session_longops
WHERE totalwork > 0
  AND sofar < totalwork
ORDER BY elapsed_seconds DESC
FETCH FIRST 20 ROWS ONLY;`,
  },
  {
    label: "05 · RESOURCE LIMITS",
    title: "Check current resource utilization",
    description:
      "Compare current and maximum utilization against configured limits for key database resources.",
    sql: `SELECT
    resource_name,
    current_utilization,
    max_utilization,
    limit_value
FROM v$resource_limit
ORDER BY resource_name;`,
  },
  {
    label: "06 · SQL MONITOR",
    title: "Review monitored SQL executions",
    description:
      "Use Real-Time SQL Monitoring data to inspect recent executions and their elapsed time, CPU and I/O activity.",
    sql: `SELECT
    m.sql_id,
    m.sql_exec_start,
    m.status,
    ROUND(m.elapsed_time / 1000000, 2) AS elapsed_seconds,
    ROUND(m.cpu_time / 1000000, 2) AS cpu_seconds,
    m.buffer_gets,
    m.disk_reads,
    SUBSTR(s.sql_text, 1, 1000) AS sql_text
FROM v$sql_monitor m
LEFT JOIN v$sql s
    ON s.sql_id = m.sql_id
WHERE m.sql_exec_start >= SYSDATE - 1/24
ORDER BY m.elapsed_time DESC
FETCH FIRST 20 ROWS ONLY;`,
  },
];
---

<BaseLayout
  title="Performance Diagnostics"
  description="Practical Oracle SQL for diagnosing waits, active sessions, long-running operations, resource pressure and monitored SQL."
>
  <section class="resource-hero">
    <div class="container">
      <p class="eyebrow">ORASOLU TOOLBOX · PERFORMANCE</p>
      <h1>Performance &amp; <span>Diagnostics</span></h1>
      <p>
        Practical Oracle performance scripts, diagnostics queries and
        investigation resources for everyday database troubleshooting.
      </p>
    </div>
  </section>

  <section class="resource-section">
    <div class="container">
      <div class="resource-intro">
        <p class="eyebrow">ORASOLU TOOLBOX · PERFORMANCE</p>
        <h2>Practical performance diagnostics for everyday database work</h2>
        <p>
          A collection of reusable queries for investigating waits, active
          sessions, resource pressure, long-running operations and monitored
          SQL.
        </p>
      </div>

      <div class="resource-grid">
        {
          resources.map((resource) => (
            <article class="resource-block">
              <div class="resource-block__header">
                <div class="resource-block__label">{resource.label}</div>
                <h2>{resource.title}</h2>
              </div>

              <p class="resource-block__description">{resource.description}</p>

              <pre><code>{resource.sql}</code></pre>
            </article>
          ))
        }
      </div>

      <div class="resource-note">
        <strong>Diagnostic workflow:</strong>
        establish the symptom, identify the dominant waits or active sessions,
        correlate the session with SQL and resources, then investigate the
        specific operation.
        Real-Time SQL Monitoring is an Oracle feature with licensing and
        configuration considerations in the target environment.
      </div>

      <div class="resource-actions">
        <a class="button button--primary" href="/tools/performance/">
          Back to Performance
        </a>
      </div>
    </div>
  </section>

  <script>
    document.querySelectorAll(".resource-block pre").forEach((pre) => {
      const button = document.createElement("button");
      button.type = "button";
      button.className = "resource-copy-button";
      button.textContent = "Copy";
      button.setAttribute("aria-label", "Copy SQL");

      pre.style.position = "relative";
      button.style.position = "absolute";
      button.style.top = "10px";
      button.style.right = "10px";
      button.style.padding = "5px 9px";
      button.style.border = "1px solid #d1d5db";
      button.style.borderRadius = "5px";
      button.style.background = "#ffffff";
      button.style.color = "#374151";
      button.style.fontFamily = "inherit";
      button.style.fontSize = "0.75rem";
      button.style.cursor = "pointer";
      button.style.zIndex = "2";

      button.addEventListener("click", async () => {
        const code = pre.querySelector("code");
        if (!code) return;

        try {
          await navigator.clipboard.writeText(code.textContent || "");
          button.textContent = "Copied";
          window.setTimeout(() => {
            button.textContent = "Copy";
          }, 1500);
        } catch {
          button.textContent = "Copy failed";
          window.setTimeout(() => {
            button.textContent = "Copy";
          }, 1500);
        }
      });

      pre.appendChild(button);
    });
  </script>

  <style>
    .resource-hero {
      padding-top: 82px;
      padding-bottom: 72px;
      border-bottom: 1px solid var(--line);
    }

    .resource-hero h1 {
      margin: 0 0 14px;
      color: var(--ink);
      font-size: clamp(42px, 6vw, 72px);
      line-height: 1.05;
      letter-spacing: -0.04em;
    }

    .resource-hero h1 span {
      color: var(--orange);
    }

    .resource-hero > .container > p:last-child {
      max-width: 900px;
      margin: 0;
      color: var(--muted);
      font-size: 17px;
      line-height: 1.75;
    }

    .resource-section {
      padding-top: 72px;
      padding-bottom: 72px;
    }

    .resource-intro {
      max-width: 820px;
      margin-bottom: 42px;
    }

    .resource-intro h2 {
      margin: 0 0 14px;
      color: var(--ink);
      font-size: clamp(28px, 3vw, 38px);
      line-height: 1.15;
    }

    .resource-intro > p:last-child {
      margin: 0;
      color: var(--muted);
      font-size: 16px;
      line-height: 1.75;
    }

    .resource-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 22px;
      align-items: start;
    }

    .resource-block {
      display: flex;
      flex-direction: column;
      min-width: 0;
      height: 560px;
      box-sizing: border-box;
      margin: 0;
      padding: 30px;
      background: #ffffff;
      border: 1px solid var(--line);
      border-radius: 18px;
      overflow: hidden;
      transition:
        border-color 0.22s ease,
        box-shadow 0.22s ease,
        transform 0.22s ease;
    }

    .resource-block:hover {
      border-color: #d8dce1;
      box-shadow: 0 12px 30px rgba(17, 29, 44, 0.06);
      transform: translateY(-3px);
    }

    .resource-block__header {
      margin-bottom: 10px;
    }

    .resource-block__label {
      margin-bottom: 9px;
      color: var(--orange);
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 0.14em;
      line-height: 1.2;
    }

    .resource-block h2 {
      margin: 0;
      color: var(--ink);
      font-size: 22px;
      line-height: 1.3;
    }

    .resource-block__description {
      min-height: 48px;
      margin: 0 0 22px;
      color: var(--muted);
      font-size: 14px;
      line-height: 1.7;
    }

    .resource-block pre {
      position: relative;
      flex: 1 1 auto;
      min-height: 0;
      margin: 0;
      padding: 22px;
      overflow-x: auto;
      overflow-y: auto;
      white-space: pre;
      background: #2f353d;
      border-radius: 10px;
      color: #f3f4f6;
      font-family:
        "Cascadia Code",
        "Consolas",
        "Courier New",
        monospace;
      font-size: 13px;
      line-height: 1.7;
    }

    .resource-block code {
      font-family: inherit;
      white-space: pre;
    }

    .resource-copy-button {
      position: absolute;
      top: 10px;
      right: 10px;
      padding: 5px 9px;
      border: 1px solid #d1d5db;
      border-radius: 5px;
      background: #ffffff;
      color: #374151;
      font-family: inherit;
      font-size: 0.75rem;
      cursor: pointer;
      z-index: 2;
    }

    .resource-copy-button:hover {
      background: #f3f4f6;
    }

    .resource-note {
      max-width: 820px;
      margin-top: 32px;
      color: var(--muted);
      font-size: 14px;
      line-height: 1.75;
    }

    .resource-note strong {
      color: var(--ink);
    }

    .resource-actions {
      display: flex;
      justify-content: flex-start;
      margin-top: 24px;
    }

    @media (max-width: 820px) {
      .resource-grid {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 680px) {
      .resource-hero {
        padding-top: 58px;
        padding-bottom: 54px;
      }

      .resource-hero h1 {
        font-size: clamp(38px, 12vw, 54px);
      }

      .resource-section {
        padding-top: 56px;
      }

      .resource-grid {
        grid-template-columns: 1fr;
        gap: 16px;
      }

      .resource-block {
        height: 520px;
        padding: 22px;
        border-radius: 16px;
      }

      .resource-block__description {
        min-height: 0;
      }

      .resource-block pre {
        padding: 18px;
        font-size: 12px;
      }
    }
  </style>
</BaseLayout>
