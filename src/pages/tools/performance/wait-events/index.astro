    color: var(--muted);

    font-size: 16px;
    line-height: 1.75;
  }


  .resource-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 22px;
  }


  .resource-block {
    display: flex;
    flex-direction: column;

    min-width: 0;

    padding: 30px;

    background: #ffffff;

    border: 1px solid var(--line);
    border-radius: 18px;

    transition:
      border-color 0.22s ease,
      box-shadow 0.22s ease,
      transform 0.22s ease;
  }


  .resource-block:hover {
