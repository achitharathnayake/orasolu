      "Courier New",
      monospace;

    font-size: 13px;
    line-height: 1.7;
  }


  .resource-block code {
    font-family: inherit;
  }


  .resource-note {
    max-width: 820px;

    margin-top: 56px;
    padding: 30px;

    background: #f7f8fa;

    border: 1px solid var(--line);
    border-radius: 18px;
  }


  .resource-note h2 {
    margin: 0 0 14px;

    color: var(--ink);

    font-size: clamp(24px, 3vw, 32px);
    line-height: 1.2;
  }


  .resource-note p {
    margin: 0 0 14px;

    color: var(--muted);

    font-size: 15px;
    line-height: 1.75;
  }


  .resource-note p:last-child {
    margin-bottom: 0;
  }


  .resource-copy-button {
    position: absolute;

    top: 10px;
    right: 10px;

    padding: 5px 9px;

    border: 1px solid #d1d5db;
    border-radius: 5px;

    background: #ffffff;
    color: #374151;

    font-family: inherit;
    font-size: 0.75rem;

    cursor: pointer;

    z-index: 2;
  }


  .resource-copy-button:hover {
    background: #f3f4f6;
  }


  @media (max-width: 820px) {


    .resource-grid {
