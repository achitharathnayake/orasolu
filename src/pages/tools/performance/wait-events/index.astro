  }


  .resource-block__label {
    margin-bottom: 9px;

    color: var(--orange);

    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.14em;
    line-height: 1.2;
  }


  .resource-block h2 {
    margin: 0;

    color: var(--ink);

    font-size: 22px;
    line-height: 1.3;
  }


  .resource-block__description {
    min-height: 48px;

    margin: 0 0 22px;

    color: var(--muted);

    font-size: 14px;
    line-height: 1.7;
  }


  .resource-block pre {
    position: relative;

    margin: 0;

