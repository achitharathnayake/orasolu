---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Blocking & Locks"
  description="Practical Oracle SQL for investigating blocking sessions, locks and contention."
>
  <main>
    <section class="page-hero">
      <div class="container">
        <div class="eyebrow">ORASOLU TOOLBOX · PERFORMANCE</div>
        <h1>Blocking &amp; Locks</h1>
        <p>
          Practical Oracle SQL for identifying blockers, blocked sessions,
          lock holders and the SQL associated with contention.
        </p>
      </div>
    </section>

    <section class="resource-section">
      <div class="container">
        <div class="resource-intro">
          <div class="eyebrow">ORASOLU TOOLBOX · PERFORMANCE</div>
          <h2>Find the session holding the lock and the session waiting for it</h2>
          <p>
            Start with the blocking relationship, then correlate the sessions
            with lock information, database objects and SQL before deciding
            how the contention should be investigated.
          </p>
        </div>

        <div class="resource-grid">
          <article class="resource-block">
            <div class="resource-block__header">
              <div class="resource-block__label">01 · BLOCKING SESSIONS</div>
              <h2>Find sessions blocking others</h2>
            </div>
            <p class="resource-block__description">
              Identify sessions holding a lock that another session is currently
              requesting.
            </p>
            <pre><code>SELECT
    blocker.sid AS blocker_sid,
    blocker.serial# AS blocker_serial,
    blocker.username AS blocker_username,
    waiter.sid AS waiter_sid,
    waiter.serial# AS waiter_serial,
    waiter.username AS waiter_username,
    waiter.event,
    waiter.seconds_in_wait
FROM v$lock blocker_lock
JOIN v$lock waiter_lock
    ON waiter_lock.id1 = blocker_lock.id1
   AND waiter_lock.id2 = blocker_lock.id2
JOIN v$session blocker
    ON blocker.sid = blocker_lock.sid
JOIN v$session waiter
    ON waiter.sid = waiter_lock.sid
WHERE blocker_lock.block = 1
  AND waiter_lock.request > 0
  AND blocker_lock.sid &lt;&gt; waiter_lock.sid
ORDER BY waiter.seconds_in_wait DESC;</code></pre>
          </article>

          <article class="resource-block">
            <div class="resource-block__header">
              <div class="resource-block__label">02 · BLOCKED SESSIONS</div>
              <h2>Find sessions waiting for blockers</h2>
            </div>
            <p class="resource-block__description">
              Review sessions currently reporting a blocking session and the
              wait event associated with the blocked workload.
            </p>
            <pre><code>SELECT
    sid,
    serial#,
    username,
    status,
    sql_id,
    blocking_session,
    blocking_session_status,
    event,
    wait_class,
    seconds_in_wait
FROM v$session
WHERE blocking_session IS NOT NULL
ORDER BY seconds_in_wait DESC;</code></pre>
          </article>

          <article class="resource-block">
            <div class="resource-block__header">
              <div class="resource-block__label">03 · BLOCKING CHAINS</div>
              <h2>Inspect the blocking hierarchy</h2>
            </div>
            <p class="resource-block__description">
              Review the immediate blocker and final blocker information to
              understand whether multiple sessions are waiting behind one root.
            </p>
            <pre><code>SELECT
    sid,
    serial#,
    username,
    sql_id,
    blocking_session,
    blocking_session_status,
    final_blocking_session,
    final_blocking_session_status,
    event,
    wait_class
FROM v$session
WHERE blocking_session IS NOT NULL
   OR final_blocking_session IS NOT NULL
ORDER BY final_blocking_session, blocking_session, sid;</code></pre>
          </article>

          <article class="resource-block">
            <div class="resource-block__header">
              <div class="resource-block__label">04 · LOCK DETAILS</div>
              <h2>Inspect current lock requests</h2>
            </div>
            <p class="resource-block__description">
              Compare locks held and locks requested by sessions using the
              lock type, mode and resource identifiers.
            </p>
            <pre><code>SELECT
    l.sid,
    s.serial#,
    s.username,
    l.type,
    l.id1,
    l.id2,
    l.lmode,
    l.request,
    l.ctime,
    l.block
FROM v$lock l
JOIN v$session s
    ON s.sid = l.sid
WHERE l.block = 1
   OR l.request &gt; 0
ORDER BY l.block DESC, l.request DESC, l.ctime DESC;</code></pre>
          </article>

          <article class="resource-block">
            <div class="resource-block__header">
              <div class="resource-block__label">05 · LOCKED OBJECTS</div>
              <h2>Find database objects involved in locks</h2>
            </div>
            <p class="resource-block__description">
              Map transaction locks to database objects to identify the table
              or object associated with the contention.
            </p>
            <pre><code>SELECT
    lo.session_id AS sid,
    s.serial#,
    s.username,
    lo.oracle_username,
    lo.locked_mode,
    lo.object_id,
    o.owner,
    o.object_name,
    o.object_type
FROM v$locked_object lo
JOIN v$session s
    ON s.sid = lo.session_id
JOIN dba_objects o
    ON o.object_id = lo.object_id
ORDER BY o.owner, o.object_name, lo.session_id;</code></pre>
          </article>

          <article class="resource-block">
            <div class="resource-block__header">
              <div class="resource-block__label">06 · BLOCKER SQL</div>
              <h2>Correlate the blocker with SQL</h2>
            </div>
            <p class="resource-block__description">
              Identify the SQL currently associated with a blocking session and
              continue the investigation into what is holding the resource.
            </p>
            <pre><code>SELECT
    s.sid,
    s.serial#,
    s.username,
    s.status,
    s.sql_id,
    s.prev_sql_id,
    s.event,
    s.wait_class,
    q.plan_hash_value,
    q.executions,
    q.elapsed_time,
    q.cpu_time,
    q.buffer_gets,
    q.sql_text
FROM v$session s
LEFT JOIN v$sql q
    ON q.sql_id = s.sql_id
WHERE s.sid = &amp;blocker_sid;</code></pre>
          </article>
        </div>

        <div class="resource-note">
          <div class="resource-note__label">ORASOLU TOOLBOX · PERFORMANCE</div>
          <h3>Blocking is a relationship between sessions, not just a wait event.</h3>
          <p>
            Identify the blocker, the blocked session and the resource involved,
            then correlate the relationship with SQL and application activity.
            A blocking session may be active, idle or waiting on another resource,
            so the session relationship should be investigated in context.
          </p>
        </div>

        <div class="resource-actions">
          <a class="button button--primary" href="/tools/performance/">
            Back to Performance
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  document.querySelectorAll(".resource-block pre").forEach((pre) => {
    const button = document.createElement("button");
    button.type = "button";
    button.className = "resource-copy-button";
    button.textContent = "Copy";
    button.setAttribute("aria-label", "Copy SQL");

    pre.style.position = "relative";

    button.style.position = "absolute";
    button.style.top = "10px";
    button.style.right = "10px";
    button.style.padding = "5px 9px";
    button.style.border = "1px solid #d1d5db";
    button.style.borderRadius = "5px";
    button.style.background = "#ffffff";
    button.style.color = "#374151";
    button.style.fontFamily = "inherit";
    button.style.fontSize = "0.75rem";
    button.style.cursor = "pointer";
    button.style.zIndex = "2";

    button.addEventListener("click", async () => {
      const code = pre.querySelector("code");
      if (!code) return;

      try {
        await navigator.clipboard.writeText(code.textContent || "");
        button.textContent = "Copied";
        window.setTimeout(() => {
          button.textContent = "Copy";
        }, 1500);
      } catch {
        button.textContent = "Copy failed";
        window.setTimeout(() => {
          button.textContent = "Copy";
        }, 1500);
      }
    });

    pre.appendChild(button);
  });
</script>

<style>
.resource-section {
  padding-top: 56px;
  padding-bottom: 72px;
}

.resource-intro {
  max-width: 820px;
  margin-bottom: 32px;
}

.resource-intro h2 {
  margin: 0 0 14px;
  color: var(--ink);
  font-size: clamp(28px, 3vw, 38px);
  line-height: 1.15;
}

.resource-intro p {
  margin: 0;
  color: var(--muted);
  font-size: 16px;
  line-height: 1.75;
}

.resource-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 22px;
  align-items: start;
}

.resource-block {
  display: flex;
  flex-direction: column;
  min-width: 0;
  height: 560px;
  box-sizing: border-box;
  margin: 0;
  padding: 30px;
  overflow: hidden;
  background: #ffffff;
  border: 1px solid var(--line);
  border-radius: 18px;
  transition:
    border-color 0.22s ease,
    box-shadow 0.22s ease,
    transform 0.22s ease;
}

.resource-block:hover {
  border-color: #d8dce1;
  box-shadow: 0 12px 30px rgba(17, 29, 44, 0.06);
  transform: translateY(-3px);
}

.resource-block__header {
  margin-bottom: 10px;
}

.resource-block__label {
  margin-bottom: 9px;
  color: var(--orange);
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.14em;
  line-height: 1.2;
}

.resource-block h2 {
  margin: 0;
  color: var(--ink);
  font-size: 22px;
  line-height: 1.3;
}

.resource-block__description {
  min-height: 48px;
  margin: 0 0 22px;
  color: var(--muted);
  font-size: 14px;
  line-height: 1.7;
}

.resource-block pre {
  position: relative;
  flex: 1 1 auto;
  min-height: 0;
  margin: 0;
  padding: 22px;
  overflow-x: auto;
  overflow-y: auto;
  background: #2f353d;
  border-radius: 10px;
  color: #f3f4f6;
  font-family:
    "Cascadia Code",
    "Consolas",
    "Courier New",
    monospace;
  font-size: 13px;
  line-height: 1.7;
  white-space: pre;
}

.resource-block code {
  font-family: inherit;
  white-space: pre;
}

.resource-copy-button {
  position: absolute;
  top: 10px;
  right: 10px;
  padding: 5px 9px;
  border: 1px solid #d1d5db;
  border-radius: 5px;
  background: #ffffff;
  color: #374151;
  font-family: inherit;
  font-size: 0.75rem;
  cursor: pointer;
  z-index: 2;
}

.resource-copy-button:hover {
  background: #f3f4f6;
}

.resource-note {
  margin-top: 32px;
  padding: 30px;
  background: #f7f8fa;
  border: 1px solid var(--line);
  border-radius: 18px;
}

.resource-note__label {
  margin-bottom: 10px;
  color: var(--orange);
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.14em;
}

.resource-note h3 {
  margin: 0 0 12px;
  color: var(--ink);
  font-size: 22px;
  line-height: 1.3;
}

.resource-note p {
  margin: 0;
  color: var(--muted);
  font-size: 15px;
  line-height: 1.75;
}

.resource-actions {
  display: flex;
  align-items: center;
  gap: 24px;
  margin-top: 32px;
}

@media (max-width: 820px) {
  .resource-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 680px) {
  .resource-section {
    padding-top: 52px;
    padding-bottom: 64px;
  }

  .resource-grid {
    grid-template-columns: 1fr;
    gap: 16px;
  }

  .resource-block {
    height: 520px;
    padding: 22px;
    border-radius: 16px;
  }

  .resource-block__description {
    min-height: 0;
  }

  .resource-block pre {
    padding: 18px;
    font-size: 12px;
  }

  .resource-note {
    padding: 22px;
    border-radius: 16px;
  }

  .resource-actions {
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
  }
}
</style>
