---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
---

<BaseLayout>

  <section class="page-hero">
    <div class="container">

      <div class="eyebrow">ORASOLU TOOLBOX &middot; PERFORMANCE</div>

      <h1>
        SQL Performance
      </h1>

      <p>
        Practical Oracle SQL for identifying expensive statements,
        understanding execution activity and investigating SQL performance.
      </p>

    </div>
  </section>


  <section class="section resource-section">
    <div class="container">

      <div class="resource-intro">

        <div class="eyebrow">ORASOLU TOOLBOX &middot; PERFORMANCE</div>

        <h2>
          Find the SQL statements consuming database resources
        </h2>

        <p>
          Start with the workload and identify statements consuming
          significant database resources. Correlate SQL statistics with
          sessions, wait events and execution plans before investigating
          the underlying cause.
        </p>

      </div>


      <div class="resource-grid">

        <article class="resource-block">

          <div class="resource-block__header">
            <div class="resource-block__label">
              01 &middot; ELAPSED TIME
            </div>

            <h2>
              Find top SQL by elapsed time
            </h2>
          </div>

          <p class="resource-block__description">
            Identify SQL statements that have consumed the most total
            elapsed time in the shared SQL area.
          </p>

          <pre><code>SELECT
    sql_id,
    plan_hash_value,
    executions,
    ROUND(elapsed_time / 1000000, 2) AS elapsed_seconds,
    ROUND(
        CASE
            WHEN executions &gt; 0
            THEN elapsed_time / executions / 1000
        END,
        2
    ) AS avg_elapsed_ms,
    sql_text
FROM v$sql
WHERE executions &gt; 0
ORDER BY elapsed_time DESC
FETCH FIRST 20 ROWS ONLY;</code></pre>

        </article>


        <article class="resource-block">

          <div class="resource-block__header">
            <div class="resource-block__label">
              02 &middot; CPU TIME
            </div>

            <h2>
              Find top SQL by CPU time
            </h2>
          </div>

          <p class="resource-block__description">
            Find statements responsible for significant CPU consumption
            and focus further investigation on their execution behaviour.
          </p>

          <pre><code>SELECT
    sql_id,
    plan_hash_value,
    executions,
    ROUND(cpu_time / 1000000, 2) AS cpu_seconds,
    ROUND(
        CASE
            WHEN executions &gt; 0
            THEN cpu_time / executions / 1000
        END,
        2
    ) AS avg_cpu_ms,
    sql_text
FROM v$sql
WHERE executions &gt; 0
ORDER BY cpu_time DESC
FETCH FIRST 20 ROWS ONLY;</code></pre>

        </article>


        <article class="resource-block">

          <div class="resource-block__header">
            <div class="resource-block__label">
              03 &middot; BUFFER GETS
            </div>

            <h2>
              Find top SQL by buffer gets
            </h2>
          </div>

          <p class="resource-block__description">
            Identify statements performing large amounts of logical I/O
            and investigate inefficient access paths or excessive work.
          </p>

          <pre><code>SELECT
    sql_id,
    plan_hash_value,
    executions,
    buffer_gets,
    ROUND(
        CASE
            WHEN executions &gt; 0
            THEN buffer_gets / executions
        END
    ) AS avg_buffer_gets,
    sql_text
FROM v$sql
WHERE executions &gt; 0
ORDER BY buffer_gets DESC
FETCH FIRST 20 ROWS ONLY;</code></pre>

        </article>


        <article class="resource-block">

          <div class="resource-block__header">
            <div class="resource-block__label">
              04 &middot; PHYSICAL READS
            </div>

            <h2>
              Find top SQL by physical reads
            </h2>
          </div>

          <p class="resource-block__description">
            Find statements generating significant physical reads and
            identify SQL that may be driving unnecessary I/O.
          </p>

          <pre><code>SELECT
    sql_id,
    plan_hash_value,
    executions,
    disk_reads,
    ROUND(
        CASE
            WHEN executions &gt; 0
            THEN disk_reads / executions
        END
    ) AS avg_disk_reads,
    sql_text
FROM v$sql
WHERE executions &gt; 0
ORDER BY disk_reads DESC
FETCH FIRST 20 ROWS ONLY;</code></pre>

        </article>


        <article class="resource-block">

          <div class="resource-block__header">
            <div class="resource-block__label">
              05 &middot; EXECUTION STATISTICS
            </div>

            <h2>
              Review SQL execution statistics
            </h2>
          </div>

          <p class="resource-block__description">
            Compare executions, elapsed time, CPU, logical reads and
            physical reads to understand how a statement is behaving.
          </p>

          <pre><code>SELECT
    sql_id,
    plan_hash_value,
    executions,
    ROUND(elapsed_time / 1000000, 2) AS elapsed_seconds,
    ROUND(cpu_time / 1000000, 2) AS cpu_seconds,
    buffer_gets,
    disk_reads,
    rows_processed
FROM v$sql
WHERE executions &gt; 0
ORDER BY elapsed_time DESC
FETCH FIRST 20 ROWS ONLY;</code></pre>

        </article>


        <article class="resource-block">

          <div class="resource-block__header">
            <div class="resource-block__label">
              06 &middot; SQL TEXT
            </div>

            <h2>
              Investigate SQL text
            </h2>
          </div>

          <p class="resource-block__description">
            Locate a statement by SQL ID and inspect its text together
            with the main execution statistics.
          </p>

          <pre><code>SELECT
    sql_id,
    plan_hash_value,
    executions,
    ROUND(elapsed_time / 1000000, 2) AS elapsed_seconds,
    ROUND(cpu_time / 1000000, 2) AS cpu_seconds,
    buffer_gets,
    disk_reads,
    sql_text
FROM v$sql
WHERE sql_id = '&amp;sql_id';</code></pre>

        </article>

      </div>


      <div class="resource-note">

        <div class="eyebrow">ORASOLU TOOLBOX &middot; PERFORMANCE</div>

        <h2>
          SQL statistics show where to investigate, not automatically why.
        </h2>

        <p>
          Start with the resource that is elevated, then correlate the
          SQL with executions, sessions, wait events and execution plans.
          A statement with high total consumption may behave differently
          from one with high resource consumption per execution.
        </p>

      </div>


      <div class="resource-actions">

        <a class="button button--primary" href="/tools/performance/">
          Back to Performance
        </a>

      </div>

    </div>
  </section>

</BaseLayout>


<script>
  document.querySelectorAll(".resource-block pre").forEach((pre) => {
    const button = document.createElement("button");

    button.type = "button";
    button.className = "resource-copy-button";
    button.textContent = "Copy";
    button.setAttribute("aria-label", "Copy SQL");

    pre.style.position = "relative";

    button.style.position = "absolute";
    button.style.top = "10px";
    button.style.right = "10px";
    button.style.padding = "5px 9px";
    button.style.border = "1px solid #d1d5db";
    button.style.borderRadius = "5px";
    button.style.background = "#ffffff";
    button.style.color = "#374151";
    button.style.fontFamily = "inherit";
    button.style.fontSize = "0.75rem";
    button.style.cursor = "pointer";
    button.style.zIndex = "2";

    button.addEventListener("click", async () => {
      const code = pre.querySelector("code");

      if (!code) return;

      try {
        await navigator.clipboard.writeText(code.textContent || "");

        button.textContent = "Copied";

        window.setTimeout(() => {
          button.textContent = "Copy";
        }, 1500);
      } catch {
        button.textContent = "Copy failed";

        window.setTimeout(() => {
          button.textContent = "Copy";
        }, 1500);
      }
    });

    pre.appendChild(button);
  });
</script>


<style>

  .resource-section {
    padding-top: 56px;
    padding-bottom: 72px;
  }


  .resource-intro {
    max-width: 820px;
    margin-bottom: 32px;
  }


  .resource-intro h2 {
    margin: 0 0 14px;

    color: var(--ink);

    font-size: clamp(28px, 3vw, 38px);
    line-height: 1.15;
  }


  .resource-intro p {
    margin: 0;

    color: var(--muted);

    font-size: 16px;
    line-height: 1.75;
  }


  .resource-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 22px;
    align-items: start;
  }


  .resource-block {
    display: flex;
    flex-direction: column;
    min-width: 0;
    height: 560px;
    box-sizing: border-box;
    margin: 0;
    padding: 30px;
    overflow: hidden;

    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: 18px;

    transition:
      border-color 0.22s ease,
      box-shadow 0.22s ease,
      transform 0.22s ease;
  }


  .resource-block:hover {
    border-color: #d8dce1;
    box-shadow: 0 12px 30px rgba(17, 29, 44, 0.06);
    transform: translateY(-3px);
  }


  .resource-block__header {
    margin-bottom: 10px;
  }


  .resource-block__label {
    margin-bottom: 9px;

    color: var(--orange);

    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.14em;
    line-height: 1.2;
  }


  .resource-block h2 {
    margin: 0;

    color: var(--ink);

    font-size: 22px;
    line-height: 1.3;
  }


  .resource-block__description {
    min-height: 48px;
    margin: 0 0 22px;

    color: var(--muted);

    font-size: 14px;
    line-height: 1.7;
  }


  .resource-block pre {
    flex: 1 1 auto;
    min-height: 0;

    margin: 0;
    padding: 22px;

    overflow-x: auto;
    overflow-y: auto;

    background: #2f353d;
    border-radius: 10px;

    color: #f3f4f6;

    font-family:
      "Cascadia Code",
      "Consolas",
      "Courier New",
      monospace;

    font-size: 13px;
    line-height: 1.7;

    white-space: pre;
  }


  .resource-block code {
    font-family: inherit;
    white-space: pre;
  }


  .resource-note {
    margin-top: 32px;
    padding: 30px;

    background: #f7f8fa;
    border: 1px solid var(--line);
    border-radius: 18px;
  }


  .resource-note h2 {
    margin: 0 0 14px;

    color: var(--ink);

    font-size: 24px;
    line-height: 1.3;
  }


  .resource-note p {
    max-width: 820px;
    margin: 0;

    color: var(--muted);

    font-size: 15px;
    line-height: 1.75;
  }


  .resource-actions {
    display: flex;
    align-items: center;
    gap: 24px;

    margin-top: 32px;
  }


  .resource-copy-button {
    position: absolute;
    top: 10px;
    right: 10px;

    padding: 5px 9px;

    border: 1px solid #d1d5db;
    border-radius: 5px;

    background: #ffffff;
    color: #374151;

    font-family: inherit;
    font-size: 0.75rem;

    cursor: pointer;
    z-index: 2;
  }


  .resource-copy-button:hover {
    background: #f3f4f6;
  }


  @media (max-width: 820px) {

    .resource-grid {
      grid-template-columns: 1fr;
    }

  }


  @media (max-width: 680px) {

    .resource-section {
      padding-top: 52px;
      padding-bottom: 64px;
    }


    .resource-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }


    .resource-block {
      height: 520px;
      padding: 22px;
      border-radius: 16px;
    }


    .resource-block__description {
      min-height: 0;
    }


    .resource-block pre {
      padding: 18px;
      font-size: 12px;
    }


    .resource-note {
      padding: 22px;
      border-radius: 16px;
    }


    .resource-actions {
      align-items: flex-start;
      flex-direction: column;
      gap: 18px;
    }

  }

</style>