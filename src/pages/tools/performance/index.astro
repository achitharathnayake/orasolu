---
import BaseLayout from "../../../layouts/BaseLayout.astro";
---

<BaseLayout>

  <section class="page-hero">
    <div class="container">

      <div class="eyebrow">ORASOLU TOOLBOX &middot; DIAGNOSTICS</div>

      <h1>
        Performance <span>& Diagnostics</span>
      </h1>

      <p>
        Practical Oracle resources for understanding workload,
        wait events, SQL performance and database behaviour.
      </p>

    </div>
  </section>


  <section class="section performance-section">
    <div class="container">

      <div class="section-intro performance-intro">
        <div>
          <div class="eyebrow">ORASOLU TOOLBOX &middot; DIAGNOSTICS</div>

          <h2>
            Practical performance investigation
          </h2>

          <p>
            A growing collection of queries and diagnostic resources
            for understanding Oracle database performance from
            workload and symptoms through to deeper investigation.
          </p>
        </div>
      </div>


      <div class="performance-resource-grid">

        <a href="/tools/performance/wait-events/" class="performance-resource-card">

          <div class="performance-resource-card__label">
            WAITS
          </div>

          <h3>
            Wait Events
          </h3>

          <p>
            Understand database wait activity and use wait events
            as clues during performance investigation.
          </p>

          <span class="performance-resource-card__action">
            Explore
          </span>

        </a>


        <a href="/tools/performance/sql-performance/" class="performance-resource-card">

          <div class="performance-resource-card__label">
            SQL
          </div>

          <h3>
            SQL Performance
          </h3>

          <p>
            Investigate SQL execution, resource consumption and
            performance characteristics.
          </p>

          <span class="performance-resource-card__action">
            Explore
          </span>

        </a>


        <a href="/tools/performance/session-performance/" class="performance-resource-card">

          <div class="performance-resource-card__label">
            SESSIONS
          </div>

          <h3>
            Session Performance
          </h3>

          <p>
            Review active sessions, workload and session-level
            performance indicators.
          </p>

          <span class="performance-resource-card__action">
            Explore
          </span>

        </a>


        <a href="/tools/performance/blocking-locks/" class="performance-resource-card">

          <div class="performance-resource-card__label">
            CONCURRENCY
          </div>

          <h3>
            Blocking & Locks
          </h3>

          <p>
            Investigate blocking sessions, locks and concurrency
            issues affecting database activity.
          </p>

          <span class="performance-resource-card__action">
            Explore
          </span>

        </a>


        <a href="/tools/performance/awr-ash/" class="performance-resource-card">

          <div class="performance-resource-card__label">
            HISTORY
          </div>

          <h3>
            AWR & ASH
          </h3>

          <p>
            Practical resources for working with historical workload
            and active session information.
          </p>

          <span class="performance-resource-card__action">
            Explore
          </span>

        </a>


        <a href="/tools/performance/performance-diagnostics/" class="performance-resource-card">

          <div class="performance-resource-card__label">
            DIAGNOSTICS
          </div>

          <h3>
            Performance Diagnostics
          </h3>

          <p>
            A structured starting point for investigating database
            performance symptoms and workload behaviour.
          </p>

          <span class="performance-resource-card__action">
            Explore
          </span>

        </a>

      </div>

    </div>
  </section>


  <section class="section section--soft">
    <div class="container">

      <div class="performance-note">

        <div class="eyebrow">ORASOLU TOOLBOX &middot; DIAGNOSTICS</div>

        <h2>
          Performance investigation starts with evidence.
        </h2>

        <p>
          Use waits, sessions, SQL, workload and historical data
          together. A single metric or wait event rarely explains
          the complete performance problem.
        </p>

        <a class="button button--primary" href="/tools/">
          Back to Tools
        </a>

      </div>

    </div>
  </section>

</BaseLayout>


<style>

  .performance-section {
    padding-top: 56px;
    padding-bottom: 64px;
  }


  .performance-intro {
    margin-bottom: 32px;
  }


  .performance-intro h2 {
    margin: 0 0 14px;
    font-size: clamp(28px, 3vw, 38px);
    line-height: 1.15;
    color: var(--ink);
  }


  .performance-intro p {
    max-width: 760px;
    margin: 0;
    color: var(--muted);
    font-size: 16px;
    line-height: 1.7;
  }


  .performance-resource-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
  }


  .performance-resource-card {
    display: block;

    min-height: 220px;
    padding: 28px;

    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: 18px;

    color: inherit;
    text-decoration: none;

    cursor: pointer;

    transition:
      border-color 0.22s ease,
      box-shadow 0.22s ease,
      transform 0.22s ease,
      background-color 0.22s ease;
  }


  .performance-resource-card:hover {
  border-color: var(--orange);
  box-shadow: 0 10px 24px rgba(17, 29, 44, 0.08);
  transform: translateY(-2px);
}


  .performance-resource-card__label {
    margin-bottom: 12px;

    color: var(--orange);

    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.14em;
    line-height: 1.2;
  }


  .performance-resource-card h3 {
    margin: 0 0 12px;

    color: var(--ink);

    font-size: 20px;
    font-weight: 750;
    line-height: 1.25;

    transition:
      color 0.22s ease,
      transform 0.22s ease;
  }


  .performance-resource-card:hover h3 {
    color: var(--orange);
    transform: none;
  }


  .performance-resource-card p {
    margin: 0 0 22px;

    color: var(--muted);

    font-size: 14px;
    line-height: 1.65;
  }


  .performance-resource-card__action {
    display: inline-block;

    color: var(--orange);

    font-size: 14px;
    font-weight: 700;

    transition:
      color 0.22s ease,
      transform 0.22s ease;
  }


  .performance-resource-card:hover .performance-resource-card__action {
    color: var(--orange);
    transform: none;
  }


  .performance-note {
    max-width: 820px;
  }


  .performance-note h2 {
    margin: 0 0 14px;

    color: var(--ink);

    font-size: clamp(28px, 3vw, 38px);
    line-height: 1.15;
  }


  .performance-note p {
    max-width: 760px;
    margin: 0 0 28px;

    color: var(--muted);

    font-size: 16px;
    line-height: 1.75;
  }


  @media (max-width: 980px) {

    .performance-resource-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

  }


  @media (max-width: 680px) {

    .performance-section {
      padding-top: 52px;
      padding-bottom: 64px;
    }

    .performance-intro {
      margin-bottom: 30px;
    }

    .performance-resource-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .performance-resource-card {
      min-height: auto;
      padding: 22px;
      border-radius: 16px;
    }

  }

</style>