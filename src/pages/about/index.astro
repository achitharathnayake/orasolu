---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout>

  <!-- ABOUT HERO -->
  <section class="page-hero">
    <div class="container">

      <div class="eyebrow">
        ABOUT ORASOLU
      </div>

      <h1>
        Technology, Experience<br />
        <span>&amp; Knowledge</span>
      </h1>

      <p>
        ORASOLU is a technical knowledge platform built around more than
        13 years of hands-on experience across databases, cloud,
        infrastructure, DevOps, automation and enterprise technology.
      </p>

    </div>
  </section>


  <!-- PERSON BEHIND ORASOLU -->
  <section class="section about-person-section">
    <div class="container">

      <div class="about-person">

        <div class="about-person-photo">

          <img
            src="/images/achitha-rathnayake.png"
            alt="Achitha Rathnayake"
          />

        </div>


        <div class="about-person-content">

          <div class="eyebrow">
            THE PERSON BEHIND ORASOLU
          </div>

          <h2>
            Achitha Rathnayake
          </h2>

          <div class="about-role">
            IT Professional · Technology Practitioner
          </div>

          <p>
            An IT professional with over 13 years of experience working
            across enterprise technology environments, with hands-on
            experience spanning databases, cloud, infrastructure,
            DevOps, automation and technical operations.
          </p>

          <p>
            Oracle Database is a major area of expertise, alongside
            experience with PostgreSQL, MongoDB, cloud platforms,
            Linux, infrastructure technologies and automation.
          </p>

          <p>
            My work has involved architecture, modernization,
            migrations, performance, high availability, operational
            reliability and technical problem solving across
            complex technology environments.
          </p>

          <p>
            ORASOLU brings that experience together in one place —
            documenting practical knowledge, technical solutions,
            experiments, tools and lessons learned along the way.
          </p>


          <div class="about-actions">

            <a
              class="button button--primary"
              href="https://www.linkedin.com/in/achitha-r/"
              target="_blank"
              rel="noreferrer"
            >
              LinkedIn →
            </a>

            <a
              class="button button--secondary"
              href="/articles/"
            >
              Explore Articles →
            </a>

          </div>

        </div>

      </div>

    </div>
  </section>


  <!-- PROFESSIONAL SCOPE -->
  <section class="section section--soft">
    <div class="container">

      <div class="section-intro">

        <div class="eyebrow">
          PROFESSIONAL SCOPE
        </div>

        <h2>
          More than one technology.
        </h2>

        <p>
          A broad technology background built through years of
          hands-on experience across different platforms,
          environments and technical disciplines.
        </p>

      </div>


      <div class="expertise-grid">

        <article class="expertise-card">

          <div class="expertise-icon">
            ◉
          </div>

          <h3>
            Databases
          </h3>

          <p>
            Database platforms, architecture, administration,
            performance, security, availability and operational
            reliability.
          </p>

          <div class="expertise-tags">
            <span>Oracle</span>
            <span>PostgreSQL</span>
            <span>MongoDB</span>
            <span>RAC</span>
            <span>Data Guard</span>
            <span>Exadata</span>
          </div>

        </article>


        <article class="expertise-card">

          <div class="expertise-icon">
            ☁
          </div>

          <h3>
            Cloud &amp; Infrastructure
          </h3>

          <p>
            Cloud platforms, Linux environments, enterprise
            infrastructure and database infrastructure.
          </p>

          <div class="expertise-tags">
            <span>OCI</span>
            <span>AWS</span>
            <span>Alibaba Cloud</span>
            <span>Linux</span>
            <span>ExaCC</span>
          </div>

        </article>


        <article class="expertise-card">

          <div class="expertise-icon">
            ⚒
          </div>

          <h3>
            DevOps &amp; Automation
          </h3>

          <p>
            Automation, CI/CD, infrastructure as code and scripting
            across database and infrastructure environments.
          </p>

          <div class="expertise-tags">
            <span>Jenkins</span>
            <span>GitLab</span>
            <span>Ansible</span>
            <span>Terraform</span>
            <span>Shell</span>
            <span>Python</span>
          </div>

        </article>


        <article class="expertise-card">

          <div class="expertise-icon">
            →
          </div>

          <h3>
            Migration &amp; Modernization
          </h3>

          <p>
            Platform migrations, modernization initiatives,
            technology transitions and migration strategies.
          </p>

          <div class="expertise-tags">
            <span>ZDM</span>
            <span>Data Pump</span>
            <span>XTTS</span>
            <span>RMAN</span>
            <span>GoldenGate</span>
          </div>

        </article>


        <article class="expertise-card">

          <div class="expertise-icon">
            ✣
          </div>

          <h3>
            Reliability &amp; Availability
          </h3>

          <p>
            High availability, disaster recovery, backup,
            recovery, business continuity and operational
            reliability.
          </p>

          <div class="expertise-tags">
            <span>RAC</span>
            <span>Data Guard</span>
            <span>MAA</span>
            <span>RMAN</span>
            <span>DR</span>
          </div>

        </article>


        <article class="expertise-card">

          <div class="expertise-icon">
            ◇
          </div>

          <h3>
            Technical Leadership
          </h3>

          <p>
            Technical advisory, architecture guidance, problem
            solving, client engagement and team guidance.
          </p>

          <div class="expertise-tags">
            <span>Architecture</span>
            <span>Advisory</span>
            <span>ITIL</span>
            <span>SLA / OLA</span>
          </div>

        </article>

      </div>

    </div>
  </section>


  <!-- ORASOLU PURPOSE -->
  <section class="section">
    <div class="container">

      <div class="about-purpose">

        <div>

          <div class="eyebrow">
            WHY ORASOLU
          </div>

          <h2>
            Document the work.<br />
            Share the knowledge.
          </h2>

        </div>


        <div>

          <p>
            ORASOLU is a place to document technical work that can
            be useful beyond a single project or environment.
          </p>

          <p>
            Articles, scripts, tools, experiments, migration
            approaches, troubleshooting techniques and lessons
            learned will gradually become part of the platform.
          </p>

          <p>
            The goal is simple: make practical technical knowledge
            easier to discover, understand and apply.
          </p>

        </div>

      </div>

    </div>
  </section>


  <!-- CONNECT -->
  <section class="section section--soft">
    <div class="container">

      <div class="about-connect">

        <div>

          <div class="eyebrow">
            CONNECT
          </div>

          <h2>
            Follow the work beyond ORASOLU.
          </h2>

          <p>
            ORASOLU is the central hub for technical knowledge,
            projects and contributions. Professional and community
            profiles provide additional ways to follow the work.
          </p>

        </div>


        <div class="about-connect-actions">

          <a
            class="button button--primary"
            href="https://www.linkedin.com/in/achitha-r/"
            target="_blank"
            rel="noreferrer"
          >
            LinkedIn →
          </a>

          <a
            class="button button--secondary"
            href="https://github.com/achitharathnayake"
            target="_blank"
            rel="noreferrer"
          >
            GitHub →
          </a>

          <a
            class="button button--secondary"
            href="https://sloug.org/"
            target="_blank"
            rel="noreferrer"
          >
            SLOUG →
          </a>

        </div>

      </div>

    </div>
  </section>

</BaseLayout>