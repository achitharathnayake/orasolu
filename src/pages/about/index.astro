 <!-- KEEP EXPLORING -->
<section class="section about-explore-section">
<div class="container">
  <div class="about-explore">
    <div>
      <div class="eyebrow">KEEP EXPLORING</div>
      <h2>Continue into the engineering work.</h2>
      <p>
        Explore the technical articles and tools built around Oracle Database,
        infrastructure, automation and real-world operations.
      </p>
    </div>

    <div class="about-explore-actions">
      <a class="button button--primary" href="/articles/">Read Articles</a>
      <a class="button button--secondary" href="/tools/">Explore Toolbox</a>
    </div>
  </div>
</div>
</section>

<style>
.about-explore-section {
background: #fff;
}

.about-explore {
display: grid;
grid-template-columns: minmax(0, 1fr) auto;
align-items: center;
gap: 32px;
padding: 30px 34px;
background: #f3f5f8;
border: 1px solid var(--line);
border-radius: 14px;
box-shadow: 0 10px 28px rgba(17, 29, 44, .06);
}

.about-explore h2 {
margin: 0.4rem 0 0.7rem;
}

.about-explore p {
max-width: 720px;
margin: 0;
color: var(--muted);
line-height: 1.7;
}

.about-explore-actions {
display: flex;
align-items: center;
gap: 12px;
flex-wrap: wrap;
}

.about-explore-actions .button {
white-space: nowrap;
}

@media (max-width: 760px) {
.about-explore {
grid-template-columns: 1fr;
gap: 20px;
padding: 24px;
}

.about-explore-actions {
justify-content: flex-start;
}
}
</style>

</BaseLayout>
<style id="orasolu-social-buttons">

  /* ORASOLU social buttons */

  .social-links {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
  }

  .social-links a,
  a[href*="linkedin.com"] {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0 18px;
    border: 1px solid #e1e6ed;
    border-radius: 10px;
    background: #ffffff;
    color: #172235;
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
    line-height: 1;
    transition:
      background .2s ease,
      border-color .2s ease,
      box-shadow .2s ease,
      transform .2s ease;
  }

  /* LinkedIn primary button */

  .social-links a[href*="linkedin.com"],
  a[href*="linkedin.com"] {
    background: #f45a24;
    border-color: #f45a24;
    color: #ffffff;
    box-shadow: 0 8px 20px rgba(244, 90, 36, .16);
  }

  /* Hover */

  .social-links a:hover,
  a[href*="linkedin.com"]:hover:hover {
    transform: translateY(-1px);
    border-color: #d5dce5;
    box-shadow: 0 8px 20px rgba(23, 34, 53, .08);
  }

  a[href*="linkedin.com"]:hover {
    background: #e94f1b;
    border-color: #e94f1b;
  }

  /* Remove visual arrow-like pseudo elements if present */

  .social-links a::after,
  .social-links a::before,
  a[href*="linkedin.com"]::after::after {
    content: none !important;
    display: none !important;
  }

  .social-logo-wrap {
    width: 18px;
    height: 18px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .social-logo-wrap img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  /* Tablet */

  @media (max-width: 760px) {

    .social-links {
      gap: 8px;
    }

    .social-links a,
    a[href*="linkedin.com"] {
      min-height: 42px;
      padding: 0 15px;
    }
  }

  /* Mobile */

  @media (max-width: 480px) {

    .social-links {
      width: 100%;
      flex-direction: column;
      align-items: stretch;
    }

    .social-links a,
    a[href*="linkedin.com"] {
      width: 100%;
      box-sizing: border-box;
    }
  }

</style>
<style id="orasolu-social-icons">

  .social-links a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
  }

  .social-icon {
    width: 17px;
    height: 17px;
    display: block;
    flex-shrink: 0;
  }

  .social-logo-wrap {
    width: 18px;
    height: 18px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    overflow: hidden;
    border-radius: 50%;
  }

  .social-logo-wrap img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .social-links a::before,
  .social-links a::after {
    content: none !important;
    display: none !important;
  }

  @media (max-width: 640px) {

    .social-links {
      width: 100%;
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }

    .social-links a {
      min-height: 42px;
      padding: 0 15px;
    }

  }

  @media (max-width: 420px) {

    .social-links {
      flex-direction: column;
      align-items: stretch;
    }

    .social-links a {
      width: 100%;
      box-sizing: border-box;
    }

  }

</style>
<style id="profile-linkedin-icon-style">

  .profile-linkedin-icon {
    width: 38px;
    height: 38px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--ink);
    text-decoration: none;
    border-radius: 8px;
    transition:
      color .18s ease,
      background .18s ease,
      transform .18s ease;
  }

  .profile-linkedin-icon svg {
    width: 19px;
    height: 19px;
    display: block;
  }

  .profile-linkedin-icon::before,
  .profile-linkedin-icon::after {
    content: none !important;
    display: none !important;
  }

</style>
