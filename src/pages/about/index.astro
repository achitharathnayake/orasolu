<style id="orasolu-social-buttons">

  /* ORASOLU social buttons */

  .social-links {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
  }

  .social-links a,
  a[href*="linkedin.com"],
  a[href*="github.com"],
  a[href*="sloug"] {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0 18px;
    border: 1px solid #e1e6ed;
    border-radius: 10px;
    background: #ffffff;
    color: #172235;
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
    line-height: 1;
    transition:
      background .2s ease,
      border-color .2s ease,
      box-shadow .2s ease,
      transform .2s ease;
  }

  /* LinkedIn primary button */

  .social-links a[href*="linkedin.com"],
  a[href*="linkedin.com"] {
    background: #f45a24;
    border-color: #f45a24;
    color: #ffffff;
    box-shadow: 0 8px 20px rgba(244, 90, 36, .16);
  }

  /* Hover */

  .social-links a:hover,
  a[href*="linkedin.com"]:hover,
  a[href*="github.com"]:hover,
  a[href*="sloug"]:hover {
    transform: translateY(-1px);
    border-color: #d5dce5;
    box-shadow: 0 8px 20px rgba(23, 34, 53, .08);
  }

  a[href*="linkedin.com"]:hover {
    background: #e94f1b;
    border-color: #e94f1b;
  }

  /* Remove visual arrow-like pseudo elements if present */

  .social-links a::after,
  .social-links a::before,
  a[href*="linkedin.com"]::after,
  a[href*="github.com"]::after,
  a[href*="sloug"]::after {
    content: none !important;
    display: none !important;
  }

  /* SLOUG logo */

  .social-logo-wrap {
    width: 18px;
    height: 18px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .social-logo-wrap img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  /* Tablet */

  @media (max-width: 760px) {

    .social-links {
      gap: 8px;
    }

    .social-links a,
    a[href*="linkedin.com"],
    a[href*="github.com"],
    a[href*="sloug"] {
      min-height: 42px;
      padding: 0 15px;
    }
  }

  /* Mobile */

  @media (max-width: 480px) {

    .social-links {
      width: 100%;
      flex-direction: column;
      align-items: stretch;
    }

    .social-links a,
    a[href*="linkedin.com"],
    a[href*="github.com"],
    a[href*="sloug"] {
      width: 100%;
      box-sizing: border-box;
    }
  }

</style>
