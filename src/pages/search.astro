---
import BaseLayout from "../layouts/BaseLayout.astro";
import SearchBox from "../components/search/SearchBox.astro";
---

<BaseLayout
  title="Search"
  description="Search ORASOLU articles, topics and technical knowledge."
>
  <main class="search-page">
    <section class="search-hero">
      <div class="search-container">
        <p class="search-eyebrow">ORASOLU KNOWLEDGE</p>
        <h1>Search</h1>
        <p class="search-intro">
          Find articles, topics and technical knowledge across ORASOLU.
        </p>

        <SearchBox />
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .search-page {
    min-height: 70vh;
  }

  .search-hero {
    padding: 90px 24px 110px;
  }

  .search-container {
    width: min(100%, 900px);
    margin: 0 auto;
  }

  .search-eyebrow {
    margin: 0 0 12px;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #f56a00;
  }

  .search-container h1 {
    margin: 0;
    font-size: clamp(2.4rem, 6vw, 4rem);
    line-height: 1.05;
  }

  .search-intro {
    max-width: 650px;
    margin: 18px 0 42px;
    font-size: 1.08rem;
    line-height: 1.7;
    opacity: 0.75;
  }
</style>
