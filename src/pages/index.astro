---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeader from "../components/SectionHeader.astro";
import ArticleCard from "../components/ArticleCard.astro";
import { getCollection } from "astro:content";

const articles = await getCollection("articles", ({ data }) => !data.draft);
const latestArticles = [...articles]
  .sort((a, b) => b.data.publishedDate.getTime() - a.data.publishedDate.getTime())
  .slice(0, 3);

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
  });

const getReadingTime = (body: string | undefined) =>
  Math.max(
    1,
    Math.ceil(
      (body ? body.replace(/\s+/g, " ").trim().split(/\s+/).length : 0) / 200
    )
  );

const categoryImages: Record<string, string> = {
  "Performance": "/images/article-bg/performance.png",
  "High Availability": "/images/article-bg/high-availability.png",
  "Backup & Recovery": "/images/article-bg/backup-and-recovery.png",
  "Storage & Capacity": "/images/article-bg/storage-and-capacity.png",
  "Migration": "/images/article-bg/migration.png",
  "Automation & DevOps": "/images/article-bg/automation-and-devops.png",
  "SQL & Database": "/images/article-bg/sql-and-database.png",
};
---

<BaseLayout>

 <!-- HERO -->
 <section class="hero">
 <div class="hero-glow"></div>

 <div class="container hero-grid">
 <div class="hero-copy">

 <div class="eyebrow">
 DATABASE · CLOUD · AUTOMATION
 </div>

 <h1>
 Oracle Database<br />
 <span>Expertise &amp; Solutions</span>
 </h1>

 <p>
 Practical knowledge across architecture, performance,
 high availability, migrations, cloud and automation.
 </p>

 <div class="hero-actions">
 <a class="button button--primary" href="/articles/">
 Explore Articles
 </a>

 <a class="button button--secondary" href="/tools/">
 Explore Tools
 </a>
 </div>

 </div>

 <div class="hero-visual"></div>
 </div>
 </section>


 <!-- ENGINEERING AREAS -->
 <section class="topic-strip">
 <div class="container topic-grid">

 {[
 [
 "◉",
 "Oracle Database",
 "Architecture, administration, SQL, PL/SQL and database internals."
 ],
 [
 "⌁",
 "Performance",
 "SQL tuning, AWR, ASH, wait events and diagnostics."
 ],
 [
 "✣",
 "High Availability",
 "RAC, Data Guard, MAA and disaster recovery."
 ],
 [
 "",
 "Migrations",
 "Modernization, platform migrations and migration strategies."
 ],
 [
 "⚒",
 "Cloud & Infrastructure",
 "OCI, Exadata, ExaCC, Linux and infrastructure."
 ],
 [
 "△",
 "Automation & DevOps",
 "Ansible, Terraform, Jenkins, Shell and Python."
 ]
 ].map(([icon, title, text]) => (
 <a class="topic-card" href="/articles/">
 <span class="topic-icon">{icon}</span>

 <span>
 <strong>{title}</strong>
 <small>{text}</small>
 </span>
 </a>
 ))}

 </div>
 </section>


 <!-- FEATURED ARTICLES -->
 <section class="section">
 <div class="container">

 <SectionHeader
 eyebrow="FEATURED ARTICLES"
 title="Latest from ORASOLU"
 description="Practical database knowledge, technical guides, scripts and real-world solutions."
 href="/articles/"
 linkLabel="View All Articles "
 />

 <div class="articles-grid">

{latestArticles.map((article) => {
 const image =
 article.data.image ||
 categoryImages[article.data.category] ||
 "/images/article-bg/sql-and-database.png";

 const tag = "Oracle Database";

 const href =
 `/articles/${article.id.replace(/\.md$/, "")}/`;

 const meta =
 `${getReadingTime(article.body)} min read · ${formatDate(article.data.publishedDate)}`;

 return (
 <ArticleCard
 category={article.data.category.toUpperCase()}
 tag={tag}
 title={article.data.title}
 description={article.data.description}
 meta={meta}
 image={image}
 href={href}
 />
 );
})}

</div>
 </div>
 </section>


 <!-- TOOLBOX + COMMUNITY -->
 <section class="section section--soft">
 <div class="container two-column">

 <div>

 <SectionHeader
 eyebrow="ORASOLU TOOLBOX"
 title="Tools & Resources"
 description="Useful scripts, diagnostics, utilities and automation for database and infrastructure work."
 href="/tools/"
 linkLabel="View All Tools "
 />

 <div class="tool-grid">

 {[
 "SQL Scripts",
 "Performance",
 "RAC",
 "Data Guard",
 "RMAN",
 "Automation"
 ].map((tool) => (
 <a href="/tools/" class="tool-card">
 <span>◈</span>
 <strong>{tool}</strong>
 </a>
 ))}

 </div>

 </div>


 <aside class="community-card">

 <div class="eyebrow">
 ORACLE COMMUNITY
 </div>

 <h2>
 Learn. Connect. Share.
 </h2>

 <p>
 Discover Oracle communities, technical events and resources
 from the wider Oracle ecosystem.
 </p>

 <div class="community-actions">

 <a
 class="button button--primary"
 href="https://sloug.org/"
 target="_blank"
 rel="noreferrer"
 >
 Visit SLOUG 
 </a>

 <a
 class="button button--secondary"
 href="/about/"
 >
 About ORASOLU 
 </a>

 </div>

 </aside>

 </div>
 </section>


 <!-- TOPICS -->
 <section class="topics-band">
 <div class="container">

 <SectionHeader
 eyebrow="EXPLORE BY TOPIC"
 title="Database & Technology Topics"
 description="Explore content across databases, performance, high availability, migrations, cloud, infrastructure and automation."
 href="/articles/"
 linkLabel="View All Articles "
 />

 <div class="topic-pills">

 {[
 "Oracle Database",
 "Performance",
 "RAC",
 "Data Guard",
 "Migration",
 "Exadata",
 "ExaCC",
 "PostgreSQL",
 "MongoDB",
 "Cloud",
 "Linux",
 "DevOps",
 "Automation",
 "Security",
 "Backup & Recovery",
 "Troubleshooting",
 "SQL",
 "PL/SQL"
 ].map((x) => (
 <a href="/articles/">{x}</a>
 ))}

 </div>

 </div>
 </section>

</BaseLayout>