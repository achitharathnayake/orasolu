---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeader from "../components/SectionHeader.astro";
import ArticleCard from "../components/ArticleCard.astro";
import { getCollection } from "astro:content";

const articles = await getCollection("articles", ({ data }) => !data.draft);
const latestArticles = [...articles]
  .sort((a, b) => b.data.publishedDate.getTime() - a.data.publishedDate.getTime())
  .slice(0, 3);

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
  });

const getReadingTime = (body: string | undefined) =>
  Math.max(
    1,
    Math.ceil(
      (body ? body.replace(/\s+/g, " ").trim().split(/\s+/).length : 0) / 200
    )
  );

const categoryImages: Record<string, string> = {
  "Performance": "/images/article-bg/performance.png",
  "High Availability": "/images/article-bg/high-availability.png",
  "Backup & Recovery": "/images/article-bg/backup-and-recovery.png",
  "Storage & Capacity": "/images/article-bg/storage-and-capacity.png",
  "Migration": "/images/article-bg/migration.png",
  "Automation & DevOps": "/images/article-bg/automation-and-devops.png",
  "SQL & Database": "/images/article-bg/sql-and-database.png",
};
---

<BaseLayout>

 <!-- HERO -->
 <section class="hero">
 <div class="hero-glow"></div>

 <div class="container hero-grid">
 <div class="hero-copy">

 <div class="eyebrow">
  DATABASE &middot; CLOUD &middot; INFRASTRUCTURE &middot; AUTOMATION
 </div>

 <h1>
   <span class="hero-title-line hero-title-white">Oracle Database</span>
   <span class="hero-title-line hero-title-orange">Expertise &amp; Solutions</span>
  </h1>

 <p>
 Oracle expertise across architecture, performance,
 high availability, migrations, cloud and automation.
 </p>

 <div class="hero-actions">
 <a class="button button--primary" href="/articles/">
 Explore Articles
 </a>

 <a class="button button--secondary" href="/tools/">
 Explore Tools
 </a>
 </div>

 </div>

 <div class="hero-visual"></div>
 </div>
 </section>


 <!-- ENGINEERING AREAS -->
 <section class="topic-strip">
 <div class="container topic-grid">

 {[
  [
    "database",
    "Oracle Database",
    "Architecture, administration, SQL, PL/SQL and database internals.",
    "/articles/"
  ],
  [
    "performance",
    "Performance",
    "SQL tuning, AWR, ASH, wait events and diagnostics.",
    "/tools/performance/"
  ],
  [
    "availability",
    "High Availability",
    "RAC, Data Guard, MAA and disaster recovery.",
    "/tools/high-availability/"
  ],
  [
    "migration",
    "Migrations",
    "Modernization, platform migrations and migration strategies.",
    "/tools/migration/"
  ],
  [
    "cloud",
    "Cloud & Infrastructure",
    "OCI, Exadata, ExaCC, Linux and infrastructure.",
    "/articles/"
  ],
  [
    "automation",
    "Automation & DevOps",
    "Ansible, Terraform, Jenkins, Shell and Python.",
    "/tools/automation/"
  ]
].map(([icon, title, text, href]) => (
 <a class="topic-card" href={href}>
 <span class="topic-icon" aria-hidden="true">
  {icon === "database" && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <ellipse cx="12" cy="5" rx="7" ry="3" />
      <path d="M5 5v7c0 1.7 3.1 3 7 3s7-1.3 7-3V5" />
      <path d="M5 12v7c0 1.7 3.1 3 7 3s7-1.3 7-3v-7" />
    </svg>
  )}
  {icon === "performance" && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <path d="M4.5 16a8 8 0 1 1 15 0" />
      <path d="M12 12l4-4" />
      <path d="M7 19h10" />
    </svg>
  )}
  {icon === "availability" && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 3l7 3v5c0 4.5-2.9 8.1-7 10-4.1-1.9-7-5.5-7-10V6l7-3z" />
      <path d="m9 12 2 2 4-4" />
    </svg>
  )}
  {icon === "migration" && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <path d="M4 8h12" />
      <path d="m13 5 3 3-3 3" />
      <path d="M20 16H8" />
      <path d="m11 13-3 3 3 3" />
    </svg>
  )}
  {icon === "cloud" && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <path d="M7 18h10a4 4 0 0 0 .7-7.9A6 6 0 0 0 6.2 8.5 4.5 4.5 0 0 0 7 18z" />
      <path d="M9 18v2h6v-2" />
      <path d="M10 20h4" />
    </svg>
  )}
  {icon === "automation" && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <rect x="4" y="4" width="5" height="5" rx="1" />
      <rect x="15" y="4" width="5" height="5" rx="1" />
      <rect x="9.5" y="15" width="5" height="5" rx="1" />
      <path d="M9 6.5h6" />
      <path d="M17.5 9v2.5l-5.5 3.5" />
      <path d="M6.5 9v2.5l5.5 3.5" />
    </svg>
  )}
</span>

 <span>
 <strong>{title}</strong>
 <small>{text}</small>
 </span>
 </a>
 ))}

 </div>
 </section>


 <!-- FEATURED ARTICLES -->
 <section class="section">
 <div class="container">

 <SectionHeader
 eyebrow="FEATURED ARTICLES"
 title="Latest from ORASOLU"
 description="Database knowledge, technical guides, scripts and real-world solutions."
 href="/articles/"
 linkLabel="View All Articles "
 />

 <div class="articles-grid">

{latestArticles.map((article) => {
 const image =
 article.data.image ||
 categoryImages[article.data.category] ||
 "/images/article-bg/sql-and-database.png";

 const tag = "Oracle Database";

 const href =
 `/articles/${article.id.replace(/\.md$/, "")}/`;

 const meta =
 `${getReadingTime(article.body)} min read \u00B7 ${formatDate(article.data.publishedDate)}`;

 return (
 <ArticleCard
 category={article.data.category.toUpperCase()}
 tag={tag}
 title={article.data.title}
 description={article.data.description}
 meta={meta}
 image={image}
 href={href}
 />
 );
})}

</div>
 </div>
 </section>


 <!-- TOOLBOX + COMMUNITY -->
 <section class="section section--soft">
 <div class="container two-column">

 <div>

 <SectionHeader
  eyebrow="ORASOLU TOOLBOX"
  title="Tools & Resources"
  description="Useful scripts, diagnostics, utilities and automation for database and infrastructure work."
  />

 <div class="tool-grid">

 {[
  ["SQL Scripts", "/tools/sql/"],
  ["Performance", "/tools/performance/"],
  ["RAC", "/tools/high-availability/"],
  ["Data Guard", "/tools/high-availability/"],
  ["RMAN", "/tools/backup-recovery/"],
  ["Automation", "/tools/automation/"]
  ].map(([tool, href]) => (
  <a href={href} class="tool-card">
  <span class="tool-icon" aria-hidden="true">
  {tool === "SQL Scripts" && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <path d="m8 8-4 4 4 4" />
      <path d="m16 8 4 4-4 4" />
      <path d="m14 5-4 14" />
    </svg>
  )}
  {tool === "Performance" && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <path d="M4.5 16a8 8 0 1 1 15 0" />
      <path d="M12 12l4-4" />
      <path d="M7 19h10" />
    </svg>
  )}
  {tool === "RAC" && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="6" cy="12" r="2.5" />
      <circle cx="18" cy="7" r="2.5" />
      <circle cx="18" cy="17" r="2.5" />
      <path d="m8.3 11 7.2-3" />
      <path d="m8.3 13 7.2 3" />
    </svg>
  )}
  {tool === "Data Guard" && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 3 19 6v5c0 4.5-2.8 7.8-7 10-4.2-2.2-7-5.5-7-10V6l7-3z" />
      <path d="m9 12 2 2 4-4" />
    </svg>
  )}
  {tool === "RMAN" && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <path d="M6 7h12" />
      <path d="M7 7v12h10V7" />
      <path d="M9 7V4h6v3" />
      <path d="M9 12h6" />
      <path d="M9 16h4" />
    </svg>
  )}
  {tool === "Automation" && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <rect x="4" y="4" width="5" height="5" rx="1" />
      <rect x="15" y="4" width="5" height="5" rx="1" />
      <rect x="9.5" y="15" width="5" height="5" rx="1" />
      <path d="M9 6.5h6" />
      <path d="M17.5 9v2.5l-5.5 3.5" />
      <path d="M6.5 9v2.5l5.5 3.5" />
    </svg>
  )}
</span>
  <strong>{tool}</strong>
  </a>
  ))}

 </div>

 </div>


 <aside class="community-card">

 <div class="eyebrow">
  ORASOLU
  </div>

  <h2>
  Explore. Engineer. Automate. Evolve.
  </h2>

  <p>
  Oracle database engineering, automation and technical solutions shaped by real-world experience.
  </p>

 <div class="community-actions">

 <a
 class="button button--secondary"
 href="/about/"
 >
 About ORASOLU 
 </a>

 </div>

 </aside>

 </div>
 </section>


 <!-- TOPICS -->
 <section class="topics-band">
 <div class="container">

 <SectionHeader
 eyebrow="EXPLORE BY TOPIC"
 title="Database & Technology Topics"
 description="Explore content across databases, performance, high availability, migrations, cloud, infrastructure and automation."
 />

 <div class="topic-pills">

 {[
 "Oracle Database",
 "Performance",
 "RAC",
 "Data Guard",
 "Migration",
 "Exadata",
 "ExaCC",
 "PostgreSQL",
 "MongoDB",
 "Cloud",
 "Linux",
 "DevOps",
 "Automation",
 "Security",
 "Backup & Recovery",
 "Troubleshooting",
 "SQL",
 "PL/SQL"
 ].map((x) => (
 <a href="/articles/">{x}</a>
 ))}

 </div>

 </div>
 </section>

</BaseLayout>
