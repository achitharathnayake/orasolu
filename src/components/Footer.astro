<style>
  /* =====================================================
     ORASOLU FOOTER
     ===================================================== */

  .orasolu-footer {
    width: 100%;
    background: #111d2c;
    color: #ffffff;
    margin: 0;
    padding: 64px 0 24px;
  }

  .orasolu-footer-inner {
    width: min(1180px, calc(100% - 48px));
    margin: 0 auto;
  }


  /* =========================
     MAIN GRID
     ========================= */

  .orasolu-footer-grid {
    display: grid;
    grid-template-columns: minmax(320px, 2fr) repeat(3, minmax(140px, 1fr));
    gap: 56px;

    align-items: start;
  }


  /* =========================
     BRAND
     ========================= */

  .orasolu-footer-brand {
    max-width: 390px;
  }

  .orasolu-footer-logo {
    display: block;
    width: 190px;
    height: auto;
    margin: 0 0 22px;
    padding: 0;
  }

  .orasolu-footer-logo img {
    display: block;

    width: 190px !important;
    max-width: 190px !important;
    height: auto !important;

    margin: 0;
    padding: 0;

    object-fit: contain;
  }

  .orasolu-footer-brand p {
    margin: 0;
    max-width: 370px;

    color: #aeb9c8;
    font-size: 14px;
    line-height: 1.7;
  }


  /* =========================
     COLUMNS
     ========================= */

  .orasolu-footer-column {
    min-width: 0;
  }

  .orasolu-footer-column h3 {
    margin: 2px 0 18px;

    color: #ffffff;

    font-size: 15px;
    font-weight: 700;
    line-height: 1.3;
  }

  .orasolu-footer-column nav {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 11px;
  }

  .orasolu-footer-column nav a {
    display: block;

    margin: 0;
    padding: 0;

    color: #aeb9c8;

    font-size: 14px;
    line-height: 1.4;

    text-decoration: none;

    transition:
      color 0.2s ease,
      transform 0.2s ease;
  }

  .orasolu-footer-column nav a:hover {
    color: #ff6a24;
    transform: translateX(2px);
  }


  /* =========================
     BOTTOM
     ========================= */

  .orasolu-footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 24px;

    margin-top: 52px;
    padding-top: 22px;

    border-top: 1px solid rgba(255, 255, 255, 0.10);

    color: #7f8da0;

    font-size: 13px;
    line-height: 1.5;
  }


  /* =========================
     TABLET
     ========================= */

  @media (max-width: 900px) {

    .orasolu-footer-grid {
      grid-template-columns: 2fr 1fr 1fr;
      gap: 40px;
    }

    .orasolu-footer-brand {
      grid-column: 1 / -1;
      max-width: 520px;
    }

  }


  /* =========================
     MOBILE
     ========================= */

  @media (max-width: 640px) {

    .orasolu-footer {
      padding: 48px 0 22px;
    }

    .orasolu-footer-inner {
      width: min(100% - 32px, 520px);
    }

    .orasolu-footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 34px 28px;
    }

    .orasolu-footer-brand {
      grid-column: 1 / -1;
      max-width: 100%;
    }

    .orasolu-footer-logo {
      width: 170px;
    }

    .orasolu-footer-logo img {
      width: 170px !important;
      max-width: 170px !important;
    }

    .orasolu-footer-bottom {
      flex-direction: column;
      align-items: flex-start;

      gap: 8px;

      margin-top: 40px;
    }

  }


  /* =========================
     SMALL MOBILE
     ========================= */

  @media (max-width: 420px) {

    .orasolu-footer-grid {
      grid-template-columns: 1fr;
      gap: 30px;
    }

    .orasolu-footer-brand {
      grid-column: auto;
    }

  }
</style>