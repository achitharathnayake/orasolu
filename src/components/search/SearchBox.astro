---
---

<div class="search-box">
  <label for="orasolu-search" class="search-label">Search ORASOLU</label>

  <div class="search-input-wrap">
    <svg
      class="search-icon"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      aria-hidden="true"
    >
      <circle cx="11" cy="11" r="7"></circle>
      <path d="m20 20-3.5-3.5"></path>
    </svg>

    <input
      id="orasolu-search"
      class="search-input"
      type="search"
      placeholder="Search articles, topics and tags..."
      autocomplete="off"
    />
  </div>

  <div id="search-results" class="search-results" aria-live="polite"></div>
</div>

<script>
  const input = document.querySelector("#orasolu-search");
  const results = document.querySelector("#search-results");

  let articles = [];

  async function loadSearchIndex() {
    try {
      const response = await fetch("/search-index.json");

      if (!response.ok) {
        throw new Error("Unable to load search index.");
      }

      articles = await response.json();
    } catch (error) {
      console.error("ORASOLU search:", error);
    }
  }

  function escapeHtml(value) {
    return value
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#039;");
  }

  function getMatchExcerpt(article, query) {
    const content = article.content || "";
    const normalizedContent = content.toLowerCase();
    const normalizedQuery = query.trim().toLowerCase();

    const matchIndex = normalizedContent.indexOf(normalizedQuery);

    if (matchIndex === -1) {
      return "";
    }

    const start = Math.max(0, matchIndex - 90);
    const end = Math.min(content.length, matchIndex + normalizedQuery.length + 140);

    let excerpt = content.slice(start, end).trim();

    if (start > 0) {
      excerpt = "..." + excerpt;
    }

    if (end < content.length) {
      excerpt += "...";
    }

    const escapedExcerpt = escapeHtml(excerpt);
    const escapedQuery = escapeHtml(query.trim());

    const highlighted = escapedExcerpt.replace(
      new RegExp(escapedQuery.replace(/[.*+?^${}()|[\]\\]/g, "\\$&"), "gi"),
      (match) => `<mark>${match}</mark>`
    );

    return highlighted;
  }

  function searchArticles(query) {
    const normalizedQuery = query.trim().toLowerCase();

    if (!normalizedQuery) {
      results.innerHTML = "";
      return;
    }

    const matches = articles.filter((article) => {
      const searchableText = [
        article.title,
        article.description,
        article.category,
        ...(article.tags || []),
        article.content || "",
      ]
        .join(" ")
        .toLowerCase();

      return searchableText.includes(normalizedQuery);
    });

    if (!matches.length) {
      results.innerHTML = `
        <div class="search-empty">
          No articles found for "<strong>${query}</strong>".
        </div>
      `;
      return;
    }

    results.innerHTML = matches
      .map(
        (article) => `
          <a class="search-result" href="${article.url}">
            <span class="search-result-category">${article.category}</span>
            <h3>${article.title}</h3>
            <p>${article.description}</p>
            ${
              getMatchExcerpt(article, query)
                ? `<div class="search-match"><span>Match</span><p>${getMatchExcerpt(article, query)}</p></div>`
                : ""
            }
            <div class="search-result-tags">
              ${(article.tags || [])
                .map((tag) => `<span>${tag}</span>`)
                .join("")}
            </div>
          </a>
        `
      )
      .join("");
  }

  input?.addEventListener("input", (event) => {
    searchArticles(event.target.value);
  });

  loadSearchIndex();
</script>

<style>
  .search-box {
    width: 100%;
    max-width: 760px;
    margin: 0 auto;
  }

  .search-label {
    display: block;
    margin-bottom: 10px;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .search-input-wrap {
    position: relative;
  }

  .search-icon {
    position: absolute;
    top: 50%;
    left: 18px;
    width: 20px;
    height: 20px;
    transform: translateY(-50%);
    pointer-events: none;
    opacity: 0.65;
  }

  .search-input {
    width: 100%;
    min-height: 54px;
    padding: 0 18px 0 52px;
    border: 1px solid rgba(0, 0, 0, 0.16);
    border-radius: 10px;
    background: #fff;
    color: inherit;
    font: inherit;
    outline: none;
    box-sizing: border-box;
  }

  .search-input:focus {
    border-color: #f56a00;
    box-shadow: 0 0 0 3px rgba(245, 106, 0, 0.12);
  }

  .search-results {
    display: grid;
    gap: 12px;
    margin-top: 18px;
  }

  .search-result {
    display: block;
    padding: 20px;
    border: 1px solid rgba(0, 0, 0, 0.1);
    border-radius: 10px;
    background: #fff;
    color: inherit;
    text-decoration: none;
    transition: transform 160ms ease, box-shadow 160ms ease;
  }

  .search-result:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
  }

  .search-result-category {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #f56a00;
  }

  .search-result h3 {
    margin: 6px 0 8px;
    font-size: 1.1rem;
  }

  .search-result p {
    margin: 0;
    line-height: 1.6;
    opacity: 0.78;
  }

  .search-match {
    margin-top: 16px;
    padding: 12px 14px;
    border-left: 3px solid #f56a00;
    background: rgba(245, 106, 0, 0.05);
  }

  .search-match > span {
    display: block;
    margin-bottom: 5px;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #f56a00;
  }

  .search-match p {
    margin: 0;
    line-height: 1.55;
  }

  .search-match mark {
    padding: 1px 3px;
    border-radius: 3px;
    background: rgba(245, 106, 0, 0.18);
    color: inherit;
  }

  .search-result-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 12px;
  }

  .search-result-tags span {
    padding: 4px 8px;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.06);
    font-size: 0.75rem;
  }

  .search-empty {
    padding: 24px;
    border-radius: 10px;
    background: rgba(0, 0, 0, 0.04);
    text-align: center;
  }
</style>
